---
import '../styles/global.css';
import '../styles/landing.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Override --accent on this page only (e.g. project pages with their own hue). */
  accent?: string;
}

const {
  title = 'Alex Monkey Business',
  description = 'Product design and small software, built end to end.',
  accent,
} = Astro.props;

const htmlStyle = accent ? `--accent: ${accent};` : undefined;

// Absolute URLs, built from `site` in astro.config. Social scrapers reject
// relative og:image paths, and the canonical tag keeps the netlify.app
// hostname from competing with the real domain in search.
const ogImage = new URL('/brand/social-card.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<!-- Dark is the default. It ships on the server-rendered tag so the first
     paint is already velvet — the script below only ever removes it. -->
<html lang="en" class="dark" style={htmlStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/brand/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/icons/favicon-16.png" />
    <link rel="apple-touch-icon" href="/brand/icons/apple-touch-icon.png" />
    <link rel="mask-icon" href="/brand/icons/mask-icon.svg" color="#1a1a1a" />
    <meta name="theme-color" content="#121211" />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Declared dimensions let Slack and LinkedIn commit to the large-card
         layout on first fetch instead of guessing from a half-loaded image. -->
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Alex Monkey business." />
    <meta property="og:site_name" content="Alex Monkey Business" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Dark ships on the html tag, so only an explicit opt-out drops it.
      // Runs before paint, so switching to light doesn't flash either.
      try {
        if (localStorage.getItem('mb-theme') === 'light') {
          document.documentElement.classList.remove('dark');
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <Nav />
    <main id="top">
      <slot />
      <Footer />
    </main>
  </body>
</html>
