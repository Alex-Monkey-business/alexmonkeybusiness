---
/**
 * LE CAMP applied to Alex Monkey Business — a test of the style reference at
 * ~/Downloads/DESIGN (2).md, implemented as written. Not linked from the site.
 *
 * Standalone on purpose: it does not import global.css or the Wispr Layout,
 * because the point is to see this system on its own terms rather than
 * negotiating with the cream/velvet one. Nothing here can leak into the site.
 *
 * Deviations from the spec, all forced and all deliberate:
 *  - Agrandir is not a webfont anyone can serve; the spec names Bricolage
 *    Grotesque as its substitute, so that is what loads.
 *  - The 90px display is clamp()ed for small screens and capped at 90px, since
 *    a fixed 90px overflows a phone by a wide margin.
 * Everything else — the four colours, the four surfaces, 1px black rules,
 * 10/20/35 radii, red only where a decision or an identity is — is verbatim.
 */
const projects = [
  { n: '01', name: 'BenchBoss', line: 'Mindre styr. Mer fotball.', tag: 'FOTBALL · WEBAPP', href: '/projects/halsen-g15' },
  { n: '02', name: 'Simons Solfilm', line: 'Nettside for en kompis i Larvik.', tag: 'NETTSIDE', href: 'https://simonssolfilm.no' },
];

/* Tighter than the window the other prototypes use. The spec asks for a
   topographical field — dark ridges, no sky detail, no people — and after ~3.5s
   the clip opens onto a flat white slope that is a lifestyle shot, not terrain. */
const clip = { src: '/hero/standin.mp4', start: 1.4, end: 3.4 };
---

<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Le Camp — test</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,800&family=DM+Sans:wght@400&family=DM+Mono:wght@400&display=swap"
    />
  </head>

  <body>
    <!-- ============ NAV ============
         Transparent over the hero, white with a 1px black bottom rule once the
         page scrolls past it. -->
    <header class="nav" data-nav>
      <a class="brand" href="#top">
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3L22 21H2L12 3Z" fill="currentColor" />
        </svg>
        <span>ALEX MONKEY BUSINESS</span>
      </a>
      <nav class="nav-actions">
        <a class="btn-secondary" href="#prosjekter">Prosjekter</a>
        <a class="btn-primary" href="mailto:alex@alexmonkeybusiness.com">Ta kontakt</a>
      </nav>
    </header>

    <main id="top">
      <!-- ============ HERO — full-bleed dark, badges in a loose constellation ============ -->
      <section class="hero">
        <video
          class="hero-media"
          src={clip.src}
          data-start={clip.start}
          data-end={clip.end}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"></video>
        <div class="hero-inner">
          <p class="mono-tag light">PRODUKT · DESIGN · KODE</p>
          <h1 class="display">Alex Monkey business</h1>
          <p class="hero-sub">Ting jeg lager på fritiden, mest fordi det er gøy.</p>
        </div>

        <!-- Shield patches — 2px stroke line art, one per system colour. -->
        <span class="patch patch-a" style="--patch: var(--color-signal-red)">
          <svg viewBox="0 0 100 120" aria-hidden="true">
            <path class="shell" d="M6 6h88v72L50 114 6 78Z" />
            <path class="art" d="M28 56l14-20 10 14 8-10 12 16Z" />
            <circle class="art" cx="68" cy="28" r="7" />
          </svg>
          <span class="patch-name">WEB</span>
        </span>
        <span class="patch patch-b" style="--patch: #4a7fc5">
          <svg viewBox="0 0 100 120" aria-hidden="true">
            <path class="shell" d="M6 6h88v72L50 114 6 78Z" />
            <rect class="art" x="36" y="20" width="28" height="44" rx="5" />
            <path class="art" d="M45 56h10" />
          </svg>
          <span class="patch-name">MOBIL</span>
        </span>
        <span class="patch patch-c" style="--patch: var(--color-summit-white)">
          <svg viewBox="0 0 100 120" aria-hidden="true">
            <path class="shell" d="M6 6h88v72L50 114 6 78Z" />
            <circle class="art" cx="50" cy="42" r="18" />
            <path class="art" d="M32 42h36M50 24c8 10 8 26 0 36M50 24c-8 10-8 26 0 36" />
          </svg>
          <span class="patch-name">NETT</span>
        </span>
      </section>

      <!-- ============ ASYMMETRIC ABOUT — 40 / 55, reading-text against poster-text ============ -->
      <section class="about">
        <div class="about-text">
          <p class="mono-tag">OM</p>
          <p>
            Produkteier hos Avonova til daglig. Resten lager jeg på fritiden,
            mest fordi det er gøy. <em>Webapplikasjoner, mobilapper, nettsider
            og presentasjoner</em> — design, front, database og drift.
          </p>
          <a class="btn-secondary" href="/about">Om meg</a>
        </div>
        <h2 class="display dark">Fra idé til noe som står i drift.</h2>
      </section>

      <!-- ============ SOCIAL PROOF — glacier mist, no card wrapper ============ -->
      <section class="stats">
        <div class="stats-inner">
          <p class="mono-tag">I DRIFT</p>
          <ul>
            <li><b>3</b> lag bruker BenchBoss hver uke</li>
            <li><b>12</b> kamper styrt gjennom én cuphelg</li>
            <li><b>2</b> nettsteder live</li>
          </ul>
        </div>
      </section>

      <!-- ============ PROJECTS ============ -->
      <section class="work" id="prosjekter">
        <div class="work-inner">
          <p class="mono-tag">PROSJEKTER</p>
          <ul class="grid">
            {projects.map((p) => (
              <li>
                <a class="card" href={p.href}>
                  <p class="mono-tag">{p.tag}</p>
                  <h3>{p.name}</h3>
                  <p class="card-line">{p.line}</p>
                  <span class="card-go">{p.href.startsWith('http') ? 'Se siden' : 'Les caset'} →</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ============ CREAM FEATURE CARD — the warm/cool signature ============ -->
      <section class="feature">
        <div class="cream-card">
          <p class="mono-tag">NESTE</p>
          <h2 class="cream-head">Har du noe som burde finnes?</h2>
          <p>
            Jeg bygger det meste selv nå — design, front, database, drift.
            Send en e-post, så finner vi ut om det er noe.
          </p>
          <a class="btn-primary" href="mailto:alex@alexmonkeybusiness.com">Ta kontakt</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Alex Samnøy · 2026</span>
      <span class="foot-links">
        <a href="mailto:alex@alexmonkeybusiness.com">E-post</a>
        <a href="https://github.com/Alex-Monkey-business">GitHub</a>
      </span>
    </footer>

    <script>
      /* Hold the clip to its window — `loop` restarts at 0 and a #t= fragment
         does not survive it. */
      const v = document.querySelector<HTMLVideoElement>('.hero-media');
      if (v) {
        const start = Number(v.dataset.start) || 0;
        const end = Number(v.dataset.end) || 0;
        const rewind = () => { v.currentTime = start; };
        v.addEventListener('loadedmetadata', rewind, { once: true });
        v.addEventListener('timeupdate', () => {
          if (end && (v.currentTime >= end || v.currentTime < start)) rewind();
        });
      }

      /* The nav is transparent over the hero and white below it. An observer on
         the hero rather than a scroll listener — one callback per crossing. */
      const nav = document.querySelector('[data-nav]');
      const hero = document.querySelector('.hero');
      if (nav && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          ([e]) => nav.classList.toggle('solid', !e.isIntersecting),
          { rootMargin: '-64px 0px 0px 0px' },
        ).observe(hero);
      }
    </script>

    <style is:global>
      :root {
        --color-signal-red: #fe3a3a;
        --color-carbon-ink: #000000;
        --color-summit-white: #ffffff;
        --color-ridge-gray: #767676;

        --font-agrandir: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
        --font-dm-sans: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
        --font-dm-mono: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        --text-caption: 10px;
        --leading-caption: 1.3;
        --tracking-caption: 0.04em;
        --text-body: 16px;
        --leading-body: 1.4;
        --text-subheading: 26px;
        --leading-subheading: 1.2;
        --text-display: 90px;
        --leading-display: 1;

        --spacing-5: 5px;
        --spacing-10: 10px;
        --spacing-15: 15px;
        --spacing-20: 20px;
        --spacing-30: 30px;
        --spacing-40: 40px;
        --spacing-60: 60px;

        --page-max-width: 1200px;
        --section-gap: 60px;
        --card-padding: 40px;
        --element-gap: 10px;

        --radius-nav: 10px;
        --radius-cards: 20px;
        --radius-buttons: 35px;

        --surface-summit-white: #ffffff;
        --surface-glacier-mist: #f5f5f5;
        --surface-trail-cream: #f5f0e8;
        --surface-base-camp-dark: #0a1628;
      }

      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--surface-summit-white);
        color: var(--color-carbon-ink);
        font-family: var(--font-dm-sans);
        font-size: var(--text-body);
        line-height: var(--leading-body);
        -webkit-font-smoothing: antialiased;
      }

      /* Display is poster typography, never running prose. Capped at the spec's
         90px; the clamp exists only so a phone does not overflow. */
      .display {
        font-family: var(--font-agrandir);
        font-weight: 800;
        font-size: clamp(40px, 8.5vw, var(--text-display));
        line-height: var(--leading-display);
        letter-spacing: normal;
        margin: 0;
        color: var(--color-summit-white);
      }
      .display.dark { color: var(--color-carbon-ink); }

      /* Wayfinding tag — the widened monospace rhythm is the whole point. */
      .mono-tag {
        font-family: var(--font-dm-mono);
        font-size: var(--text-caption);
        line-height: var(--leading-caption);
        letter-spacing: var(--tracking-caption);
        text-transform: uppercase;
        color: var(--color-carbon-ink);
        margin: 0 0 var(--spacing-15);
      }
      .mono-tag.light { color: var(--color-summit-white); }

      /* Red is the only elevation in the system. */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        background: var(--color-signal-red);
        color: var(--color-summit-white);
        font-family: var(--font-dm-sans);
        font-size: 14px;
        text-decoration: none;
        border: none;
        border-radius: var(--radius-buttons);
        padding: var(--spacing-10) var(--spacing-20);
        box-shadow: 0 2px 12px rgba(254, 58, 58, 0.25);
      }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        background: transparent;
        color: var(--color-carbon-ink);
        font-family: var(--font-dm-sans);
        font-size: 14px;
        text-decoration: none;
        border: 1px solid var(--color-carbon-ink);
        border-radius: var(--radius-nav);
        padding: var(--spacing-10) var(--spacing-20);
      }

      /* ============ NAV ============ */
      .nav {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-20);
        padding: var(--spacing-15) var(--spacing-30);
        background: transparent;
        border-bottom: 1px solid transparent;
        transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
        color: var(--color-summit-white);
      }
      .nav.solid {
        background: var(--color-summit-white);
        border-bottom-color: var(--color-carbon-ink);
        color: var(--color-carbon-ink);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-10);
        color: inherit;
        text-decoration: none;
        font-family: var(--font-dm-mono);
        font-size: var(--text-caption);
        letter-spacing: var(--tracking-caption);
      }
      /* The mark is one of the three places red is allowed. */
      .brand-mark { width: 20px; height: 20px; color: var(--color-signal-red); flex: none; }
      .nav-actions { display: flex; align-items: center; gap: var(--spacing-10); }
      .nav .btn-secondary { color: inherit; border-color: currentColor; }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        overflow: hidden;
        background: var(--surface-base-camp-dark);
      }
      .hero-media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 55%;
        /* The spec wants a topographical field at dusk, not a lifestyle shot:
           pushed cold and dark so the ridge reads as terrain. No gradient
           scrim — the system is flat colour, so the tint is a flat overlay. */
        filter: saturate(0.55) brightness(0.62) contrast(1.15);
      }
      .hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--surface-base-camp-dark);
        opacity: 0.45;
      }
      .hero-inner {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: 0 var(--spacing-30);
      }
      .hero-inner .display { max-width: 15ch; }
      .hero-sub {
        margin: var(--spacing-20) 0 0;
        max-width: 46ch;
        color: var(--color-summit-white);
        opacity: 0.85;
      }

      /* Shield patches, floating in a loose constellation. */
      .patch {
        position: absolute;
        z-index: 3;
        width: 120px;
        display: grid;
        place-items: center;
        color: var(--patch);
        filter: drop-shadow(0 4px 20px rgba(10, 22, 40, 0.4));
      }
      .patch svg { width: 100%; display: block; }
      .patch .shell,
      .patch .art {
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
      }
      /* Sits in the taper below the icon, not on it — the badge is a merit
         patch, and the name is the thing stitched at the bottom of one. */
      .patch-name {
        position: absolute;
        bottom: 19%;
        font-family: var(--font-dm-sans);
        font-size: 10px;
        letter-spacing: 0.04em;
        color: currentColor;
      }
      /* A loose constellation down the right edge. They must clear the headline
         — a decorative patch sitting on 90px display type is not decoration,
         it is damage. */
      .patch-a { top: 14%; right: 14%; transform: rotate(-6deg); }
      .patch-b { top: 16%; right: 4%; transform: rotate(5deg); }
      .patch-c { bottom: 16%; right: 11%; transform: rotate(-2deg); }
      @media (max-width: 900px) {
        .patch { width: 84px; }
        .patch-a { top: auto; bottom: 22%; right: 6%; }
        .patch-b { top: auto; bottom: 22%; right: 34%; }
        .patch-c { display: none; }
      }

      /* ============ ASYMMETRIC ABOUT ============ */
      .about {
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: var(--section-gap) var(--spacing-30);
        display: grid;
        grid-template-columns: 40% 55%;
        gap: 5%;
        align-items: start;
      }
      .about-text p { font-size: 14px; margin: 0 0 var(--spacing-20); }
      /* Emphasis body text is the third and last place red appears. */
      .about-text em { font-style: normal; color: var(--color-signal-red); }

      /* ============ STATS ============ */
      .stats { background: var(--surface-glacier-mist); }
      .stats-inner {
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: var(--section-gap) var(--spacing-30);
      }
      .stats ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--spacing-30);
      }
      .stats b {
        display: block;
        font-family: var(--font-dm-sans);
        font-weight: 400;
        font-size: var(--text-subheading);
        line-height: var(--leading-subheading);
      }
      @media (max-width: 700px) {
        .stats ul { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-20); }
      }

      /* ============ PROJECTS ============ */
      .work-inner {
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: var(--section-gap) var(--spacing-30);
      }
      .grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--spacing-30);
      }
      /* Flat: 1px black rule, 20px radius, no shadow — elevation belongs to the
         red CTA alone. */
      .card {
        display: flex;
        flex-direction: column;
        gap: var(--element-gap);
        height: 100%;
        padding: var(--card-padding);
        border: 1px solid var(--color-carbon-ink);
        border-radius: var(--radius-cards);
        background: var(--surface-summit-white);
        color: var(--color-carbon-ink);
        text-decoration: none;
      }
      .card h3 {
        font-family: var(--font-agrandir);
        font-weight: 800;
        font-size: var(--text-subheading);
        line-height: var(--leading-subheading);
        margin: 0;
      }
      .card-line { margin: 0; }
      .card-go {
        margin-top: var(--spacing-20);
        font-size: 14px;
        color: var(--color-signal-red);
      }
      @media (max-width: 820px) {
        .grid { grid-template-columns: minmax(0, 1fr); }
        .about { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-30); }
      }

      /* ============ CREAM FEATURE CARD ============ */
      .feature {
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: 0 var(--spacing-30) var(--section-gap);
      }
      .cream-card {
        background: var(--surface-trail-cream);
        border-radius: var(--radius-cards);
        padding: var(--card-padding);
      }
      /* The signature warm/cool contrast: red heading on trail cream. */
      .cream-head {
        font-family: var(--font-agrandir);
        font-weight: 800;
        font-size: var(--text-subheading);
        line-height: var(--leading-subheading);
        color: var(--color-signal-red);
        margin: 0 0 var(--spacing-10);
      }
      .cream-card p { margin: 0 0 var(--spacing-20); max-width: 52ch; }

      /* ============ FOOTER ============ */
      .foot {
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: var(--spacing-30);
        border-top: 1px solid var(--color-carbon-ink);
        display: flex;
        justify-content: space-between;
        gap: var(--spacing-20);
        font-size: 12px;
      }
      .foot-links { display: flex; gap: var(--spacing-20); }
      .foot a { color: inherit; }

      @media (prefers-reduced-motion: reduce) {
        .hero-media { display: none; }
      }
    </style>
  </body>
</html>
