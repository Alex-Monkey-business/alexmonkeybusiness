---
import Layout from '../../layouts/Layout.astro';
import PhoneVideo from '../../components/halsen/PhoneVideo.astro';
import '../../styles/halsen.css';
---

<Layout title="BenchBoss — Alex Monkey Business">
  <div class="case">
    <a href="/#projects" class="case-back">← Back</a>

    <section class="case-hero">
      <span class="case-eyebrow">Case — Halsen G2015</span>
      <h1 class="case-title">Bench<span class="em">Boss</span></h1>
      <p class="case-lede">Full control of the team. Most of it on autopilot.</p>
      <p class="case-stackline">Vue 3 · Vite · Pinia · Supabase · Netlify · Vipps · NFF</p>
    </section>

    <section class="case-feature">
      <div class="case-feature-copy">
        <span class="ft-num">01</span>
        <h2 class="ft-h">Opens to what's next.</h2>
        <p class="ft-p">
          Every coach lands on a page that already knows the day — the next session, and
          the things still on them, like the two match reports waiting. Nothing to hunt for.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneVideo src="/assets/halsen/home.webm" poster="/assets/halsen/home-poster.jpg" /></div>
    </section>

    <section class="case-feature flipped">
      <div class="case-feature-copy">
        <span class="ft-num">02</span>
        <h2 class="ft-h">Every minute counts itself.</h2>
        <p class="ft-p">
          The app tracks who's on, who's owed time, and the score — and keeps it after the
          whistle. Playing time, scorers and referee fee, all on one match.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneVideo src="/assets/halsen/match.webm" poster="/assets/halsen/match-poster.jpg" /></div>
    </section>

    <section class="case-feature">
      <div class="case-feature-copy">
        <span class="ft-num">03</span>
        <h2 class="ft-h">Knows who's free to lend.</h2>
        <p class="ft-p">
          Flag a player as loan-eligible and the squad shows it at a glance. The app tracks
          who has stepped up most, so picking a stand-in takes a second, not a group chat.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneVideo src="/assets/halsen/loan.webm" poster="/assets/halsen/loan-poster.jpg" /></div>
    </section>

    <section class="case-feature flipped">
      <div class="case-feature-copy">
        <span class="ft-num">04</span>
        <h2 class="ft-h">Sessions with a spine.</h2>
        <p class="ft-p">
          Periods, sessions, drills — each with its focus and its learning points. The
          week's plan, written down, not lost in a group chat.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneVideo src="/assets/halsen/training.webm" poster="/assets/halsen/training-poster.jpg" /></div>
    </section>

    <section class="case-feature">
      <div class="case-feature-copy">
        <span class="ft-num">05</span>
        <h2 class="ft-h">Parents see their slice.</h2>
        <p class="ft-p">
          One PIN drops parents into a read-only season — every match, score, time and
          venue. Exactly what's theirs, nothing they can break.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneVideo src="/assets/halsen/parent.webm" poster="/assets/halsen/parent-poster.jpg" /></div>
    </section>

    <section class="case-list">
      <span class="case-list-label">Under the hood</span>
      <ul>
        <li style="--i:0"><span class="n">01</span><span class="text"><em>NFF sync</em> — times, venues and opponents update on their own.</span></li>
        <li style="--i:1"><span class="n">02</span><span class="text">Referee fees over <em>Vipps</em>, expense logged in the same tap.</span></li>
        <li style="--i:2"><span class="n">03</span><span class="text"><em>Season wrap</em> — the year told back from the bench.</span></li>
        <li style="--i:3"><span class="n">04</span><span class="text"><em>Excel export</em> for the end-of-season accounts.</span></li>
      </ul>
    </section>

    <div class="case-stack">
      <span class="live">Live with Halsen G2015</span>
      <span class="sep">·</span>
      <span>Three squads, two cup teams</span>
      <span class="sep">·</span>
      <span>Design + build · Alex</span>
    </div>
  </div>
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // reveal feature sections + list rows on scroll
  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          revealObs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.18 }
  );
  document.querySelectorAll('.case-feature, .case-list li').forEach((el) => revealObs.observe(el));

  // play each real-app recording only while on screen; loop past the skeleton frames
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.phone-video'));
  videos.forEach((v) => {
    const start = Number(v.dataset.start ?? '0');
    const toStart = () => { if (start && v.currentTime < start) v.currentTime = start; };
    v.addEventListener('loadedmetadata', toStart);
    v.addEventListener('timeupdate', () => {
      if (v.duration && v.currentTime >= v.duration - 0.25) v.currentTime = start || 0;
    });
  });

  if (!reduce) {
    const vidObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (v.currentTime < Number(v.dataset.start ?? '0')) v.currentTime = Number(v.dataset.start ?? '0');
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      },
      { threshold: 0.35 }
    );
    videos.forEach((v) => vidObs.observe(v));
  }
</script>
