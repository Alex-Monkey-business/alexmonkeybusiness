---
import Layout from '../../layouts/Layout.astro';
import PhoneHome from '../../components/halsen/PhoneHome.astro';
import PhoneMatch from '../../components/halsen/PhoneMatch.astro';
import PhoneLoan from '../../components/halsen/PhoneLoan.astro';
import PhoneTraining from '../../components/halsen/PhoneTraining.astro';
import PhoneParent from '../../components/halsen/PhoneParent.astro';
import '../../styles/halsen.css';
---

<Layout title="BenchBoss — Alex Monkey Business">
  <div class="case">
    <a href="/#projects" class="case-back">← Back</a>

    <section class="case-hero">
      <span class="case-eyebrow">Case — Halsen G2015</span>
      <h1 class="case-title">Bench<span class="em">Boss</span></h1>
      <p class="case-lede">Full control of the team. Most of it on autopilot.</p>
      <p class="case-stackline">Vue 3 · Vite · Pinia · Supabase · Netlify · Vipps · NFF</p>
    </section>

    <section class="case-feature">
      <div class="case-feature-copy">
        <span class="ft-num">01</span>
        <h2 class="ft-h">Opens to what's next.</h2>
        <p class="ft-p">
          Every coach lands on a page that already knows the day — next match, next
          session, and the three things still on them: squad, referee, loan players.
          Nothing to hunt for.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneHome /></div>
    </section>

    <section class="case-feature flipped">
      <div class="case-feature-copy">
        <span class="ft-num">02</span>
        <h2 class="ft-h">Every minute counts itself.</h2>
        <p class="ft-p">
          Start the clock and the app tracks who's on, who's owed time, and the score —
          live. Substitutions in two taps, fair playing time without the mental math.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneMatch /></div>
    </section>

    <section class="case-feature">
      <div class="case-feature-copy">
        <span class="ft-num">03</span>
        <h2 class="ft-h">It knows who's due.</h2>
        <p class="ft-p">
          BenchBoss watches how often each loaner steps up. When you're short, it names
          them — ranked by who has carried the load across the season.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneLoan /></div>
    </section>

    <section class="case-feature flipped">
      <div class="case-feature-copy">
        <span class="ft-num">04</span>
        <h2 class="ft-h">Sessions with a spine.</h2>
        <p class="ft-p">
          Periods, sessions, drills — each with its focus and its learning points. The
          week's plan, written down, not lost in a group chat.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneTraining /></div>
    </section>

    <section class="case-feature">
      <div class="case-feature-copy">
        <span class="ft-num">05</span>
        <h2 class="ft-h">Parents see their slice.</h2>
        <p class="ft-p">
          One PIN drops parents into a read-only season — matches, times, venues,
          training. Exactly what's theirs, nothing they can break.
        </p>
      </div>
      <div class="case-feature-stage"><PhoneParent /></div>
    </section>

    <section class="case-list">
      <span class="case-list-label">Under the hood</span>
      <ul>
        <li style="--i:0"><span class="n">01</span><span class="text"><em>NFF sync</em> — times, venues and opponents update on their own.</span></li>
        <li style="--i:1"><span class="n">02</span><span class="text">Referee fees over <em>Vipps</em>, expense logged in the same tap.</span></li>
        <li style="--i:2"><span class="n">03</span><span class="text"><em>Season wrap</em> — the year told back from the bench.</span></li>
        <li style="--i:3"><span class="n">04</span><span class="text"><em>Excel export</em> for the end-of-season accounts.</span></li>
      </ul>
    </section>

    <div class="case-stack">
      <span class="live">Live with Halsen G2015</span>
      <span class="sep">·</span>
      <span>Three squads, two cup teams</span>
      <span class="sep">·</span>
      <span>Design + build · Alex</span>
    </div>
  </div>
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- reveal feature sections + list rows on scroll ----
  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          revealObs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.18 }
  );
  document.querySelectorAll('.case-feature, .case-list li').forEach((el) => revealObs.observe(el));

  // ---- phone demo loops ----
  type Demo = { root: HTMLElement; timers: number[]; running: boolean; start: () => void; stop: () => void };

  const fmt = (sec: number) => `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;

  const makeDemo = (root: HTMLElement, build: (d: Demo, after: (ms: number, fn: () => void) => void, every: (ms: number, fn: () => void) => void) => void): Demo => {
    const d: Demo = {
      root,
      timers: [],
      running: false,
      start() {
        if (d.running) return;
        d.running = true;
        run();
      },
      stop() {
        d.running = false;
        d.timers.forEach((t) => clearTimeout(t));
        d.timers.forEach((t) => clearInterval(t));
        d.timers = [];
      },
    };
    const after = (ms: number, fn: () => void) => { d.timers.push(window.setTimeout(fn, ms)); };
    const every = (ms: number, fn: () => void) => { d.timers.push(window.setInterval(fn, ms)); };
    const run = () => {
      d.timers.forEach((t) => { clearTimeout(t); clearInterval(t); });
      d.timers = [];
      build(d, after, every);
    };
    (d as any)._run = run;
    return d;
  };

  const demos: Demo[] = [];
  const q = (root: HTMLElement, sel: string) => root.querySelector<HTMLElement>(sel);
  const qa = (root: HTMLElement, sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));

  // ===== 01 HOME =====
  document.querySelectorAll<HTMLElement>('[data-demo="home"]').forEach((root) => {
    const tasks = qa(root, '.bb-task');
    const count = q(root, '[data-count]');
    const labels = ['3 igjen', '2 igjen', '1 igjen', 'Ferdig'];
    const reset = () => { tasks.forEach((t) => t.classList.remove('is-active')); if (count) count.textContent = '4 igjen'; };
    demos.push(makeDemo(root, (d, after) => {
      reset();
      tasks.forEach((t, i) => after(900 + i * 1200, () => {
        t.classList.add('is-active');
        if (count) count.textContent = labels[i];
      }));
      after(7000, () => { if (d.running) (d as any)._run(); });
    }));
  });

  // ===== 02 MATCH =====
  document.querySelectorAll<HTMLElement>('[data-demo="match"]').forEach((root) => {
    const clockEl = q(root, '[data-clock]');
    const mins = qa(root, '[data-min]');
    const home = q(root, '[data-home]');
    const target = q(root, '[data-sub-target]');
    const nameEl = target ? q(target, '[data-name]') : null;
    const targetMin = target ? q(target, '[data-min]') : null;

    const state = { clock: 38 * 60 + 14, m: mins.map((el) => Number(el.dataset.min) * 60) };
    const paint = () => {
      if (clockEl) clockEl.textContent = fmt(state.clock);
      mins.forEach((el, i) => { el.textContent = fmt(state.m[i]); });
    };
    const reset = () => {
      state.clock = 38 * 60 + 14;
      state.m = mins.map((el) => Number(el.dataset.min) * 60);
      if (home) home.textContent = '2';
      if (nameEl) nameEl.textContent = 'Matheo';
      root.dataset.subShow = '0';
      target?.classList.remove('swapped');
      paint();
    };

    demos.push(makeDemo(root, (d, after, every) => {
      reset();
      every(1000, () => { state.clock++; state.m = state.m.map((s) => s + 1); paint(); });
      // substitution
      after(3000, () => { root.dataset.subShow = '1'; });
      after(4600, () => {
        if (nameEl) nameEl.textContent = 'Aksel';
        if (targetMin) state.m[2] = 0;
        target?.classList.add('swapped');
        paint();
      });
      after(5600, () => { root.dataset.subShow = '0'; });
      // goal
      after(7200, () => {
        if (home) { home.textContent = '3'; home.classList.add('flash'); }
        after(800, () => home?.classList.remove('flash'));
      });
      after(10500, () => { if (d.running) (d as any)._run(); });
    }));
  });

  // ===== 03 LOAN =====
  document.querySelectorAll<HTMLElement>('[data-demo="loan"]').forEach((root) => {
    demos.push(makeDemo(root, (d, after) => {
      root.dataset.step = '0';
      after(700, () => { root.dataset.step = '1'; });
      after(1500, () => { root.dataset.step = '2'; });
      after(3200, () => { root.dataset.step = '3'; });
      after(7000, () => { if (d.running) (d as any)._run(); });
    }));
  });

  // ===== 04 TRAINING =====
  document.querySelectorAll<HTMLElement>('[data-demo="training"]').forEach((root) => {
    const drills = qa(root, '.bb-drill');
    const reset = () => drills.forEach((dr) => dr.classList.remove('is-open'));
    demos.push(makeDemo(root, (d, after) => {
      reset();
      drills.forEach((dr, i) => {
        after(800 + i * 1900, () => { reset(); dr.classList.add('is-open'); });
      });
      after(800 + drills.length * 1900 + 600, () => reset());
      after(800 + drills.length * 1900 + 1400, () => { if (d.running) (d as any)._run(); });
    }));
  });

  // ===== 05 PARENT =====
  document.querySelectorAll<HTMLElement>('[data-demo="parent"]').forEach((root) => {
    const dots = qa(root, '.bb-pin-dot');
    const role = q(root, '[data-role]');
    const reset = () => { dots.forEach((x) => x.classList.remove('is-filled')); root.dataset.unlocked = '0'; if (role) role.textContent = 'LÅST'; };
    demos.push(makeDemo(root, (d, after) => {
      reset();
      dots.forEach((x, i) => after(700 + i * 420, () => x.classList.add('is-filled')));
      after(700 + dots.length * 420 + 400, () => { root.dataset.unlocked = '1'; if (role) role.textContent = 'FORELDER'; });
      after(8000, () => { if (d.running) (d as any)._run(); });
    }));
  });

  // ---- start/stop on visibility ----
  if (!reduce) {
    const phoneObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const demo = demos.find((dm) => dm.root === e.target);
          if (!demo) return;
          if (e.isIntersecting) demo.start();
          else demo.stop();
        });
      },
      { threshold: 0.3 }
    );
    demos.forEach((dm) => phoneObs.observe(dm.root));
  }
</script>
