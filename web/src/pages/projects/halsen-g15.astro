---
import Layout from '../../layouts/Layout.astro';
import PhoneVideo from '../../components/halsen/PhoneVideo.astro';
import '../../styles/halsen.css';

/* Recordings are made against BenchBoss in demo mode — invented players, no
   database. The real app runs a grassroots team of children, and their names
   have no business on a public portfolio. */
const features = [
  {
    n: '01',
    h: "Opens to the day you're in.",
    p: "Every coach lands on what is actually next — the session, the match, the things still owed. No scrolling a fixture list for the one row that matters today.",
    src: '/assets/halsen/hjem.webm',
    poster: '/assets/halsen/hjem-poster.jpg',
  },
  {
    n: '02',
    h: 'Every minute counts itself.',
    p: "Set the team on the pitch, kick off, and each player's clock runs on its own. Bring someone on in the eighth minute and their time starts there, so the match clock and the minutes a player is owed are never confused for each other. Goals ask who scored before anyone forgets.",
    src: '/assets/halsen/matchmode.webm',
    poster: '/assets/halsen/matchmode-poster.jpg',
    // The take opens with eight taps to build the lineup, which reads as a
    // bottom sheet flapping. Start the loop on the finished pitch instead.
    start: 9.8,
  },
  {
    n: '03',
    h: 'Are the teams even?',
    p: "Played, won, drawn, goal difference and points — per squad, not per club. That is the question a coach running three teams actually has, and no league table answers it.",
    src: '/assets/halsen/stats-teams.webm',
    poster: '/assets/halsen/stats-teams-poster.jpg',
  },
  {
    n: '04',
    h: 'It picks the stand-in for you.',
    p: "Borrowing a player is a shortlist, not a search. The app stars the ones who are eligible, free that day, and not already lent to another match the same week — fewest extra appearances first — so the load spreads instead of landing on whoever answers the group chat fastest.",
    src: '/assets/halsen/loan-suggest.webm',
    poster: '/assets/halsen/loan-suggest-poster.jpg',
  },
  {
    n: '05',
    h: 'A whole tournament, two teams.',
    p: "Twelve matches across two days with two Halsen sides in them. Pitch, kick-off, match number, filtered per team — the weekend as one screen instead of a folded sheet in a jacket pocket.",
    src: '/assets/halsen/cup.webm',
    poster: '/assets/halsen/cup-poster.jpg',
  },
  {
    n: '06',
    h: 'Sessions with a spine.',
    p: "Periods hold sessions, sessions hold drills, and every drill carries its focus and a differentiated variant for the ones who need it. The week's plan is written down rather than remembered.",
    src: '/assets/halsen/trening.webm',
    poster: '/assets/halsen/trening-poster.jpg',
  },
  {
    n: '07',
    h: 'The why, written down.',
    p: "Seven principles for how this team trains, so a stand-in on a Tuesday runs the same football as the Saturday before. The handbook lives in the app, not in a PDF nobody opens.",
    src: '/assets/halsen/handbok.webm',
    poster: '/assets/halsen/handbok-poster.jpg',
  },
];
---

<Layout title="BenchBoss — Alex Monkey Business">
  <div class="case">
    <a href="/#projects" class="case-back">← Back</a>

    <section class="case-hero">
      <span class="case-eyebrow">Case — Halsen G2015</span>
      <h1 class="case-title">Bench<span class="em">Boss</span></h1>
      <p class="case-lede">Full control of the team. Most of it on autopilot.</p>
      <p class="case-stackline">Vue 3 · Vite · Pinia · Supabase · Netlify · Vipps · NFF</p>
    </section>

    {features.map((f, i) => (
      <section class={`case-feature${i % 2 === 1 ? ' flipped' : ''}`}>
        <div class="case-feature-copy">
          <span class="ft-num">{f.n}</span>
          <h2 class="ft-h">{f.h}</h2>
          <p class="ft-p">{f.p}</p>
        </div>
        <div class="case-feature-stage">
          <PhoneVideo src={f.src} poster={f.poster} start={f.start ?? 0.5} />
        </div>
      </section>
    ))}

    <section class="case-list">
      <span class="case-list-label">Under the hood</span>
      <ul>
        <li style="--i:0"><span class="n">01</span><span class="text"><em>NFF sync</em> — times, venues and opponents update on their own.</span></li>
        <li style="--i:1"><span class="n">02</span><span class="text">Referee fees over <em>Vipps</em>, expense logged in the same tap.</span></li>
        <li style="--i:2"><span class="n">03</span><span class="text"><em>Season settlement</em> — squads roll over, history stays with the season it happened in.</span></li>
        <li style="--i:3"><span class="n">04</span><span class="text"><em>Excel export</em> for the end-of-season accounts.</span></li>
      </ul>
    </section>

    <div class="case-stack">
      <span class="live">Live with Halsen G2015</span>
      <span class="sep">·</span>
      <span>Three squads, two cup teams</span>
      <span class="sep">·</span>
      <span>Design + build · Alex</span>
    </div>
  </div>
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // reveal feature sections + list rows on scroll
  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          revealObs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.18 }
  );
  document.querySelectorAll('.case-feature, .case-list li').forEach((el) => revealObs.observe(el));

  // play each real-app recording only while on screen; loop past the first paint
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.phone-video'));
  videos.forEach((v) => {
    const start = Number(v.dataset.start ?? '0');
    const toStart = () => { if (start && v.currentTime < start) v.currentTime = start; };
    v.addEventListener('loadedmetadata', toStart);
    v.addEventListener('timeupdate', () => {
      if (v.duration && v.currentTime >= v.duration - 0.25) v.currentTime = start || 0;
    });
  });

  if (!reduce) {
    const vidObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (v.currentTime < Number(v.dataset.start ?? '0')) v.currentTime = Number(v.dataset.start ?? '0');
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      },
      { threshold: 0.35 }
    );
    videos.forEach((v) => vidObs.observe(v));
  }
</script>
