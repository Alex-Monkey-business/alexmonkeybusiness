---
import Layout from '../../../layouts/Layout.astro';
import ProjectDetail from '../../../components/pages/ProjectDetail.astro';
import { projects } from '../../../data/projects';

// getStaticPaths has to live in the route file, so it is repeated per locale.
export function getStaticPaths() {
  const customPages = new Set(['halsen-g15']);
  return projects
    .filter((p) => !customPages.has(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title}${project.titleEm ? ' ' + project.titleEm : ''} — Alex Monkey Business`}>
  <ProjectDetail lang="en" project={project} />
</Layout>
