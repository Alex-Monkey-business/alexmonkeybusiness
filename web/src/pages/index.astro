---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import SkiDescent from '../components/SkiDescent.astro';
---

<Layout>
  <section class="hero">
    <h1 class="display">
      <span class="line">Alex</span>
      <span class="line">
        <span class="word-wrap">
          <em>Monkey business</em>
          <svg
            class="underline"
            viewBox="0 0 240 14"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 9 C 40 2, 80 12, 120 6 S 200 2, 238 8"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
            />
          </svg>
        </span><span class="period">.</span>
      </span>
    </h1>
    <p class="lede">A portal to the things I'm tinkering with.</p>
  </section>

  <SkiDescent />

  <section class="projects" id="projects">
    <span class="section-label">
      Projects&nbsp;·&nbsp;{String(projects.length).padStart(2, '0')}
    </span>

    <ul class="list">
      {projects.map((p) => {
        const href = p.url ?? `/projects/${p.slug}`;
        const external = Boolean(p.url);
        return (
          <li>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class="item"
            >
              <span class="row">
                <span class="title">
                  {p.title}
                  {p.titleEm && <span class="title-em">{' '}{p.titleEm}</span>}
                  {p.status === 'wip' && <span class="wip">in&nbsp;progress</span>}
                </span>
                <span class="year">{p.year}</span>
              </span>
              {p.subtitle && <span class="subtitle">{p.subtitle}</span>}
              {external && (
                <svg
                  class="ext"
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 L 17 7" />
                  <path d="M9 7 H 17 V 15" />
                </svg>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>

<style>
  /* ===== hero ===== */
  .hero {
    max-width: 880px;
    margin: 0 auto;
    padding: 22vh 40px 4vh;
  }
  @media (max-width: 640px) {
    .hero { padding: 18vh 22px 2vh; }
  }

  .display {
    font-family: var(--font-display);
    font-size: clamp(42px, 10.8vw, 96px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.024em;
    margin: 0;
    color: var(--fg1);
  }
  .display .line { display: block; }
  .display em {
    font-style: normal;
    color: var(--em-color);
  }
  .display .period { color: var(--em-color); }

  .word-wrap {
    display: inline-block;
    position: relative;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    /* allow Monkey business to break as a fallback on tight viewports */
    .word-wrap { white-space: normal; }
  }
  .underline {
    position: absolute;
    left: -1%;
    right: -1%;
    bottom: -0.04em;
    width: 102%;
    height: 0.2em;
    color: var(--acid);
    pointer-events: none;
  }
  .underline path {
    stroke-dasharray: 460;
    stroke-dashoffset: 460;
    animation: u-draw 6.4s cubic-bezier(0.45, 0.05, 0.55, 0.95) 700ms infinite;
  }
  @keyframes u-draw {
    0%   { stroke-dashoffset: 460; }
    38%  { stroke-dashoffset: 0; }
    72%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -460; }
  }

  .lede {
    margin-top: 32px;
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.62;
    color: var(--fg2);
    font-weight: 400;
  }

  /* ===== projects ===== */
  .projects {
    max-width: 880px;
    margin: 0 auto;
    padding: 2vh 40px 4vh;
  }
  @media (max-width: 640px) {
    .projects { padding: 2vh 22px 4vh; }
  }
  .section-label {
    display: inline-block;
    font-size: 12px;
    color: var(--fg3);
    font-family: var(--font-mono);
    margin-bottom: 22px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .list li { border-bottom: 1px solid var(--border); }

  .item {
    display: block;
    position: relative;
    padding: 22px 60px 22px 4px;
    color: var(--fg1);
    text-decoration: none;
    transition: background 220ms ease, padding 360ms var(--ease-out);
  }
  .item::before {
    content: '';
    position: absolute;
    left: -40px;
    top: 50%;
    width: 0;
    height: 1px;
    background: var(--acid);
    transform: translateY(-50%);
    transition: width 360ms var(--ease-out);
  }
  .item:hover {
    background: var(--bg-elevated);
    padding-left: 28px;
  }
  .item:hover::before { width: 22px; }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  .title {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg1);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .title-em {
    font-weight: 300;
    color: var(--em-color);
  }
  .wip {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--mustard);
    background: var(--pale);
    padding: 3px 8px;
    border-radius: 999px;
    transform: translateY(-2px);
  }
  :global(html.dark) .wip {
    background: rgba(248, 198, 102, 0.12);
    color: var(--yellow);
  }
  .year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg3);
    flex-shrink: 0;
  }
  .subtitle {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    color: var(--fg2);
    max-width: 60ch;
  }
  .ext {
    position: absolute;
    right: 18px;
    top: 26px;
    color: var(--fg3);
    opacity: 0.7;
    transition: transform 240ms var(--ease-out), color 200ms ease;
  }
  .item:hover .ext {
    color: var(--fg1);
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .underline path { animation: none; stroke-dashoffset: 0; }
    .item, .item::before, .ext { transition: none; }
  }
</style>
