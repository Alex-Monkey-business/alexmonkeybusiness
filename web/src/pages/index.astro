---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---

<Layout>
  <section class="hero">
    <h1 class="display">
      <span class="line">Alex</span>
      <span class="line">Monkey</span>
      <span class="line accent">Business<span class="period">.</span></span>
    </h1>

    <p class="lede">Small experiments, side projects and ideas — built in the open.</p>
  </section>

  <section class="projects" id="projects">
    <ul class="list">
      {projects.map((p, i) => {
        const href = p.url ?? `/projects/${p.slug}`;
        const external = Boolean(p.url);
        return (
          <li>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class="item"
            >
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="title">
                  {p.title}
                  {p.titleEm && <span class="title-em">{' '}{p.titleEm}</span>}
                  {p.status === 'wip' && <span class="wip">WIP</span>}
                </span>
                {p.subtitle && <span class="subtitle">{p.subtitle}</span>}
              </span>
              <span class="year">{p.year}</span>
              <span class="arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>

<style>
  /* ===== hero ===== */
  .hero {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20vh 32px 6vh;
  }
  @media (max-width: 640px) {
    .hero { padding: 16vh 18px 4vh; }
  }

  .display {
    font-family: var(--font-display);
    font-size: clamp(56px, 17vw, 168px);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    margin: 0;
    color: var(--fg1);
  }
  .display .line { display: block; }
  .display .accent { color: var(--accent); }
  .display .period { color: var(--fg1); }

  .lede {
    margin: 34px 0 0;
    max-width: 40ch;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--fg2);
  }

  /* ===== projects ===== */
  .projects {
    max-width: 1080px;
    margin: 0 auto;
    padding: 6vh 32px 8vh;
  }
  @media (max-width: 640px) {
    .projects { padding: 4vh 18px 6vh; }
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--border);
  }
  .list li { border-bottom: 1px solid var(--border); }
  .list li:last-child { border-bottom: 2px solid var(--border); }

  .item {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    column-gap: 28px;
    padding: 26px 8px;
    color: var(--fg1);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out),
                padding var(--dur-base) var(--ease-out);
  }
  .item:hover {
    background: var(--ink);
    color: var(--fg-invert);
    padding-left: 20px;
    padding-right: 20px;
  }
  :global(html.dark) .item:hover {
    background: var(--fg1);
    color: var(--bg);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--fg3);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .item:hover .num { color: var(--accent); }

  .body { min-width: 0; }
  .title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .title-em {
    font-weight: 400;
    color: var(--accent);
  }
  .item:hover .title-em { color: inherit; }
  .wip {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid currentColor;
    padding: 2px 6px;
    transform: translateY(-4px);
  }
  .subtitle {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.01em;
    color: var(--fg3);
    text-transform: lowercase;
  }
  .item:hover .subtitle { color: var(--fg-invert); opacity: 0.7; }
  :global(html.dark) .item:hover .subtitle { color: var(--bg); }

  .year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg3);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .item:hover .year { color: var(--fg-invert); }
  :global(html.dark) .item:hover .year { color: var(--bg); }

  .arrow {
    font-size: 22px;
    line-height: 1;
    color: var(--fg3);
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .item:hover .arrow {
    color: var(--accent);
    transform: translate(4px, -4px);
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: auto 1fr auto;
      column-gap: 16px;
      row-gap: 4px;
    }
    .year { display: none; }
    .subtitle { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .item, .arrow, .num, .year { transition: none; }
    .item:hover .arrow { transform: none; }
  }
</style>
