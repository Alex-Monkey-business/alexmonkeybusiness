---
/**
 * THE WHOLE SITE AS ONE SCREEN — everything except the mountain.
 *
 * The mountain arrives in the slot, and it is the ONLY thing the two surfaces
 * that use this disagree about: `/lab/skyline` puts footage behind the traced
 * outline, `/lab/strek` draws the outline alone. Copy, menu, type, timing and
 * script are shared, which is the only way a comparison between them is about
 * the mountain rather than about two pages that drifted apart.
 *
 * THE RIDGES ARE THE MENU. Seen from the north-east — which is what the trace
 * is — the two halves of the outline are two named climbing routes meeting at
 * the summit: the Zmuttgrat on the left, the Hörnligrat on the right. One item
 * owns each. The outline is drawn faintly at all times, so there is something
 * to notice before anyone points at anything; pointing at a name draws its
 * route down from the summit and drops the rest of the mountain back.
 *
 * Nothing on the page says any of that. The names are not written anywhere —
 * they were tried on the ridge itself and cut, because the mapping works
 * without them and a route name is a word this page does not need.
 *
 * The slotted mountain owns the `.sky` element and the `.seg` / `.draw` paths;
 * the script below reaches into it by those class names alone, so any surface
 * that provides them can be dropped in.
 *
 * TWO LEVELS, no navigation away. «Ting jeg har laget» swaps the menu in place
 * for the two projects, which take the same two ridges; «Tilbake» swaps back.
 * The mountain never reloads, so the page has no second state to design.
 *
 * THE TYPE IS SET IN THREE LAYERS PER CHARACTER, and each layer owns exactly
 * one job:
 *
 *   .ch   hover — lift and colour
 *   .cm   a clip — `overflow: hidden`, so arrival and departure happen behind
 *         an edge instead of through opacity, which is the whole difference
 *         between a letter appearing and a letter being printed
 *   .chi  arrival and departure
 *
 * They cannot be collapsed. An entrance animation with `forwards` keeps hold
 * of `transform` for the life of the page, and a hover transition on the same
 * property never gets a turn; and a single element cannot both be clipped and
 * move out of its own clip.
 */
import '../styles/variant-base.css';
import { t, path, langFromUrl } from '../i18n';
import { projects } from '../data/projects';

const lang = langFromUrl(Astro.url);
const s = t(lang);

/* The only string on this page that is not already in `strings.ts`. It stays
   here while this is a prototype rather than earning a place in the file. */
const back = lang === 'nb' ? 'Tilbake' : 'Back';

type Row = {
  key: string;
  title: string;
  titleEm?: string;
  /** Which ridge lights up. Omitted = nothing lights. */
  seg?: 'hornligrat' | 'zmuttgrat';
  href?: string;
  external?: boolean;
  /** Switches the menu to another level instead of navigating. */
  to?: string;
};

const byKey = Object.fromEntries(projects.map((p) => [p.slug, p]));

const LEVELS: Record<string, Row[]> = {
  root: [
    { key: 'work', title: s.work.label, seg: 'hornligrat', to: 'work' },
    { key: 'about', ...s.aboutCard, seg: 'zmuttgrat', href: path(lang, '/about') },
  ],
  work: [
    {
      key: 'halsen-g15',
      title: byKey['halsen-g15'].title,
      titleEm: byKey['halsen-g15'].titleEm,
      seg: 'hornligrat',
      href: path(lang, '/projects/halsen-g15'),
    },
    {
      key: 'simons-solfilm',
      title: byKey['simons-solfilm'].title,
      titleEm: byKey['simons-solfilm'].titleEm,
      seg: 'zmuttgrat',
      href: byKey['simons-solfilm'].url,
      external: true,
    },
    { key: 'back', title: back, to: 'root' },
  ],
};

/** One span per character, numbered across the whole line so the stagger runs
    unbroken through the italic half. */
const letters = (r: Row) => {
  const parts: { t: string; em: boolean }[] = [];
  for (const ch of r.title) parts.push({ t: ch, em: false });
  if (r.titleEm) {
    parts.push({ t: ' ', em: false });
    for (const ch of r.titleEm) parts.push({ t: ch, em: true });
  }
  return parts;
};

const levels = Object.entries(LEVELS).map(([name, rows]) => ({
  name,
  rows: rows.map((r) => ({
    ...r,
    parts: letters(r),
    full: r.titleEm ? `${r.title} ${r.titleEm}` : r.title,
  })),
}));
---

<div class="variant one-screen">
  <slot />

  <nav class="menu">
    {levels.map((l) => (
      <ul class="level" data-level={l.name} hidden={l.name !== 'root'}>
        {l.rows.map((r, i) => (
          <li class={r.key === 'back' ? 'quiet' : undefined} style={`--i:${i}`}>
            {r.to ? (
              <button class="row" type="button" data-to={r.to} data-seg={r.seg}>
                <span class="sr-only">{r.full}</span>
                <span class="letters" aria-hidden="true">
                  {r.parts.map((c, n) => <span class={c.em ? 'ch em' : 'ch'} style={`--c:${n}`}><span class="cm"><span class="chi">{c.t === ' ' ? '\u00a0' : c.t}</span></span></span>)}
                </span>
              </button>
            ) : (
              <a
                class="row"
                href={r.href}
                data-seg={r.seg}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener noreferrer' : undefined}
              >
                <span class="sr-only">{r.full}</span>
                <span class="letters" aria-hidden="true">
                  {r.parts.map((c, n) => <span class={c.em ? 'ch em' : 'ch'} style={`--c:${n}`}><span class="cm"><span class="chi">{c.t === ' ' ? '\u00a0' : c.t}</span></span></span>)}
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    ))}
  </nav>

  <p class="sig">
    Alex Monkey business.
    <!-- A surface that borrows a photograph puts its credit here, after the
         signature: it is the one strip of the screen that is reliably sky at
         every width. Empty on the surfaces that draw their own. -->
    <slot name="credit" />
  </p>
</div>

<style>
  /* One screen. The Layout's footer belongs to a page that scrolls; this one
     does not have a bottom to put it at. */
  .one-screen :global(~ footer),
  :global(main:has(.one-screen) footer) { display: none; }
  /* The language hint is a bar across the bottom of a page that has room for
     one. This page's whole argument is that nothing else is on it. */
  :global(body:has(.one-screen) .lang-hint) { display: none; }
  :global(html:has(.one-screen)),
  :global(body:has(.one-screen)) { overflow: hidden; }
  :global(main:has(.one-screen)) { min-height: 0; }
  :global(main:has(.one-screen) .page) { max-width: none; padding: 0; }

  .one-screen {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    align-content: center;
    padding: clamp(24px, 5vw, 64px);
    padding-top: clamp(96px, 14vh, 160px);
  }

  .menu {
    position: relative;
    z-index: 1;
    align-self: start;
    /* Type sits in the open left, and high enough to clear the left ridge:
       the mountain is a cut-out now, so anything that overlaps it is on rock
       rather than on sky, and at this size that is the difference between
       set on the page and set on a photograph. */
    padding-top: 22vh;
    max-width: min(60ch, 62vw);
  }
  .level { list-style: none; margin: 0; padding: 0; }
  .level li + li { margin-top: clamp(10px, 1.4vh, 20px); }
  /* Written as `li + li.quiet`, not `li.quiet`: Astro hangs a scoping
     attribute on every compound, so `.level li + li` scores one attribute more
     than `.level li.quiet` and would quietly outrank it. */
  .level li + li.quiet { margin-top: clamp(28px, 4.6vh, 56px); }

  .row {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 1.2;
    /* Positive tracking, not the display scale's negative: at this size the
       letters want air, and the extra space is most of what reads as fine. */
    letter-spacing: 0.012em;
    /* The two `to` rows are buttons, because they change the menu rather than
       going anywhere — and a button brings a lot of chrome with it. */
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    /* Rows dim for their neighbour, so the whole page narrows to one name. */
    transition: opacity 320ms var(--ease-out);
  }
  .quiet .row { font-size: clamp(18px, 1.9vw, 26px); color: var(--fg2); }

  /* No `white-space: pre` — spaces are already non-breaking characters of
     their own, and `pre` would render the source indentation between the
     inline-block spans as a real gap between every letter. */
  .ch,
  .cm,
  .chi { display: inline-block; }

  .ch {
    transition:
      color 260ms var(--ease-out),
      transform 520ms var(--ease-spring);
  }
  .ch.em { font-style: italic; }

  /* The clip. Padding extends the box that `overflow` cuts at, so descenders
     survive; the negative margin takes the padding back out of the layout. */
  .cm {
    overflow: hidden;
    padding: 0.06em 0.02em 0.18em;
    margin: -0.06em -0.02em -0.18em;
  }

  /**
   * THE WAVE. Bigger than it was, and on the spring: it overshoots and settles
   * instead of sliding, which at this weight of type is the difference between
   * a hover state and an event.
   *
   * The delay is only on the hover rule, so the wave runs across the word on
   * the way in and the whole word drops together on the way out — which is
   * what keeps a pointer moving down the list from smearing.
   */
  .row:hover .ch,
  .row:focus-visible .ch,
  .row.lit .ch {
    color: var(--hot);
    transform: translateY(-0.3em);
    transition-delay: calc(var(--c) * 34ms);
  }
  /* The neighbours get out of the way. */
  .menu.narrowed .row { opacity: 0.3; }
  .menu.narrowed .row:hover,
  .menu.narrowed .row:focus-visible,
  .menu.narrowed .row.lit { opacity: 1; }

  /**
   * ARRIVAL AND DEPARTURE, on the inner span so they are clear of hover's hold
   * on `transform`. Letters are printed upward out of the clip and, on a level
   * change, carried on out of the top — the two halves are one continuous roll
   * rather than a fade out and a fade in.
   *
   * Gated on classes the script removes and re-adds, which is what makes the
   * animation run again on every level change.
   */
  :global(html.js) .chi { opacity: 0; }
  :global(html.js) .level.enter .chi {
    animation: letter-in 780ms var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 170ms + var(--c) * 26ms);
  }
  :global(html.js) .level.exit .chi {
    opacity: 1;
    animation: letter-out 420ms var(--ease-in) forwards;
    animation-delay: calc(var(--c) * 14ms);
  }
  @keyframes letter-in {
    from { opacity: 1; transform: translateY(115%) }
    to   { opacity: 1; transform: none }
  }
  @keyframes letter-out {
    from { opacity: 1; transform: none }
    to   { opacity: 1; transform: translateY(-115%) }
  }

  .sig {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: var(--t-14);
    /* It sits on the mountain in portrait, so it cannot be as quiet as it
       would be on bare paper. */
    color: var(--fg2);
  }
  :global(html.dark) .sig { color: var(--fg3); }

  /* The credit runs on from the signature, one step quieter — it is owed, not
     said. Its own line on a phone, where the two together would wrap on rock. */
  .one-screen :global(.credit) {
    margin-left: 0.6em;
    color: var(--fg4);
  }
  @media (orientation: portrait) and (max-width: 820px) {
    .one-screen :global(.credit) { display: block; margin: 0.35em 0 0; }
  }

  /* Portrait puts the mountain in the lower half and the names in the sky
     above it — see the framing block in Skyline.astro, which is what makes
     that half empty. */
  @media (orientation: portrait) and (max-width: 820px) {
    .menu { max-width: none; padding-top: 0; }
    .one-screen {
      padding-top: clamp(92px, 15vh, 150px);
      align-content: start;
    }
    .row { font-size: clamp(28px, 8.4vw, 44px); }
    .quiet .row { font-size: clamp(17px, 4.6vw, 22px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch,
    .row { transition: none; }
    .row:hover .ch,
    .row:focus-visible .ch,
    .row.lit .ch { transform: none; transition-delay: 0s; }
    :global(html.js) .chi,
    :global(html.js) .level.enter .chi,
    :global(html.js) .level.exit .chi {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.sky');
  const menu = document.querySelector<HTMLElement>('.menu');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  /* Length of the exit roll: the last character's delay plus its duration.
     Kept in one place because the CSS above and this number have to agree. */
  const EXIT = 560;

  if (menu) {
    const levels = Array.from(menu.querySelectorAll<HTMLElement>('.level'));

    const enter = (l: HTMLElement) => {
      l.classList.remove('enter', 'exit');
      /* Reading a layout property between the remove and the add is what
         restarts the animation; without it the browser coalesces the two and
         nothing runs the second time. */
      void l.offsetWidth;
      l.classList.add('enter');
    };

    let busy = false;
    const show = (name: string, animate = true) => {
      const next = levels.find((l) => l.dataset.level === name);
      const now = levels.find((l) => !l.hidden);
      if (!next || busy) return;

      const swap = () => {
        for (const l of levels) {
          l.hidden = l !== next;
          if (l !== next) l.classList.remove('enter', 'exit');
        }
        enter(next);
        busy = false;
        /* The surface reads this: the camera moves with the level. */
        if (stage) stage.dataset.level = name;
        /* One breath on the mountain, so the remap is not silent. */
        if (stage && !still) {
          stage.classList.add('shift');
          setTimeout(() => stage.classList.remove('shift'), 620);
        }
      };

      if (!animate || still || !now || now === next) {
        busy = true;
        swap();
        return;
      }
      /* The outgoing rows roll out of the top before the incoming ones are
         printed. Two moves in sequence, never a cross-fade — a cross-fade at
         this size reads as a glitch. */
      busy = true;
      now.classList.remove('enter');
      void now.offsetWidth;
      now.classList.add('exit');
      drop();
      setTimeout(swap, EXIT);
    };

    /* The first level waits for the ridges to be most of the way down. The
       nav's «Prosjekter» and the case's «Tilbake» point at #projects — the
       landing's old anchor — so that hash opens the work level directly. */
    const first = location.hash === '#projects' ? 'work' : 'root';
    setTimeout(() => show(first, true), 1000);
    addEventListener('hashchange', () => { if (location.hash === '#projects') show('work'); });
    /* The second click on a #projects link fires no hashchange — the hash is
       already there. Catch the click itself when it points at this page. */
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#projects"]');
      if (!a) return;
      const u = new URL(a.href, location.href);
      if (u.pathname !== location.pathname) return;
      e.preventDefault();
      history.replaceState(null, '', '#projects');
      show('work');
    });

    /* Delegated, so it keeps working after a level swaps the rows out. */
    menu.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-to]');
      if (!btn) return;
      show(btn.dataset.to!);
    });

    const lift = (el: HTMLElement) => {
      const seg = el.dataset.seg;
      if (!seg) return;
      menu.classList.add('narrowed');
      if (!stage) return;
      stage.querySelector(`.seg[data-seg="${seg}"]`)?.classList.add('hot');
      /* The faint line under the route being climbed is exempt from the dim. */
      stage.querySelector(`.draw[data-seg="${seg}"]`)?.classList.add('under');
    };
    const drop = () => {
      menu.classList.remove('narrowed');
      menu.querySelectorAll('.row.lit').forEach((n) => n.classList.remove('lit'));
      if (!stage) return;
      stage.querySelectorAll('.seg.hot').forEach((n) => n.classList.remove('hot'));
      stage.querySelectorAll('.draw.under').forEach((n) => n.classList.remove('under'));
    };

    const rowFrom = (e: Event) =>
      (e.target as HTMLElement).closest<HTMLElement>('.row');

    /* `pointerout` bubbles from every character span, so moving the pointer
       from one letter to the next inside the same name would otherwise drop
       the route and re-draw it between two frames. Only a pointer that has
       actually left the name counts as having left. */
    const left = (e: PointerEvent | FocusEvent) => {
      const from = (e.target as HTMLElement).closest('.row');
      const to = (e.relatedTarget as HTMLElement | null)?.closest?.('.row');
      if (from && from === to) return;
      drop();
    };

    menu.addEventListener('pointerover', (e) => {
      const row = rowFrom(e);
      if (row) lift(row);
    });
    menu.addEventListener('pointerout', left as EventListener);
    menu.addEventListener('pointercancel', drop);
    menu.addEventListener('focusin', (e) => {
      const row = rowFrom(e);
      if (row) lift(row);
    });
    menu.addEventListener('focusout', left as EventListener);
    /* Belt and braces: a pointer that leaves the menu at speed can outrun the
       out-event on the row it was on. */
    menu.addEventListener('pointerleave', drop);

    /**
     * A PHONE HAS NO POINTER, and the mapping between a name and a ridge is
     * the only thing this page has to teach. So on a touch screen it shows the
     * pairing once, unprompted, after the mountain has settled — each route
     * drawn under its own name — and then stops and stays out of the way.
     * A tap anywhere cancels it, because by then the reader is driving.
     */
    if (matchMedia('(pointer: coarse)').matches && !still) {
      const rows = () =>
        Array.from(
          menu.querySelectorAll<HTMLElement>('.level:not([hidden]) .row[data-seg]'),
        );
      let timers: number[] = [];
      const stop = () => {
        timers.forEach(clearTimeout);
        timers = [];
        drop();
      };
      const demo = () => {
        rows().forEach((row, i) => {
          const at = 2900 + i * 1500;
          timers.push(
            setTimeout(() => {
              drop();
              row.classList.add('lit');
              lift(row);
            }, at),
            setTimeout(drop, at + 1150),
          );
        });
      };
      demo();
      menu.addEventListener('pointerdown', stop, { once: true });
      addEventListener('touchstart', stop, { once: true, passive: true });
    }
  }
</script>
