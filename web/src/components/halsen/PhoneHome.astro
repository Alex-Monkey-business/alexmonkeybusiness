---
/* Demo 01 — Smart coach home: reminders resolving one by one */
---

<div class="phone bb-home" data-demo="home">
  <div class="phone-bar">
    <span>09:41</span>
    <span class="dots"><i></i><i></i><i></i></span>
  </div>
  <div class="phone-screen">
    <div class="bb-head">
      <div class="scr-h">God dag, Alex</div>
      <div class="scr-sub" style="margin-top:5px">Mandag 22. juni</div>
    </div>

    <div class="d-card bb-next">
      <span class="scr-label">Neste kamp · onsdag</span>
      <div class="bb-next-row"><span class="bb-team-g">Grønn</span><span class="bb-vs">vs</span><span>Eik G15</span></div>
      <div class="bb-next-meta">17:30 · Hjemme · Framnes</div>
    </div>

    <div class="bb-todo">
      <div class="bb-todo-head">
        <span class="scr-label">Å ordne</span>
        <span class="bb-count" data-count>4 igjen</span>
      </div>
      <div class="d-row bb-task"><span class="bb-check"></span><span class="bb-task-t">Sett dommer</span><span class="d-meta">hjemmekamp</span></div>
      <div class="d-row bb-task"><span class="bb-check"></span><span class="bb-task-t">Betal dommer</span><span class="d-meta">Vipps</span></div>
      <div class="d-row bb-task"><span class="bb-check"></span><span class="bb-task-t">Lånespillere</span><span class="d-meta">2 mangler</span></div>
      <div class="d-row bb-task"><span class="bb-check"></span><span class="bb-task-t">Skriv referat</span><span class="d-meta">forrige</span></div>
    </div>
  </div>
</div>

<style>
  .bb-next-row {
    display: flex; align-items: baseline; gap: 8px;
    margin-top: 9px;
    font-family: var(--app-sans); font-weight: 700; font-size: 17px; letter-spacing: -0.01em;
    color: var(--app-text);
  }
  .bb-team-g { color: var(--t-green-fg); }
  .bb-vs { font-weight: 500; font-size: 12px; color: var(--app-text-3); }
  .bb-next-meta { margin-top: 6px; font-size: 12px; font-weight: 500; color: var(--app-text-3); }

  .bb-todo { display: flex; flex-direction: column; gap: 7px; }
  .bb-todo-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1px; }
  .bb-count { font-family: var(--app-sans); font-size: 11px; font-weight: 600; color: var(--app-text-3); }

  .bb-task { gap: 9px; }
  .bb-task-t { flex: 1; }
  .bb-check {
    width: 16px; height: 16px; flex-shrink: 0; border-radius: 6px;
    border: 1.5px solid var(--app-text-3);
    display: inline-flex; align-items: center; justify-content: center;
    transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .bb-task.is-active { background: var(--app-surface); border-color: var(--app-border); }
  .bb-task.is-active .bb-check { background: var(--app-accent); border-color: var(--app-accent); }
  .bb-task.is-active .bb-check::after {
    content: '✓'; font-size: 10px; line-height: 1; color: var(--app-on-accent); font-weight: 700;
  }
  .bb-task.is-active .bb-task-t { color: var(--app-text-3); text-decoration: line-through; text-decoration-thickness: 1.5px; }
</style>
