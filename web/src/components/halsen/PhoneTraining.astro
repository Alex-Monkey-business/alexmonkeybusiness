---
/* Demo 04 — Training module: drill cards expanding to reveal learning points */
---

<div class="phone bb-train" data-demo="training">
  <div class="phone-bar">
    <span>TRENING</span>
    <span>UKEPLAN</span>
  </div>
  <div class="phone-screen">
    <div class="bb-head">
      <span class="scr-label">Frem til sommerferien</span>
      <div class="scr-h" style="margin-top:7px">Tirsdag</div>
      <div class="scr-sub" style="margin-top:6px">Ferdigheter under press</div>
    </div>

    <div class="bb-drills">
      <div class="bb-drill" data-drill="0">
        <div class="bb-drill-head"><span class="bb-drill-n">01</span><span class="bb-drill-t">Medtak &amp; vending</span><span class="bb-drill-x">+</span></div>
        <div class="bb-drill-points"><span>Første touch vekk fra press</span><span>Åpne kroppen før medtak</span></div>
      </div>
      <div class="bb-drill" data-drill="1">
        <div class="bb-drill-head"><span class="bb-drill-n">02</span><span class="bb-drill-t">3v3 med press i ryggen</span><span class="bb-drill-x">+</span></div>
        <div class="bb-drill-points"><span>Vri spillet til ledig side</span><span>Støtte i bredde og dybde</span></div>
      </div>
      <div class="bb-drill" data-drill="2">
        <div class="bb-drill-head"><span class="bb-drill-n">03</span><span class="bb-drill-t">Vinneren står · 7er</span><span class="bb-drill-x">+</span></div>
        <div class="bb-drill-points"><span>Avslutt tidlig</span><span>Tempo i overgang</span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .bb-drills { display: flex; flex-direction: column; gap: 8px; }
  .bb-drill { border: 1px solid var(--border-hair); background: var(--bg); transition: border-color var(--dur-base) var(--ease-out); }
  .bb-drill.is-open { border-color: var(--fg1); }
  .bb-drill-head { display: flex; align-items: center; gap: 9px; padding: 10px 11px; }
  .bb-drill-n { font-family: var(--font-mono); font-size: 11px; color: var(--fg3); }
  .bb-drill-t { flex: 1; font-family: var(--font-display); font-weight: 600; font-size: 13.5px; letter-spacing: -0.01em; color: var(--fg1); }
  .bb-drill-x { font-family: var(--font-mono); font-size: 14px; color: var(--fg3); transition: transform var(--dur-base) var(--ease-out); }
  .bb-drill.is-open .bb-drill-x { transform: rotate(45deg); color: var(--fg1); }

  .bb-drill-points {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows 320ms var(--ease-out);
  }
  .bb-drill.is-open .bb-drill-points { grid-template-rows: 1fr; }
  .bb-drill-points > span {
    overflow: hidden; min-height: 0;
    font-family: var(--font-mono); font-size: 10.5px; line-height: 1.5; color: var(--fg2);
    padding: 0 11px;
  }
  .bb-drill-points > span:first-child { padding-top: 0; }
  .bb-drill.is-open .bb-drill-points > span { padding: 3px 11px; }
  .bb-drill.is-open .bb-drill-points > span:last-child { padding-bottom: 11px; }
  .bb-drill-points > span::before { content: '— '; color: var(--fg4); }
</style>
