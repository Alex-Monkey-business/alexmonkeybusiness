---
/* Demo 05 — Parent login: PIN fills, unlocks a read-only season view */
---

<div class="phone bb-parent" data-demo="parent">
  <div class="phone-bar">
    <span>BenchBoss</span>
    <span class="bb-role" data-role>Låst</span>
  </div>
  <div class="phone-screen">
    <div class="bb-lock" data-lock>
      <div class="scr-h">BenchBoss</div>
      <div class="scr-sub" style="margin-top:8px">Forelder-PIN</div>
      <div class="bb-pin">
        <span class="bb-pin-dot"></span><span class="bb-pin-dot"></span><span class="bb-pin-dot"></span><span class="bb-pin-dot"></span>
      </div>
    </div>

    <div class="bb-season" data-season>
      <div class="bb-head">
        <div class="scr-h">Kamper</div>
        <div class="scr-sub" style="margin-top:5px">Forelder · sesong 2026</div>
      </div>
      <div class="bb-filters">
        <span class="bb-filter is-on">Alle</span><span class="bb-filter">Grønn</span><span class="bb-filter">Rød</span><span class="bb-filter">Hvit</span>
      </div>
      <div class="d-row bb-ev"><span class="bb-ev-day">ons</span><span class="bb-ev-t">Grønn vs Eik</span><span class="d-meta">17:30</span></div>
      <div class="d-row bb-ev"><span class="bb-ev-day">lør</span><span class="bb-ev-t">Rød vs Larvik</span><span class="d-meta">11:00</span></div>
      <div class="d-row bb-ev"><span class="bb-ev-day">tir</span><span class="bb-ev-t">Trening · Framnes</span><span class="d-meta">18:00</span></div>
    </div>
  </div>
</div>

<style>
  .bb-role { font-weight: 600; color: var(--app-text-3); }

  .bb-lock { display: flex; flex-direction: column; align-items: flex-start; transition: opacity 300ms var(--ease-out); }
  .bb-pin { display: flex; gap: 13px; margin-top: 28px; }
  .bb-pin-dot { width: 14px; height: 14px; border-radius: 99px; border: 1.5px solid var(--app-text-3); transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .bb-pin-dot.is-filled { background: var(--app-accent); border-color: var(--app-accent); }

  .bb-season { display: none; flex-direction: column; gap: 9px; }
  .bb-season .bb-head { margin-bottom: 1px; }

  .bb-parent[data-unlocked="1"] .bb-lock { display: none; }
  .bb-parent[data-unlocked="1"] .bb-season { display: flex; animation: bb-fade 380ms var(--ease-out); }
  @keyframes bb-fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .bb-filters { display: flex; gap: 6px; }
  .bb-filter { font-family: var(--app-sans); font-size: 11px; font-weight: 600; color: var(--app-text-2); border: 1px solid var(--app-border); border-radius: 99px; padding: 4px 11px; }
  .bb-filter.is-on { background: var(--app-accent); color: var(--app-on-accent); border-color: var(--app-accent); }

  .bb-ev { gap: 10px; }
  .bb-ev-day { font-family: var(--app-sans); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--app-text-3); width: 26px; flex-shrink: 0; }
  .bb-ev-t { flex: 1; font-weight: 500; font-size: 13px; }
</style>
