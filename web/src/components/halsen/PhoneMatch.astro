---
/* Demo 02 — Match mode: ticking clock, live minutes, a substitution, a goal */
---

<div class="phone bb-match" data-demo="match">
  <div class="phone-bar">
    <span>KAMPMODUS</span>
    <span class="bb-livebar"><span class="bb-live-dot"></span>LIVE</span>
  </div>
  <div class="phone-screen">
    <div class="bb-score">
      <span class="bb-team">Grønn</span>
      <span class="bb-nums"><span data-home>2</span><span class="bb-dash">–</span><span data-away>1</span></span>
      <span class="bb-team">Eik</span>
    </div>
    <div class="bb-clock">
      <span class="scr-label">2. omgang</span>
      <span class="bb-time" data-clock>38:14</span>
    </div>

    <div class="bb-onfield">
      <span class="scr-label">På banen · minutter</span>
      <div class="d-row bb-pl"><span class="bb-name">Isak</span><span class="d-meta" data-min="41">41:0</span></div>
      <div class="d-row bb-pl"><span class="bb-name">Syver</span><span class="d-meta" data-min="38">38:1</span></div>
      <div class="d-row bb-pl" data-sub-target><span class="bb-name" data-name>Matheo</span><span class="d-meta" data-min="22">22:0</span></div>
    </div>

    <div class="bb-subbanner" data-sub>
      <span class="bb-sub-arrow">↑</span> Aksel inn <span class="bb-sub-sep">·</span> <span class="bb-sub-arrow down">↓</span> Matheo ut
    </div>
  </div>
</div>

<style>
  .bb-livebar { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); }
  .bb-live-dot { width: 6px; height: 6px; background: var(--accent); display: inline-block; animation: case-pulse 1.4s ease-in-out infinite; }

  .bb-score {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px;
    padding: 6px 0 2px;
  }
  .bb-team { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg3); text-align: center; }
  .bb-nums { font-family: var(--font-display); font-weight: 700; font-size: 40px; letter-spacing: -0.04em; color: var(--fg1); display: inline-flex; align-items: baseline; gap: 10px; line-height: 1; }
  .bb-nums [data-home].flash { color: var(--accent); }
  .bb-dash { color: var(--fg4); font-weight: 400; }

  .bb-clock { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-hair); border-bottom: 1px solid var(--border-hair); padding: 8px 0; }
  .bb-time { font-family: var(--font-mono); font-size: 16px; font-weight: 500; color: var(--fg1); font-variant-numeric: tabular-nums; }

  .bb-onfield { display: flex; flex-direction: column; gap: 7px; }
  .bb-onfield .scr-label { margin-bottom: 1px; }
  .bb-name { flex: 1; }
  .bb-pl .d-meta { font-variant-numeric: tabular-nums; }
  .bb-pl[data-sub-target].swapped { animation: bb-swap 520ms var(--ease-out); }
  @keyframes bb-swap { 0% { background: var(--fg1); } 100% { background: var(--bg); } }

  .bb-subbanner {
    font-family: var(--font-mono); font-size: 11px; color: var(--fg-invert); background: var(--fg1);
    padding: 9px 11px; display: flex; align-items: center; gap: 6px;
    opacity: 0; transform: translateY(8px); transition: opacity 280ms var(--ease-out), transform 280ms var(--ease-out);
  }
  .bb-match[data-sub-show="1"] .bb-subbanner { opacity: 1; transform: none; }
  .bb-sub-arrow { font-weight: 700; }
  .bb-sub-arrow.down { color: var(--fg3); }
  .bb-sub-sep { color: var(--fg4); }
</style>
