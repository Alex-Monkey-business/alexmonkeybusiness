---
/* Demo 02 — Match mode: ticking clock, live minutes, a substitution, a goal */
---

<div class="phone bb-match" data-demo="match">
  <div class="phone-bar">
    <span>Kampmodus</span>
    <span class="bb-livebar"><span class="bb-live-dot"></span>LIVE</span>
  </div>
  <div class="phone-screen">
    <div class="bb-score">
      <span class="bb-team bb-team-g">Grønn</span>
      <span class="bb-nums"><span data-home>2</span><span class="bb-dash">–</span><span data-away>1</span></span>
      <span class="bb-team">Eik</span>
    </div>
    <div class="bb-clock">
      <span class="scr-label">2. omgang</span>
      <span class="bb-time" data-clock>38:14</span>
    </div>

    <div class="bb-onfield">
      <span class="scr-label">På banen · minutter</span>
      <div class="d-row bb-pl"><span class="bb-name">Isak</span><span class="d-meta" data-min="41">41:0</span></div>
      <div class="d-row bb-pl"><span class="bb-name">Syver</span><span class="d-meta" data-min="38">38:1</span></div>
      <div class="d-row bb-pl" data-sub-target><span class="bb-name" data-name>Matheo</span><span class="d-meta" data-min="22">22:0</span></div>
    </div>

    <div class="bb-subbanner" data-sub>
      <span class="bb-sub-arrow up">↑</span> Aksel inn <span class="bb-sub-sep">·</span> <span class="bb-sub-arrow down">↓</span> Matheo ut
    </div>
  </div>
</div>

<style>
  .bb-livebar { display: inline-flex; align-items: center; gap: 6px; color: var(--app-live); font-weight: 700; letter-spacing: 0.04em; }
  .bb-live-dot { width: 6px; height: 6px; border-radius: 99px; background: var(--app-live); display: inline-block; animation: case-pulse 1.4s ease-in-out infinite; }

  .bb-score {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px;
    padding: 8px 0 4px;
  }
  .bb-team { font-family: var(--app-sans); font-size: 12px; font-weight: 600; color: var(--app-text-3); text-align: center; }
  .bb-team-g { color: var(--t-green-fg); }
  .bb-nums { font-family: var(--app-sans); font-weight: 700; font-size: 40px; letter-spacing: -0.03em; color: var(--app-text); display: inline-flex; align-items: baseline; gap: 10px; line-height: 1; }
  .bb-nums [data-home].flash { color: var(--app-live); }
  .bb-dash { color: var(--app-text-3); font-weight: 500; }

  .bb-clock { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--app-border); border-bottom: 1px solid var(--app-border); padding: 9px 0; }
  .bb-time { font-family: var(--app-sans); font-size: 17px; font-weight: 700; color: var(--app-text); font-variant-numeric: tabular-nums; }

  .bb-onfield { display: flex; flex-direction: column; gap: 7px; }
  .bb-onfield .scr-label { margin-bottom: 1px; }
  .bb-name { flex: 1; }
  .bb-pl .d-meta { font-variant-numeric: tabular-nums; }
  .bb-pl[data-sub-target].swapped { animation: bb-swap 600ms var(--ease-out); }
  @keyframes bb-swap { 0% { background: var(--app-surface); border-color: var(--app-accent); } 100% { background: var(--app-bg); border-color: var(--app-border); } }

  .bb-subbanner {
    font-family: var(--app-sans); font-size: 12px; font-weight: 500; color: var(--app-on-accent); background: var(--app-accent);
    border-radius: var(--app-radius-sm);
    padding: 10px 12px; display: flex; align-items: center; gap: 6px;
    opacity: 0; transform: translateY(8px); transition: opacity 280ms var(--ease-out), transform 280ms var(--ease-out);
  }
  .bb-match[data-sub-show="1"] .bb-subbanner { opacity: 1; transform: none; }
  .bb-sub-arrow { font-weight: 700; }
  .bb-sub-arrow.down { opacity: 0.55; }
  .bb-sub-sep { opacity: 0.4; }
</style>
