---/**
 * THE FRONT PAGE — natt, promoted from /lab on 2 Sep. `/lab/strek` with the
 * photograph inside the shape instead of flat ink, exposed the way Alex's
 * reference is exposed, on a ground that is always black — #000, not the dark
 * theme's #121211. The plate's sky is baked
 * to zero and the page has to be the same zero, or the plate is a rectangle.
 *
 * Same copy, same menu, same ridges-as-menu as `/lab/skyline` and `/lab/strek`
 * — but this page is Alex's experiment, and the type is the second variable:
 * AN INSTRUMENT, NOT A WEBSITE. Mono grotesk, lowercase, wide tracking, one
 * signal colour. Names decode into place instead of rolling in; a scan line
 * sweeps the column as they resolve; a readout under them names the ridge
 * being pointed at. The design system's rules are relaxed here on purpose —
 * see `Natt.astro` for the photograph, and the notes below for the type.
 *
 * THE PALETTE IS DECLARED LOCALLY, NOT TOGGLED. Type in the photograph's own
 * black has nowhere to go on cream, so this surface is velvet in both themes.
 * That is a real cost and it is stated rather than hidden: the theme toggle
 * still works everywhere else on the site, and on this page it does nothing.
 *
 * THE PHOTOGRAPH IS CREDITED ON THE PAGE. CC BY 2.0 asks for the author, the
 * licence and a note that the work was altered; all three run on from the
 * signature at the bottom, in `mix-blend-mode: difference` — white on sky,
 * black on snow, legible wherever the mountain happens to be underneath.
 */
import OneScreen from '../OneScreen.astro';
import Natt from '../Natt.astro';
import { langFromUrl } from '../../i18n';
import '../../styles/instrument.css';

const lang = langFromUrl(Astro.url);
const nb = lang === 'nb';
const credit = nb ? { photo: 'Foto', edited: 'bearbeidet' } : { photo: 'Photo', edited: 'edited' };
const SOURCE = 'https://commons.wikimedia.org/wiki/File:Alps_of_Switzerland_Matterhorn_(23979169808).jpg';
const LICENCE = 'https://creativecommons.org/licenses/by/2.0/';

/* The readout. Idle, it cycles: the mountain; then the snow on it, read the way
   a freerider reads a face; then, once, sand — the other surface Alex plays on,
   and the net is 2.43 m. Pointing at a name: its ridge, its side, the year it
   was first climbed — Whymper's party on the Hörnli in 1865, Mummery on the
   Zmutt in 1879. All true, none of it decorative. */
const readout = nb
  ? {
      idle: [
        'MATTERHORN · 4478 M · 45.9766° N · 7.6585° E',
        'HELNING 38° · NORDVENDT · 40 CM PUDDER',
        'SAND · 28 °C · 2 M/S PÅLANDS · NETT 2.43 M',
      ],
      hornligrat: 'HÖRNLIGRAT · NORDØSTRYGGEN · 1865',
      zmuttgrat: 'ZMUTTGRAT · NORDVESTRYGGEN · 1879',
    }
  : {
      idle: [
        'MATTERHORN · 4478 M · 45.9766° N · 7.6585° E',
        'SLOPE 38° · NORTH FACING · 40 CM POWDER',
        'SAND · 28 °C · 2 M/S ONSHORE · NET 2.43 M',
      ],
      hornligrat: 'HÖRNLIGRAT · NORTH-EAST RIDGE · 1865',
      zmuttgrat: 'ZMUTTGRAT · NORTH-WEST RIDGE · 1879',
    };
---

<div class="always-dark inst" data-readout={JSON.stringify(readout)}>
  <OneScreen>
    <Natt />
    <span slot="credit" class="credit">
      {credit.photo}: <a href={SOURCE} target="_blank" rel="noopener noreferrer">kuhnmi</a>
      · <a href={LICENCE} target="_blank" rel="noopener noreferrer">CC BY 2.0</a>
      · {credit.edited}
    </span>
  </OneScreen>
</div>

<style>
  /* The palette, the face and the signal are `instrument.css`'s — shared with
     /about and the case pages. This file is the one-screen layout only. */

  /* ---- The names as an instrument --------------------------------------- */

  .always-dark :global(.menu) {
    position: relative;
    /* Room for the index on the left of each row. */
    padding-left: 2.4em;
    counter-reset: row;
  }
  .always-dark :global(.row) {
    font-family: var(--font-inst);
    font-weight: 300;
    font-size: clamp(18px, 2vw, 28px);
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    font-variant-ligatures: none;
  }
  .always-dark :global(.quiet .row) {
    font-size: clamp(12px, 1.1vw, 15px);
    color: var(--fg3);
  }
  .always-dark :global(.level li) { position: relative; }
  .always-dark :global(.level li + li) { margin-top: clamp(14px, 2.2vh, 28px); }
  .always-dark :global(.level li + li.quiet) { margin-top: clamp(30px, 5vh, 60px); }

  /* The index: 01, 02 — set in the signal, small, hung in the margin. The
     `back` row gets an arrow instead of a number; it is not an item. */
  .always-dark :global(.level li::before) {
    counter-increment: row;
    content: '0' counter(row);
    position: absolute;
    left: -2.4em;
    top: 0.55em;
    font-family: var(--font-inst);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--signal);
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .always-dark :global(.level.enter li::before) { opacity: 1; transition-delay: calc(var(--i) * 220ms + 200ms); }
  .always-dark :global(.level li.quiet::before) { content: '<'; counter-increment: none; }

  /* No lift, no wave, no roll. Hightech does not bounce: the letters hold
     still and change state. The decode does the moving (see the script). */
  .always-dark :global(.ch),
  .always-dark :global(.row:hover .ch),
  .always-dark :global(.row:focus-visible .ch),
  .always-dark :global(.row.lit .ch) {
    transform: none;
    transition: color 180ms linear;
    transition-delay: 0s;
  }
  .always-dark :global(.row:hover .ch),
  .always-dark :global(.row:focus-visible .ch),
  .always-dark :global(.row.lit .ch) { color: var(--signal); }
  .always-dark :global(.cm) { overflow: visible; padding: 0; margin: 0; }
  :global(html.js) .always-dark :global(.chi),
  :global(html.js) .always-dark :global(.level.enter .chi) {
    opacity: 1;
    animation: none;
    transform: none;
  }
  :global(html.js) .always-dark :global(.level.exit .chi) {
    animation: inst-out 320ms var(--ease-in) forwards;
    animation-delay: calc(var(--c) * 10ms);
  }
  @keyframes inst-out {
    to { opacity: 0; }
  }
  /* Glyphs still resolving are dimmer than the ones that have landed. */
  .always-dark :global(.chi.noise) { color: var(--fg4); }

  /* The underline draws under the pointed-at row, from the left, in the signal. */
  .always-dark :global(.row::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35em;
    height: 1px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 420ms var(--ease-out);
  }
  .always-dark :global(.row) { position: relative; }
  .always-dark :global(.row:hover::after),
  .always-dark :global(.row:focus-visible::after),
  .always-dark :global(.row.lit::after) { transform: scaleX(1); }
  .always-dark :global(.menu.narrowed .row) { opacity: 0.35; }

  /* ---- Scan line and readout, appended by the script -------------------- */

  .always-dark :global(.scan) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--signal);
    opacity: 0;
    pointer-events: none;
  }
  .always-dark :global(.scan.go) {
    animation: scan 1400ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes scan {
    0%   { transform: translateX(0); opacity: 0; }
    8%   { opacity: 1; }
    90%  { opacity: 1; }
    100% { transform: translateX(min(60ch, 62vw)); opacity: 0; }
  }

  .always-dark :global(.readout) {
    margin-top: clamp(28px, 6vh, 64px);
    font-family: var(--font-inst);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--fg3);
    white-space: nowrap;
    min-height: 1.4em;
  }
  .always-dark :global(.readout .cur) {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    vertical-align: -0.15em;
    margin-left: 0.2em;
    background: var(--signal);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---- Signature and credit, at the bottom, on a caption plate ----------- */

  /* The bottom of this screen is snow at desktop widths and shoulder at phone
     widths, and small type on a high-frequency texture is not legible in any
     colour — `difference` was tried and came out as fragments. So the line
     gets a plate: solid black, no border, sized to the text. On sky it is
     invisible; on the mountain it is a caption strip on a print. */
  .always-dark :global(.sig) {
    justify-self: start;
    font-family: var(--font-inst);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg2);
    background: #000;
    padding: 8px 12px;
    margin: -8px -12px;
  }
  .always-dark :global(.credit) { color: var(--fg3); }
  .credit a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  /* Portrait: index margin is dear on a phone; keep it, shrink it. */
  @media (orientation: portrait) and (max-width: 820px) {
    .always-dark :global(.menu) { padding-left: 2em; }
    .always-dark :global(.row) { font-size: clamp(17px, 5.2vw, 22px); }
    .always-dark :global(.level li::before) { left: -2em; }
    .always-dark :global(.readout) { white-space: normal; letter-spacing: 0.14em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .always-dark :global(.scan.go),
    .always-dark :global(.readout .cur) { animation: none; }
    .always-dark :global(.level li::before) { opacity: 1; transition: none; }
  }
</style>

<script>
  /**
   * THE DECODE. Each name is already one span per character (`.chi`, with
   * `--c` as its index) because `OneScreen` prints them that way. Here they
   * arrive as noise — glyphs from a technical set, flipping every ~45 ms — and
   * resolve left to right, a row at a time. The mono face is what makes this
   * possible without the line shaking: every glyph is the same width.
   *
   * Hooked on the class `OneScreen` already toggles: when a level gets `enter`,
   * it decodes. Nothing in `OneScreen` knows this page exists.
   */
  const root = document.querySelector<HTMLElement>('.always-dark');
  const menu = document.querySelector<HTMLElement>('.menu');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && menu) {
    const GLYPHS = '0123456789ABCDEFXZ<>/\\|[]{}=+*#_—·';
    const rnd = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
    const texts = JSON.parse(root.dataset.readout || '{}') as { idle: string[] } & Record<string, string | string[]>;
    const seg = (k: string) => (typeof texts[k] === 'string' ? (texts[k] as string) : '');

    /* Remember every character's real value once; the decode writes over it. */
    for (const el of menu.querySelectorAll<HTMLElement>('.chi')) {
      if (el.dataset.t === undefined) el.dataset.t = el.textContent ?? '';
    }

    const timers = new Set<number>();
    const later = (fn: () => void, ms: number) => {
      const id = window.setTimeout(() => { timers.delete(id); fn(); }, ms);
      timers.add(id);
    };

    /** Scramble one character span, then land it at `at` ms. */
    const decode = (el: HTMLElement, at: number, flip = 45) => {
      const real = el.dataset.t ?? '';
      if (still || real.trim() === '') { el.textContent = real; el.classList.remove('noise'); return; }
      el.classList.add('noise');
      let t = 0;
      const tick = () => {
        if (t >= at) { el.textContent = real; el.classList.remove('noise'); return; }
        el.textContent = rnd();
        t += flip;
        later(tick, flip);
      };
      tick();
    };

    const decodeLevel = (level: HTMLElement) => {
      const rows = Array.from(level.querySelectorAll<HTMLElement>('li'));
      rows.forEach((li, i) => {
        const chars = Array.from(li.querySelectorAll<HTMLElement>('.chi'));
        chars.forEach((el, c) => decode(el, i * 220 + 260 + c * 38));
      });
    };

    /* A pointed-at name flickers once, briefly, before it settles in colour. */
    const flicker = (row: HTMLElement) => {
      if (still) return;
      row.querySelectorAll<HTMLElement>('.chi').forEach((el, c) => decode(el, 90 + c * 12, 30));
    };

    /* The scan: one sweep across the column as the first level decodes. */
    const scan = document.createElement('span');
    scan.className = 'scan';
    scan.setAttribute('aria-hidden', 'true');
    menu.appendChild(scan);

    /* The readout, typed in after the names have landed. */
    const out = document.createElement('p');
    out.className = 'readout';
    out.setAttribute('aria-hidden', 'true');
    const txt = document.createElement('span');
    const cur = document.createElement('span');
    cur.className = 'cur';
    out.append(txt, cur);
    menu.appendChild(out);

    let typing = 0;
    const type = (s: string, speed = 16) => {
      const my = ++typing;
      if (still) { txt.textContent = s; return; }
      /* Retype from where the two strings stop agreeing, so a switch reads as
         an edit rather than a wipe. */
      const cur0 = txt.textContent ?? '';
      let keep = 0;
      while (keep < cur0.length && keep < s.length && cur0[keep] === s[keep]) keep++;
      let n = cur0.length;
      const erase = () => {
        if (my !== typing) return;
        if (n > keep) { n--; txt.textContent = cur0.slice(0, n); later(erase, 9); return; }
        write();
      };
      const write = () => {
        if (my !== typing) return;
        if (n < s.length) { n++; txt.textContent = s.slice(0, n); later(write, speed); }
      };
      erase();
    };

    /* The idle cycle: one line every seven seconds, paused while a name is
       pointed at, resumed from the top when the pointer leaves. */
    let idleAt = 0;
    let cycle = 0;
    let pointing = false;
    const idle = () => {
      window.clearTimeout(cycle);
      if (pointing) return;
      type(texts.idle[idleAt % texts.idle.length], 12);
      idleAt++;
      if (!still) cycle = window.setTimeout(idle, 7000);
    };

    let first = true;
    const onEnter = (level: HTMLElement) => {
      decodeLevel(level);
      if (first) {
        first = false;
        scan.classList.add('go');
        later(idle, 900);
      }
    };

    /* `OneScreen` adds `enter` when a level comes in. Watch for it. */
    const mo = new MutationObserver((muts) => {
      for (const m of muts) {
        const el = m.target as HTMLElement;
        if (el.classList.contains('enter') && !el.dataset.decoded) {
          el.dataset.decoded = '1';
          onEnter(el);
        }
        if (!el.classList.contains('enter')) delete el.dataset.decoded;
      }
    });
    for (const l of menu.querySelectorAll('.level')) mo.observe(l, { attributes: true, attributeFilter: ['class'] });

    /* Pointing: flicker the name, retype the readout for its ridge. */
    menu.addEventListener('pointerover', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.row');
      if (!row) return;
      flicker(row);
      const s = seg(row.dataset.seg ?? '');
      if (s) { pointing = true; window.clearTimeout(cycle); type(s, 12); }
    });
    const back = (e: Event) => {
      const to = (e as PointerEvent).relatedTarget as HTMLElement | null;
      if (to?.closest?.('.row')) return;
      if (!pointing) return;
      pointing = false;
      idleAt = 0;
      idle();
    };
    menu.addEventListener('pointerout', back);
    menu.addEventListener('pointerleave', back);
    menu.addEventListener('focusin', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.row');
      const s = seg(row?.dataset.seg ?? '');
      if (s) { pointing = true; window.clearTimeout(cycle); type(s, 12); }
    });
    menu.addEventListener('focusout', () => { if (pointing) { pointing = false; idleAt = 0; idle(); } });
  }
</script>
