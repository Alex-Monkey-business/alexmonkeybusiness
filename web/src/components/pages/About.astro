---
/**
 * CONTACT, AS AN INSTRUMENT. The page used to be "about" and carried a title
 * and a paragraph; Alex cut both. What people come here for is a way in, so
 * the page is the portrait and four channels — each a row, each a link — in
 * the idiom `/lab/natt` set: black ground, mono, one signal.
 *
 * FOUR WORDS AT REST (4 Sep). The addresses used to stand next to the labels,
 * and two of them said nothing: `@AlexSamnoy` and `in/alexander-samnøy` are
 * the label again, spelled as a URL. So the row is the channel's name, at
 * display size, and the address is what pointing at it reads out — decoded
 * in beside the name, in the signal, the way the front page's readout does.
 * Email and phone are the two anyone wants to copy, and they are still one
 * hover away; on touch there is no hover, and the tap IS the action: mailto
 * opens mail, tel puts the number in the dialler. No brand logos: the type is
 * the iconography here, and a white X or LinkedIn mark is what every other
 * portfolio does.
 *
 * The portrait is the event. A cut-out on a black sweater against a black
 * page, so the figure has no edge to speak of, and it RESOLVES rather than
 * fades — from eight pixels across to sharp, the way the rows decode, with a
 * scan line running down it as it does. Then it stands still. (A periodic
 * slip of two bands was tried and cut: the second time you see it, it is a
 * broken image.)
 */
import { t, type Lang } from '../../i18n';
import { contact } from '../../data/contact';
import '../../styles/instrument.css';
import '../../styles/about.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).about;
const nb = lang === 'nb';

const rows = contact.map((c, i) => ({ ...c, n: String(i + 1).padStart(2, '0'), label: s.channels[c.key] }));
---

<section class="about inst">
  <div class="about-grid">
    <figure class="about-portrait">
      {/* THE GRADE, as a filter the frame wears. Grayscale, then one S-curve:
          the shadows crushed, the mids held back a little, the highlights left
          clean. Neutral — a lavender cast on skin read as a filter, and the
          page's one colour is the signal, not the face. The deepest shadows
          alone lean a hair cold; anything more and it is a tint again. */}
      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <filter id="about-grade" color-interpolation-filters="sRGB">
          <feColorMatrix type="saturate" values="0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0 0.05 0.40 0.74 1.00" />
            <feFuncG type="table" tableValues="0 0.05 0.40 0.74 1.00" />
            <feFuncB type="table" tableValues="0 0.08 0.41 0.74 1.00" />
          </feComponentTransfer>
        </filter>
      </svg>
      <div class="about-frame">
        <img class="about-img" src="/assets/about/alex.png" alt="Alexander Samnøy" width="1024" height="1024" decoding="async" />
        <canvas class="about-px" width="1024" height="1024" aria-hidden="true"></canvas>
        {/* The shadow side. The light in the file comes from the left, so the
            right of the face and the shoulder fall off into the page's black,
            and so does the hem. Painted over the frame, under the grade. */}
        <span class="about-shade" aria-hidden="true"></span>
      </div>
      {/* Outside the frame, so it keeps its colour through the grade. */}
      <span class="about-scan" aria-hidden="true"></span>
    </figure>

    <div class="about-copy">
      <p class="about-eyebrow inst-label"><span data-type>{s.eyebrow}</span></p>

      {/* The channels. Index and name — one line each, the whole line the
          link. The name decodes in on load; the address sits beside it,
          invisible until pointed at, then decodes in. */}
      <ul class="about-rows">
        {rows.map((r) => (
          <li class="about-row" style={`--i:${r.n}`}>
            <a
              href={r.href}
              target={r.external ? '_blank' : undefined}
              rel={r.external ? 'noopener noreferrer' : undefined}
            >
              <span class="inst-idx">{r.n}</span>
              <span class="about-label inst-display" data-decode>{r.label}</span>
              <span class="about-value inst-display">{r.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { decode, typeSelf, scramble, still } from '../../scripts/decode';

  const root = document.querySelector<HTMLElement>('.about');
  if (root) {
    /* Text: the name types; the channel names decode, a row at a time. */
    const eyebrow = root.querySelector<HTMLElement>('.about-eyebrow [data-type]');
    if (eyebrow) typeSelf(eyebrow, { delay: 300, speed: 16 });
    root.querySelectorAll<HTMLElement>('.about-label').forEach((el, i) => {
      decode(el, { delay: 600 + i * 200, perChar: 40 });
    });

    /* Pointing at a row: the name flickers once, and the address decodes in
       beside it. Leaving hides the address again (CSS, on `.on`). Focus does
       the same, so a keyboard reads the same page a pointer does. */
    root.querySelectorAll<HTMLElement>('.about-row').forEach((row) => {
      const a = row.querySelector<HTMLElement>('a');
      const value = row.querySelector<HTMLElement>('.about-value');
      if (!a || !value) return;
      const on = () => {
        row.classList.add('on');
        if (still()) return;
        a.querySelectorAll<HTMLElement>('.about-label .chi').forEach((c, i) => scramble(c, 60 + i * 12, 30));
        decode(value, { delay: -160, perChar: 18, flip: 35 });
      };
      const off = () => row.classList.remove('on');
      a.addEventListener('pointerenter', on);
      a.addEventListener('pointerleave', off);
      a.addEventListener('focus', on);
      a.addEventListener('blur', off);
    });

    /**
     * THE PORTRAIT RESOLVES. A canvas over the photograph draws it at 8 px
     * across, then 12, 18, 28, 44, 72, 120, 200 — nearest-neighbour, so the
     * steps are honest squares — and then gets out of the way. Same idea as
     * the letters: the picture is information arriving.
     */
    const img = root.querySelector<HTMLImageElement>('.about-img');
    const px = root.querySelector<HTMLCanvasElement>('.about-px');
    const scan = root.querySelector<HTMLElement>('.about-scan');
    const frame = root.querySelector<HTMLElement>('.about-frame');
    const g = px?.getContext('2d');
    const STEPS = [8, 12, 18, 28, 44, 72, 120, 200];

    const resolve = (from = 0, stepMs = 115) =>
      new Promise<void>((done) => {
        if (!img || !px || !g || still()) { px?.classList.add('gone'); done(); return; }
        px.classList.remove('gone');
        scan?.classList.remove('go');
        void scan?.offsetWidth;
        scan?.classList.add('go');
        let i = from;
        const off = document.createElement('canvas');
        const og = off.getContext('2d')!;
        const step = () => {
          const n = STEPS[i];
          off.width = n; off.height = n;
          og.clearRect(0, 0, n, n);
          og.drawImage(img, 0, 0, n, n);
          g.imageSmoothingEnabled = false;
          g.clearRect(0, 0, px.width, px.height);
          g.drawImage(off, 0, 0, n, n, 0, 0, px.width, px.height);
          i++;
          if (i < STEPS.length) setTimeout(step, stepMs);
          else setTimeout(() => { px.classList.add('gone'); done(); }, stepMs);
        };
        step();
      });

    const start = () => setTimeout(() => resolve(), 200);
    if (img?.complete) start(); else img?.addEventListener('load', start, { once: true });

    /* Pointing at it re-samples it, fast, from a coarser step. */
    let busy = false;
    frame?.addEventListener('pointerenter', async () => {
      if (busy || still()) return;
      busy = true;
      await resolve(2, 60);
      busy = false;
    });

  }
</script>
