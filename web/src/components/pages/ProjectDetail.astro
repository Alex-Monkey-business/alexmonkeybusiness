---
import { t, path, type Lang } from '../../i18n';
import type { Project } from '../../data/projects';

interface Props { lang: Lang; project: Project }
const { lang, project } = Astro.props;
const s = t(lang).detail;
---

<section class="project-detail">
  <a class="back" href={path(lang, '/#projects')}>{s.back}</a>
  <h1 class="detail-title" style={`--vt: vt-${project.slug}`}>
    {project.title}
    {project.titleEm && (
      <>
        {' '}
        <em>{project.titleEm}</em>
      </>
    )}
  </h1>
  <p class="detail-meta">
    <span>{project.year}</span>
    {project.status === 'wip' && <span class="wip" set:html={s.wip.replace(' ', '&nbsp;')} />}
  </p>
  <p class="detail-placeholder">{s.comingSoon}</p>
</section>

<style>
  .project-detail {
    max-width: 760px;
    margin: 0 auto;
    padding: 24vh var(--s-8) 12vh;
  }
  @media (max-width: 640px) {
    .project-detail {
      padding: 20vh var(--s-4) 8vh;
    }
  }
  .back {
    font-family: var(--font-ui);
    font-size: var(--t-16);
    font-weight: 500;
    color: var(--fg2);
    text-decoration: none;
    letter-spacing: 0;
    /* Same 24px target floor as the case page's back link */
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .back:hover {
    color: var(--fg1);
    text-decoration: underline;
  }
  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(52px, 11.5vw, 120px);
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-tight);
    font-weight: 400;
    margin: var(--s-8) 0 var(--s-5);
    color: var(--fg1);
    view-transition-name: var(--vt);
  }
  @media (prefers-reduced-motion: reduce) {
    .detail-title { view-transition-name: none; }
  }
  .detail-title em {
    font-style: italic;
    color: var(--em-color);
  }
  .detail-meta {
    font-family: var(--font-ui);
    font-size: var(--t-14);
    color: var(--fog-ink);
    letter-spacing: 0;
    text-transform: none;
    display: flex;
    gap: var(--s-3);
    align-items: center;
    margin: 0 0 var(--s-16);
  }
  :global(html.dark) .detail-meta { color: var(--fg3); }
  /* "In progress" — the same forest pill the landing cards use. Was styled
     with --mustard/--pale/--yellow, which no longer exist in the palette. */
  .detail-meta .wip {
    font-family: var(--font-ui);
    font-size: var(--t-14);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    color: var(--lumen-cream);
    background: var(--forest-ink);
    padding: 8px 16px;
    border-radius: var(--r-pill);
  }
  .detail-placeholder {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 32px);
    color: var(--fg2);
    font-style: italic;
  }
</style>
