---
import { t, path, type Lang } from '../../i18n';
import { projects } from '../../data/projects';
import AboutCard from '../AboutCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---


<>
  {/* The hero says a name and nothing else. What used to be a lede and two
      buttons is now the squiggle writing itself — the page has to earn its
      first sentence, and the first sentence is on a card further down. */}
  <section class="hero band">
    <h1 class="display">
      <span class="line dim">Alex</span>
      <span class="line">
        <span class="squiggle"
          >Monkey business<span class="period">.</span><svg
            viewBox="0 0 300 12"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path d="M2 8C40 2 58 11 98 5.5S158 2 198 7.5S262 10.5 298 4" /></svg
          ></span>
      </span>
    </h1>
  </section>

  {/* Sits on the canvas, above the chamber, so «Prosjekter» still opens onto
      projects only. */}
  <section class="intro band">
    <AboutCard lang={lang} />
  </section>

  <section class="work band" id="projects">
    <div class="chamber">
      {/* A label, not a headline — the cards are the display type in here.
          It also gives the page a heading between the name and the card
          titles, which drop to h3 so the levels run h1 → h2 → h3. */}
      <h2 class="work-label">{s.work.label}</h2>

      <ul class="grid">
        {projects.map((p, i) => {
          const href = p.url ?? path(lang, `/projects/${p.slug}`);
          const external = Boolean(p.url);
          return (
            <li style={`--i:${i}`}>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="card"
              >
                <div class="card-top">
                  <span class="badge-square">{String(i + 1).padStart(2, '0')}</span>
                  {p.status === 'wip' && <span class="badge-teal">{s.card.inProgress}</span>}
                  <span class="card-year">{p.year}</span>
                </div>

                {/* The name morphs into the detail page's title on navigation.
                    Set through a custom property so reduced motion can drop it —
                    an inline view-transition-name would outrank any media query. */}
                <h3 class="card-title" style={`--vt: vt-${p.slug}`}>
                  {p.title}
                  {p.titleEm && <em>{' '}{p.titleEm}</em>}
                </h3>

                {s.projects[p.slug] && <p class="card-sub">{s.projects[p.slug]}</p>}

                <span class="card-cta">
                  <span class="sr-only">{external ? s.card.visitSite : s.card.readCase}</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"
                    ><path
                      d={external ? 'M6 10.5L11 5.5M11 5.5H6.5M11 5.5V10' : 'M3 8h9M8.5 4l4 4-4 4'}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    /></svg
                  >
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</>

<script>
  /* Cards rise in as they arrive. The hidden state lives in CSS behind
     `html.js`, which is set before first paint, so no-JS shows everything and
     nothing flashes in and back out. */
  const items = Array.from(document.querySelectorAll<HTMLElement>('.grid > li'));
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (still || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ===== hero — one screen, one name =====
     Height is capped as well as floored. Pinned to a bare 100svh, a tall
     display stretched the hero into a void and pushed the chamber off the
     screen entirely. Capped, the hero is still the whole view on a laptop or
     a phone, and on anything taller the cards start to show — which is the
     invitation, and the reason there is no scroll cue to make it. */
  .hero {
    min-height: min(100svh, 880px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(88px, 12vh, 168px);
    padding-bottom: var(--s-12);
  }

  .display {
    font-family: var(--font-display);
    font-size: clamp(52px, 11.5vw, 120px);
    font-weight: 400;
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-tight);
    margin: 0;
    color: var(--fg1);
  }
  .display .line { display: block; }
  /* Two-tone cadence: fog opens, ink lands */
  .display .dim { color: var(--fg3); }
  /* A pale accent dot is invisible on cream — em-color reads in both themes */
  .display .period { color: var(--em-color); }

  /* Name arrives a line at a time, then the squiggle writes itself under it. */
  .display .line {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-line-in 900ms var(--ease-out) forwards;
  }
  .display .line:nth-child(1) { animation-delay: 100ms; }
  .display .line:nth-child(2) { animation-delay: 240ms; }

  @keyframes hero-line-in {
    to { opacity: 1; transform: none; }
  }

  /* Wiped in left to right rather than drawn with stroke-dashoffset: the path
     carries vector-effect: non-scaling-stroke and a stretched viewBox, and the
     dash lengths those two produce have nothing to do with the line you see.
     A clip has no such argument with the geometry. */
  .hero .squiggle svg {
    clip-path: inset(0 100% 0 0);
    animation: squiggle-draw 1000ms var(--ease-out) 620ms forwards;
  }
  @keyframes squiggle-draw {
    to { clip-path: inset(0 -2% 0 0); }
  }

  /* The gap under the hero is already generous; this only needs to clear the
     chamber below it.

     The band's own width fix lives in landing.css. */
  .intro { padding-bottom: var(--s-10); }

  /* ===== work chamber ===== */
  .work {
    padding-bottom: var(--s-8);
  }

  /* Fog, not cream, and stated as a plain colour rather than a theme token:
     the chamber stays velvet in both themes, so a token that flips would
     invert this against a background that never does. 4.9:1 on the chamber. */
  .work-label {
    margin: 0 0 var(--s-10);
    font-family: var(--font-ui);
    font-size: var(--t-14);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fog);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  /* The one ember mark on the page. It was originally the answer to a dot
     falling in the hero; that dot is gone, and the mark stays on its own
     merit — without it the label floats loose in the corner. */
  .work-label::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--ember-glow);
    flex: none;
  }

  /* ===== project cards ===== */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
  }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
  }

  :global(html.js) .grid > li {
    opacity: 0;
    transform: translateY(22px);
  }
  :global(html.js) .grid > li.in {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms var(--ease-out),
      transform 700ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    background: var(--lumen-cream);
    color: var(--vast-ink);
    border: var(--border-w) solid var(--vast-ink);
    border-radius: var(--r-lg);
    padding: var(--s-8);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out);
  }
  /* No shadow, no lift — the surface itself turns lavender */
  .card:hover { background: var(--lavender); }
  @media (max-width: 640px) {
    .card { padding: var(--s-5); }
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
  }
  .card-year {
    margin-left: auto;
    font-size: var(--t-14);
    color: var(--fog-ink);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 4.2vw, 48px);
    line-height: var(--lh-snug);
    letter-spacing: -0.02em;
    margin: 0;
    view-transition-name: var(--vt);
  }
  .card-title em {
    font-style: italic;
    color: var(--forest-ink);
  }

  .card-sub {
    margin: 0;
    font-size: var(--t-16);
    line-height: var(--lh-normal);
    color: var(--charcoal);
    max-width: 34ch;
  }

  /* The label is gone; the arrow is the whole invitation. A bordered disc
     rather than a bare glyph, because 2px ink is the system's signature and
     an 18px arrow alone reads as debris at the foot of a card this size. */
  .card-cta {
    /* auto pushes the disc to the floor of the card; spacing above it must be
       margin, since padding would inflate the circle instead of moving it */
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: var(--border-w) solid var(--vast-ink);
    border-radius: var(--r-pill);
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  .card-cta svg {
    width: 18px;
    height: 18px;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .card:hover .card-cta {
    background: var(--vast-ink);
    color: var(--lumen-cream);
  }
  .card:hover .card-cta svg { transform: translateX(2px); }

  @media (prefers-reduced-motion: reduce) {
    .display .line,
    .hero .squiggle svg {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      clip-path: none !important;
    }
    :global(html.js) .grid > li {
      opacity: 1;
      transform: none;
    }
    .card,
    .card-cta,
    .card-cta svg { transition: none; }
    .card:hover .card-cta svg { transform: none; }
    /* An element that morphs across pages is movement — drop the pairing and
       the navigation falls back to the plain cross-fade. */
    .card-title { view-transition-name: none; }
  }
</style>
