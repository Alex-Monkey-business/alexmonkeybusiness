---
import { t, path, type Lang } from '../../i18n';
import { projects } from '../../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---


<>
  <section class="hero band">
    <h1 class="display">
      <span class="line dim">Alex</span>
      <span class="line">
        <span class="squiggle"
          >Monkey business<span class="period">.</span><svg
            viewBox="0 0 300 12"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path d="M2 8C40 2 58 11 98 5.5S158 2 198 7.5S262 10.5 298 4" /></svg
          ></span>
      </span>
    </h1>

    <p class="lede">
      <span>{s.hero.lede1}</span>
      <span>{s.hero.lede2}</span>
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#projects">
        {s.hero.seeWork}
        <svg viewBox="0 0 16 16" aria-hidden="true" class="icon-arrow"
          ><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg
        >
      </a>
      <a class="btn btn-secondary" href="mailto:alexander.samnoy@gmail.com">{s.hero.getInTouch}</a>
    </div>
  </section>

  <section class="work band" id="projects">
    <div class="chamber">
      <header class="work-head">
        <span class="badge-outline">{s.work.count(projects.length)}</span>
        <h2 class="work-title">{s.work.titleA}<br /><em>{s.work.titleEm}</em>.</h2>
      </header>

      <ul class="grid">
        {projects.map((p, i) => {
          const href = p.url ?? path(lang, `/projects/${p.slug}`);
          const external = Boolean(p.url);
          return (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="card"
              >
                <div class="card-top">
                  <span class="badge-square">{String(i + 1).padStart(2, '0')}</span>
                  {p.status === 'wip' && <span class="badge-teal">{s.card.inProgress}</span>}
                  <span class="card-year">{p.year}</span>
                </div>

                <h3 class="card-title">
                  {p.title}
                  {p.titleEm && <em>{' '}{p.titleEm}</em>}
                </h3>

                {s.projects[p.slug] && <p class="card-sub">{s.projects[p.slug]}</p>}

                <span class="card-cta">
                  {external ? s.card.visitSite : s.card.readCase}
                  <svg viewBox="0 0 16 16" aria-hidden="true"
                    ><path
                      d={external ? 'M6 10.5L11 5.5M11 5.5H6.5M11 5.5V10' : 'M3 8h9M8.5 4l4 4-4 4'}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    /></svg
                  >
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</>

<style>
  /* ===== hero ===== */
  .hero {
    padding-top: 24vh;
    padding-bottom: 12vh;
  }
  @media (max-width: 640px) {
    .hero { padding-top: 20vh; padding-bottom: 8vh; }
  }

  .display {
    font-family: var(--font-display);
    font-size: clamp(52px, 11.5vw, 120px);
    font-weight: 400;
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-tight);
    margin: 0;
    color: var(--fg1);
  }
  .display .line { display: block; }
  /* Two-tone cadence: fog opens, ink lands */
  .display .dim { color: var(--fg3); }
  /* A pale accent dot is invisible on cream — em-color reads in both themes */
  .display .period { color: var(--em-color); }

  /* Two short lines, each on its own — the second is the punchline and only
     lands if it isn't wrapped into the first. 46ch holds both without breaking. */
  .lede {
    margin: var(--s-10) 0 0;
    max-width: 46ch;
    font-family: var(--font-ui);
    font-size: var(--t-18);
    font-weight: 400;
    line-height: var(--lh-normal);
    color: var(--fg2);
  }
  .lede span { display: block; }

  .hero-actions {
    margin-top: var(--s-10);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .icon-arrow { width: 16px; height: 16px; }

  /* ===== work chamber ===== */
  .work {
    padding-bottom: var(--s-8);
  }

  .work-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
    margin-bottom: var(--s-16);
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 6vw, 64px);
    line-height: var(--lh-snug);
    letter-spacing: var(--tr-snug);
    margin: 0;
    color: var(--lumen-cream);
  }
  .work-title em {
    font-style: italic;
    color: var(--lavender);
  }

  /* ===== project cards ===== */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
  }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
  }

  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    background: var(--lumen-cream);
    color: var(--vast-ink);
    border: var(--border-w) solid var(--vast-ink);
    border-radius: var(--r-lg);
    padding: var(--s-8);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out);
  }
  /* No shadow, no lift — the surface itself turns lavender */
  .card:hover { background: var(--lavender); }
  @media (max-width: 640px) {
    .card { padding: var(--s-5); }
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
  }
  .card-year {
    margin-left: auto;
    font-size: var(--t-14);
    color: var(--fog-ink);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 4.2vw, 48px);
    line-height: var(--lh-snug);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .card-title em {
    font-style: italic;
    color: var(--forest-ink);
  }

  .card-sub {
    margin: 0;
    font-size: var(--t-16);
    line-height: var(--lh-normal);
    color: var(--charcoal);
    max-width: 34ch;
  }

  .card-cta {
    margin-top: auto;
    padding-top: var(--s-5);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-16);
    font-weight: 500;
  }
  .card-cta svg {
    width: 16px;
    height: 16px;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .card:hover .card-cta svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .card, .card-cta svg { transition: none; }
    .card:hover .card-cta svg { transform: none; }
  }
</style>
