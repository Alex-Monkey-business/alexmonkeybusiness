---
import { t, path, type Lang } from '../../i18n';
import '../../styles/instrument.css';
import '../../styles/halsen.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).case;

/* ONE PHONE, FIVE SCREENS (19 Oct 2026). The chapters used to carry a
   recording each, and the page had the Motion film on top as well: the same
   app told twice. Now one phone holds still beside the text and changes
   screen as each chapter reaches the middle — the screens are the film's
   own, cut out of it (public/assets/halsen/film, invented players). The
   training week and the drill bank have no screen in the film, so they join
   the list underneath. */
const clip = (n: string) => ({ mp4: `/assets/halsen/film/${n}.mp4`, webm: `/assets/halsen/film/${n}.webm`, poster: `/assets/halsen/film/${n}-poster.jpg` });
const chapters = [
  { ...s.features[0], ...clip('hjem') },
  { ...s.features[1], ...clip('kamp') },
  { ...s.features[3], ...clip('lan') },
  { ...s.split, ...clip('delinn') },
  { ...s.features[2], ...clip('stat') },
].map((c, i) => ({ ...c, n: String(i + 1).padStart(2, '0') }));
const lower = (x: string) => x.charAt(0).toLowerCase() + x.slice(1);
const extra = [s.features[4], s.features[5]].map((f) => ({ em: f.h.replace(/\.$/, ''), rest: ' — ' + lower(f.p) }));
const hood = [...extra, ...s.hood];
---

<div class="case inst">
  {/* The arrow in the string is Wispr's; the instrument writes it as `<`. */}
  <a href={path(lang, '/#projects')} class="case-back">{s.back.replace('←', '<')}</a>

  <section class="case-hero">
    <p class="case-eyebrow inst-label"><span class="inst-idx">00</span> <span data-type>{s.stack[0].toUpperCase()}</span></p>
    {/* Pairs with the landing card of the same slug — the name travels
        between the two pages instead of the page blinking. Two decode
        targets, because the second half carries the signal. */}
    <h1 class="case-title inst-display" style="--vt: vt-halsen-g15"><span data-decode>Bench</span><span class="em" data-decode>Boss</span></h1>
    <p class="case-lede inst-body">{s.lede}</p>
  </section>

  <section class="case-story">
    <div class="story-stage" aria-hidden="true">
      <div class="story-phone">
        {chapters.map((c, i) => (
          <video class={`story-v${i === 0 ? ' on' : ''}`} data-i={i} poster={c.poster} muted loop playsinline preload={i === 0 ? 'metadata' : 'none'}>
            <source src={c.mp4} type="video/mp4" />
            <source src={c.webm} type="video/webm" />
          </video>
        ))}
      </div>
    </div>
    <div class="story-text">
      {chapters.map((c, i) => (
        <div class="story-ch" data-i={i}>
          <span class="ft-num inst-idx">{c.n}</span>
          <h2 class="ft-h inst-display" data-decode>{c.h}</h2>
          <p class="ft-p inst-body">{c.p}</p>
        </div>
      ))}
    </div>
  </section>

  {/* The tail of the same count the features started: 09-12 are the things
      that run underneath and have no screen to record. The surface going
      velvet says that; a heading would only repeat it. */}
  <section class="case-list">
    <ul>
      {hood.map((h, i) => (
        <li style={`--i:${i}`}>
          <span class="n inst-idx">{String(chapters.length + i + 1).padStart(2, '0')}</span>
          <span class="text">{h.pre}<em>{h.em}</em>{h.rest}</span>
        </li>
      ))}
    </ul>
  </section>

  <div class="case-stack inst-label">
    <span class="live">{s.stack[0]}</span>
    <span class="sep">·</span>
    <span>{s.stack[1]}</span>
    <span class="sep">·</span>
    <span>{s.stack[2]}</span>
  </div>
</div>

<script>
  import { decode, typeSelf, onEnter } from '../../scripts/decode';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The hero: eyebrow types, then the name decodes — the two halves together.
  const eyebrow = document.querySelector<HTMLElement>('.case-eyebrow [data-type]');
  if (eyebrow) typeSelf(eyebrow, { delay: 200, speed: 16 });
  document.querySelectorAll<HTMLElement>('.case-title [data-decode]').forEach((el) => decode(el, { delay: 500, perChar: 70 }));

  // list rows arrive as they scroll in
  onEnter(document.querySelectorAll('.case-list li'), (el) => el.classList.add('is-in'), 0.18);

  /* The story: the chapter whose text crosses the line is the one the phone
     shows. Desktop reads at the middle; a phone, where the device sits at the
     top, reads low on the screen, under it. Only the shown screen plays. */
  const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('.story-v'));
  const chs = Array.from(document.querySelectorAll<HTMLElement>('.story-ch'));
  let cur = -1;
  const show = (i: number) => {
    if (i === cur) return;
    cur = i;
    vids.forEach((v, j) => {
      v.classList.toggle('on', j === i);
      if (j === i) { v.preload = 'auto'; if (!reduce) { v.currentTime = 0; v.play().catch(() => {}); } }
      else v.pause();
    });
    chs.forEach((c, j) => c.classList.toggle('on', j === i));
    const h = chs[i]?.querySelector<HTMLElement>('[data-decode]');
    if (h && !h.dataset.done) { h.dataset.done = '1'; decode(h, { delay: 0, perChar: 10, flip: 35 }); }
  };
  const narrow = matchMedia('(max-width: 860px)');
  let io: IntersectionObserver | null = null;
  const watch = () => {
    io?.disconnect();
    io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.i)); });
    }, { rootMargin: narrow.matches ? '-78% 0px -20% 0px' : '-50% 0px -50% 0px' });
    chs.forEach((c) => io!.observe(c));
  };
  watch();
  narrow.addEventListener('change', watch);
  // Off screen, nothing plays.
  const stage = document.querySelector('.story-stage');
  if (stage) new IntersectionObserver(([e]) => {
    const v = vids[cur];
    if (!v) return;
    if (e.isIntersecting && !reduce) v.play().catch(() => {}); else v.pause();
  }).observe(stage);
</script>
