---
import PhoneVideo from '../halsen/PhoneVideo.astro';
import { t, path, type Lang } from '../../i18n';
import '../../styles/instrument.css';
import '../../styles/halsen.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).case;

/* Recordings are made against BenchBoss in demo mode — invented players, no
   database. The real app runs a grassroots team of children, and their names
   have no business on a public portfolio.

   Media and pacing live here; the prose lives in src/i18n/strings.ts, paired to
   these by index. */
const media = [
  { src: '/assets/halsen/hjem.webm',         poster: '/assets/halsen/hjem-poster.jpg' },
  // The take opens with eight taps to build the lineup, which reads as a
  // bottom sheet flapping. Start the loop on the running clock instead.
  { src: '/assets/halsen/matchmode.webm',    poster: '/assets/halsen/matchmode-poster.jpg', start: 12 },
  { src: '/assets/halsen/filter.webm',       poster: '/assets/halsen/filter-poster.jpg' },
  { src: '/assets/halsen/stats-teams.webm',  poster: '/assets/halsen/stats-teams-poster.jpg' },
  { src: '/assets/halsen/loan-suggest.webm', poster: '/assets/halsen/loan-suggest-poster.jpg' },
  // Håndbok og treningsplan var to seksjoner. Uka bærer begge: øvelsesbanken
  // og håndboka er inngangene nederst, og tida per øvelse er poenget.
  { src: '/assets/halsen/trening.webm',      poster: '/assets/halsen/trening-poster.jpg' },
  { src: '/assets/halsen/cup.webm',          poster: '/assets/halsen/cup-poster.jpg' },
];

const features = s.features.map((f, i) => ({
  ...f,
  ...media[i],
  n: String(i + 1).padStart(2, '0'),
}));
---

<div class="case inst">
  {/* The arrow in the string is Wispr's; the instrument writes it as `<`. */}
  <a href={path(lang, '/#projects')} class="case-back">{s.back.replace('←', '<')}</a>

  <section class="case-hero">
    <p class="case-eyebrow inst-label"><span class="inst-idx">00</span> <span data-type>{s.stack[0].toUpperCase()}</span></p>
    {/* Pairs with the landing card of the same slug — the name travels
        between the two pages instead of the page blinking. Two decode
        targets, because the second half carries the signal. */}
    <h1 class="case-title inst-display" style="--vt: vt-halsen-g15"><span data-decode>Bench</span><span class="em" data-decode>Boss</span></h1>
    <p class="case-lede inst-body">{s.lede}</p>
  </section>

  {features.map((f, i) => (
    <section class={`case-feature${i % 2 === 1 ? ' flipped' : ''}`}>
      <div class="case-feature-copy">
        <span class="ft-num inst-idx">{f.n}</span>
        <h2 class="ft-h inst-display" data-decode>{f.h}</h2>
        <p class="ft-p inst-body">{f.p}</p>
      </div>
      <div class="case-feature-stage">
        <PhoneVideo src={f.src} poster={f.poster} start={f.start ?? 0.5} />
      </div>
    </section>
  ))}

  {/* The tail of the same count the features started: 09-12 are the things
      that run underneath and have no screen to record. The surface going
      velvet says that; a heading would only repeat it. */}
  <section class="case-list">
    <ul>
      {s.hood.map((h, i) => (
        <li style={`--i:${i}`}>
          <span class="n inst-idx">{String(features.length + i + 1).padStart(2, '0')}</span>
          <span class="text">{h.pre}<em>{h.em}</em>{h.rest}</span>
        </li>
      ))}
    </ul>
  </section>

  <div class="case-stack inst-label">
    <span class="live">{s.stack[0]}</span>
    <span class="sep">·</span>
    <span>{s.stack[1]}</span>
    <span class="sep">·</span>
    <span>{s.stack[2]}</span>
  </div>
</div>

<script>
  import { decode, typeSelf, onEnter } from '../../scripts/decode';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The hero: eyebrow types, then the name decodes — the two halves together.
  const eyebrow = document.querySelector<HTMLElement>('.case-eyebrow [data-type]');
  if (eyebrow) typeSelf(eyebrow, { delay: 200, speed: 16 });
  document.querySelectorAll<HTMLElement>('.case-title [data-decode]').forEach((el) => decode(el, { delay: 500, perChar: 70 }));

  // reveal feature sections + list rows on scroll; a heading decodes as its
  // section arrives
  onEnter(document.querySelectorAll('.case-feature, .case-list li'), (el) => {
    el.classList.add('is-in');
    const h = el.querySelector<HTMLElement>('[data-decode]');
    if (h) decode(h, { delay: 80, perChar: 10, flip: 35 });
  }, 0.18);

  // play each real-app recording only while on screen; loop past the first paint
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.phone-video'));
  videos.forEach((v) => {
    const start = Number(v.dataset.start ?? '0');
    const toStart = () => { if (start && v.currentTime < start) v.currentTime = start; };
    v.addEventListener('loadedmetadata', toStart);
    v.addEventListener('timeupdate', () => {
      if (v.duration && v.currentTime >= v.duration - 0.25) v.currentTime = start || 0;
    });
  });

  if (!reduce) {
    const vidObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (v.currentTime < Number(v.dataset.start ?? '0')) v.currentTime = Number(v.dataset.start ?? '0');
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      },
      { threshold: 0.35 }
    );
    videos.forEach((v) => vidObs.observe(v));
  }
</script>
