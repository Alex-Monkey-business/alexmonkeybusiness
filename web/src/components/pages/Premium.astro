---
/**
 * THE CLIMB AS A PRINT — lab variant of the front page (7 Nov 2026).
 *
 * The same one scroll up the Hörnligrat as `Climb`, with less on it: the
 * mountain (see `Relieff.astro`), a light going up the ridge, the height.
 * At the top, the person: the name set large and the ways to reach him.
 * Past the top the camera cranes up and the mountain becomes its own map,
 * and the name stays on it.
 */
import Relieff from '../Relieff.astro';
import { contact } from '../../data/contact';
import { t, type Lang } from '../../i18n';
import { swisstopoCredit as credit, copernicusCredit as cop } from '../../data/photoCredit';
import '../../styles/instrument.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---

<div class="always-dark inst pr">
  <Relieff lang={lang} />
  <h1 class="sr-only">Alex Monkey Business</h1>

  <section class="pr-wp pr-start" data-wp>
    <span class="pr-cue" aria-hidden="true"></span>
  </section>
  <section class="pr-wp" data-wp></section>
  <section class="pr-wp" data-wp></section>
  <section class="pr-wp" data-wp></section>
  <section class="pr-wp pr-summit" data-wp></section>
  <section class="pr-wp" data-wp></section>
  <section class="pr-wp" data-wp></section>
  <section class="pr-wp pr-end" data-wp></section>

  <section class="pr-who" aria-labelledby="pr-name">
    <p class="pr-kicker">alex monkey business</p>
    <h2 class="pr-name" id="pr-name">Alexander Samnøy</h2>
    <ul class="pr-ch">
      {contact.map((c, i) => (
        <li style={`--i: ${i}`}>
          <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
            <span class="pr-k">{s.about.channels[c.key]}</span>
            <span class="pr-v">{c.value}</span>
            <span class="pr-go" aria-hidden="true">{c.external ? '↗' : '→'}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="pr-credit">
      {credit.kind?.[lang]}: <a href={credit.source} target="_blank" rel="noopener noreferrer">{credit.author}</a> · <a href={credit.licenceUrl} target="_blank" rel="noopener noreferrer">{credit.licence}</a> · <a href={cop.source} target="_blank" rel="noopener noreferrer">Copernicus</a>
    </p>
  </section>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif&display=swap');

  .pr {
    position: relative;
    background: #0b0b0c;
    color: #f2efe8;
    font-family: var(--font-inst);
  }
  :global(body:has(.pr) footer) { display: none; }

  /* Length only: each section is one shot of the flight. */
  .pr-wp { position: relative; min-height: 72svh; pointer-events: none; }
  .pr-start { min-height: 100svh; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 64px; }
  .pr-summit { min-height: 100svh; }
  .pr-end { min-height: 100svh; }

  .pr-cue {
    width: 1px;
    height: 48px;
    background: rgba(242, 239, 232, 0.4);
    transform-origin: top;
    animation: pr-cue 2.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    opacity: calc(1 - var(--rl-top, 0));
  }
  @keyframes pr-cue {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* The person, at the top. Bottom left, set like the last page of a book:
     a large name, four quiet rows, the credit the data asks for. */
  .pr-who {
    position: fixed;
    left: clamp(20px, 5vw, 72px);
    bottom: clamp(24px, 6vh, 64px);
    z-index: 2;
    width: min(460px, calc(100vw - 40px));
    opacity: var(--rl-top, 0);
    pointer-events: none;
    visibility: hidden;
  }
  :global(.relieff.at-top) ~ .pr-who { pointer-events: auto; visibility: visible; }
  .pr-kicker {
    margin: 0 0 14px;
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.22em;
    color: rgba(242, 239, 232, 0.5);
    translate: 0 calc((1 - var(--rl-top, 0)) * 10px);
  }
  .pr-name {
    margin: 0;
    font-family: 'Instrument Serif', 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(46px, 6.2vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.015em;
    color: #f5f2ea;
    translate: 0 calc((1 - var(--rl-top, 0)) * 18px);
  }
  .pr-ch {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid rgba(242, 239, 232, 0.12);
  }
  .pr-ch li {
    border-bottom: 1px solid rgba(242, 239, 232, 0.12);
    translate: 0 calc((1 - var(--rl-top, 0)) * (14px + var(--i) * 8px));
  }
  .pr-ch a {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 14px;
    padding: 13px 0;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: #f2efe8;
    text-decoration: none;
  }
  .pr-k { font-size: 10px; letter-spacing: 0.18em; color: rgba(242, 239, 232, 0.42); }
  .pr-v { overflow-wrap: anywhere; transition: color 200ms linear; }
  .pr-go { color: rgba(242, 239, 232, 0.42); transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1), color 200ms linear; }
  .pr-ch a:hover .pr-v, .pr-ch a:focus-visible .pr-v { color: #ffe8c2; }
  .pr-ch a:hover .pr-go, .pr-ch a:focus-visible .pr-go { color: #ffe8c2; transform: translate(2px, -2px); }
  .pr-ch a[href^='mailto']:hover .pr-go, .pr-ch a[href^='tel']:hover .pr-go { transform: translateX(3px); }
  .pr-ch a:focus-visible { outline: none; }
  .pr-credit {
    margin: 18px 0 0;
    font-size: 9px;
    line-height: 1.7;
    letter-spacing: 0.06em;
    color: rgba(242, 239, 232, 0.32);
  }
  .pr-credit a { color: inherit; text-decoration: none; }
  .pr-credit a:hover, .pr-credit a:focus-visible { color: #f2efe8; outline: none; }

  @media (max-width: 520px) {
    .pr-ch a { grid-template-columns: minmax(0, 1fr) auto; }
    .pr-k { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-cue { animation: none; }
  }
</style>
