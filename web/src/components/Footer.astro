---
import { t, path, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="band">
    <div class="footer-inner">
      <p class="footer-word">Alex<br /><em>Monkey business</em>.</p>
      <ul class="footer-links">
        <li><a href="mailto:alexander.samnoy@gmail.com">{s.footer.email}</a></li>
        <li><a href="https://github.com/Alex-Monkey-business" target="_blank" rel="noopener noreferrer">{s.footer.github}</a></li>
        <li><a href={path(lang, '/about')}>{s.footer.about}</a></li>
      </ul>
    </div>
    <p class="footer-meta">Alex Samnøy · {year}</p>
  </div>
</footer>
