---
/**
 * The contour rings as a full-bleed background, drawn once and then left to
 * drift. Built from `assets/terrain/*.svg` (tools/make-contours.mjs), which
 * ships one <path> per elevation with `data-m` on it.
 *
 * Two things are deliberate:
 *
 * 1. The rings are re-emitted here rather than injected as raw markup, because
 *    this component needs `pathLength="1"` on every path and needs the source
 *    file's `vector-effect="non-scaling-stroke"` GONE. A dash animation and
 *    non-scaling-stroke cannot coexist: the dash pattern is then measured in
 *    device space while pathLength normalises user space, and the line draws
 *    in disconnected pieces. Same trap as the squiggle.
 * 2. The drawing is a SQUARE box, sized in viewport units and bled off the
 *    right edge — not the viewport itself. Fitted to a wide viewport it goes
 *    small and boxy; sliced to one it zooms past the point where concentric
 *    rings still read as a mountain and they turn into cracks. A square keeps
 *    the aspect the data was sampled at and lets the scale be a design choice.
 * 3. A radial mask dissolves the edges. The lowest ring runs along the DEM
 *    tile boundary — real data, but it draws a rectangle — and the mask is
 *    what turns that hard frame back into terrain running off the page.
 */
import a from '../assets/terrain/tignes-a.svg?raw';
import b from '../assets/terrain/tignes-b.svg?raw';
import c from '../assets/terrain/tignes-c.svg?raw';

interface Props {
  /** Which density from the contour tool: a (sparse), b, or c (250 m). */
  density?: 'a' | 'b' | 'c';
}

const { density = 'a' } = Astro.props;
const raw = { a, b, c }[density];

const rings = [...raw.matchAll(/data-m="(\d+)"[^>]*?\sd="([^"]+)"/g)].map((m, i) => ({
  m: Number(m[1]),
  d: m[2],
  i,
}));
---

<svg
  class="terrain"
  viewBox="0 0 512 512"
  preserveAspectRatio="xMidYMid meet"
  fill="none"
  aria-hidden="true"
>
  {rings.map((r) => (
    <path class="ring" data-m={r.m} style={`--i:${r.i}`} pathLength="1" d={r.d} />
  ))}
</svg>

<style>
  .terrain {
    position: fixed;
    top: 50%;
    right: clamp(-360px, -12vw, -80px);
    width: clamp(680px, 116vh, 1480px);
    height: clamp(680px, 116vh, 1480px);
    translate: 0 -50%;
    z-index: 0;
    pointer-events: none;
    color: var(--fg1);
    -webkit-mask-image: radial-gradient(closest-side at 50% 50%, #000 42%, transparent 92%);
    mask-image: radial-gradient(closest-side at 50% 50%, #000 42%, transparent 92%);
  }

  .ring {
    stroke: currentColor;
    /* User units, not non-scaling — see the note above. The 512 viewBox is
       fitted to viewport height, so the scale factor (and therefore the
       rendered width) changes with the breakpoint and has to be set per
       breakpoint to stay a hairline. */
    stroke-width: 0.55;
    stroke-linejoin: round;
    opacity: 0.22;
    /* The draw. pathLength="1" makes the dash pattern scale-independent. */
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      stroke var(--dur-slow) var(--ease-out);
  }
  :global(html.dark) .ring { opacity: 0.3; }

  /* Drawn in from the valley floor up, one ring at a time, then left to
     breathe. Rings drift at different speeds, which is what makes a flat
     drawing read as depth. */
  :global(html.js) .terrain.in .ring {
    animation:
      draw 2600ms var(--ease-out) forwards,
      drift calc(64s + var(--i) * 15s) ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 150ms), calc(2600ms + var(--i) * 150ms);
  }
  :global(html:not(.js)) .ring { stroke-dashoffset: 0; }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes drift {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(calc(var(--i) * -1.1px), calc(var(--i) * -0.7px), 0); }
  }

  /* Hover on a link picks its elevation out of the stack. The rest recede
     rather than disappear — the mountain has to stay a mountain. */
  .terrain.dim .ring { opacity: 0.09; }
  :global(html.dark) .terrain.dim .ring { opacity: 0.1; }
  .terrain .ring.hot,
  :global(html.dark) .terrain .ring.hot {
    opacity: 1;
    stroke: var(--hot);
  }

  /* The box shrinks with the viewport, so the scale factor — and with it the
     rendered hairline — has to be bought back per breakpoint. */
  @media (max-width: 900px) { .ring { stroke-width: 0.8; } }
  @media (max-width: 640px) {
    .ring { stroke-width: 0.9; }
    /* A phone is portrait: the drawing ends up BEHIND the type rather than
       beside it, so it has to give way. Same picture, half the presence. */
    .terrain {
      right: -26vw;
      width: clamp(560px, 92vh, 900px);
      height: clamp(560px, 92vh, 900px);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .terrain.in .ring {
      animation: none;
      stroke-dashoffset: 0;
    }
    .ring { transition: none; }
  }
</style>

<script>
  // Kicked off after paint so the draw is seen starting, not caught halfway.
  const svg = document.querySelector<SVGElement>('.terrain');
  if (svg) requestAnimationFrame(() => svg.classList.add('in'));
</script>
