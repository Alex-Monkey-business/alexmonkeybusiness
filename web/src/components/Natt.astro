---
/**
 * THE PLATE — a photograph in the exposure of Alex's reference, on a ground
 * that is always black. `Strek` with the photograph inside the shape instead of
 * flat ink.
 *
 * THE SOURCE IS THE WHOLE DIFFERENCE. The reference (Stéphane Godin, Matterhorn
 * from the south) is not a grade: its black is SHADOW, from a low sun to one
 * side, and its edge is a sharp still. Our video frame was the opposite on
 * every count — overcast, flat, 720p upscaled, Laplacian variance 67 against
 * the reference's 2205 — and no curve manufactures a shadow side that was not
 * lit into the picture. The first plate, cut from that frame with the sky
 * filled in, was the honest result and it looked like it: soft, grey, rimmed.
 *
 * This one is cut from a still by kuhnmi (Wikimedia Commons, CC BY 2.0): same
 * north-east side, afternoon sun from the left, the east face in its own
 * shadow, sky at luminance 68. A black point of 70 puts the sky at zero on its
 * own, so the plate needs no silhouette mask in CSS and there is no rim to
 * hide. Variance 11 790. See `tools/make-plate.mjs` for the grade and
 * `tools/trace-still.mjs` for the ridges.
 *
 * THE SKY IS BAKED TO EXACTLY #000 anyway — the haze low on the left lifts it
 * to 12 after the crush, and 12 on 0 is a visible rectangle. The tracer's
 * full-width edge (`matterhorn-still-sky.svg`) cuts it, and takes two lift
 * pylons on the slope with it.
 *
 * A STILL, NOT THE CLIP: 2400 px wide, 0.5 MB, no loop to cut; the motion is
 * the slow push, which a still carries.
 *
 * ALWAYS VELVET, IN BOTH THEMES. The whole idea is type in the photograph's own
 * black, and on cream there is no black to put it in. So this surface declares
 * the dark palette locally rather than following the toggle — see the page. It
 * is the one surface in the set that does not flip, and that is a real cost:
 * the toggle still works everywhere else, and here it does nothing.
 */
import { still } from '../lib/skyline';

/* The still's own trace — not the video's. See the note in `skyline.ts`. */
const { viewBox, line, segs, peak, vbw, vbh, ridge } = still;
---

<div class="sky" data-ridge={JSON.stringify(ridge)} data-vb={`${vbw} ${vbh}`} style={`--ar: ${vbw} / ${vbh}; --peak-x: ${(peak.x * 100).toFixed(2)}%; --peak-y: ${(peak.y * 100).toFixed(2)}%;`}>
  <div class="sky-push">
    <img class="sky-plate" src="/hero/matterhorn-still.webp" alt="" width={2400} height={1350} decoding="async" />

    <svg class="sky-line" viewBox={viewBox} preserveAspectRatio="none" fill="none" aria-hidden="true">
      {segs.map((s) => (
        <Fragment>
          <path class="draw" data-seg={s.key} pathLength="1" d={line} style={`--len: ${s.len}; --o0: ${s.o0}; --o1: ${s.o1};`} />
          <path class="seg" data-seg={s.key} pathLength="1" d={line} style={`--len: ${s.len}; --o0: ${s.o0}; --o1: ${s.o1};`} />
        </Fragment>
      ))}
    </svg>
  </div>

  <!-- The night: the odd meteor, drawn in the sky only. See the script — the
       canvas is clipped to the traced edge, so one that runs low sets behind
       the mountain instead of crossing the rock. -->
  <canvas class="sky-night" aria-hidden="true"></canvas>
</div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    container-type: size;
    --draw: 2600ms;
    --ease-draw: cubic-bezier(0.45, 0, 0.15, 1);
    --ease-climb: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Frame and push are `Skyline.astro`'s — see the framing note there. The zoom
     runs further and slower than the clip's because a 2400-wide still has more
     to give than a 1280 video frame did.

     THE CAMERA NEVER STOPS. `forwards` left the frame dead after 55 s, and a
     still that has stopped moving is a wallpaper. Alternating at 70 s a leg is
     0.2 % a second — below what anyone reads as motion, but the frame is never
     the same twice, which is the whole difference between a photograph and a
     window. `--par-x/y` is the pointer parallax, set from the script; the
     `translate` property is separate from the animated `transform`, so the two
     never fight. */
  .sky-push {
    --par-x: 0px;
    --par-y: 0px;
    --fw: max(100cqw, calc(100cqh * var(--ar)));
    --fx: 50%;
    --fy: var(--peak-y);
    --ax: 50%;
    --ay: max(116px, 11%);
    --zoom: 1.16;
    --px: 58%;
    --py: 38%;

    position: absolute;
    left: var(--ax);
    top: var(--ay);
    width: var(--fw);
    aspect-ratio: var(--ar);
    translate: calc(-1 * var(--fx) + var(--par-x)) calc(-1 * var(--fy) + var(--par-y));
    transform-origin: var(--px) var(--py);
  }
  :global(html.js) .sky.go .sky-push {
    animation: push 70s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }
  @keyframes push {
    from { transform: scale(1); }
    to   { transform: scale(var(--zoom)); }
  }

  .sky-plate,
  .sky-line,
  .sky-night {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Sits on the viewport, not in the pushed frame, and is remapped to the
     frame every tick. Under the drawn line, over the plate. */
  .sky-night { z-index: 1; }
  .sky-line { z-index: 2; }

  /**
   * `fill`, not `cover`: the box already carries the viewBox's aspect, so the
   * image and the svg are the same uniform map, and a rounding hair in the box
   * moves both by the same amount instead of drifting them apart.
   *
   * NO FILTER HERE. The plate is baked, and re-grading it in CSS would double
   * the contrast curve. The only reason this surface exists is that the grade
   * is right in the file.
   */
  .sky-plate {
    object-fit: fill;
    opacity: 0;
    /* The photograph comes out of the summit, inside the drawing — the circle
       starts where the two ridges start and stays behind them. */
    clip-path: circle(0% at var(--peak-x) var(--peak-y));
    transition:
      opacity 1600ms var(--ease-out),
      clip-path 2600ms var(--ease-draw);

    /**
     * NO MASK AT ALL. The sky in the file is #000 up to the traced edge, and
     * the page behind it is #000, so the plate has no rectangle to hide and no
     * cutout to fade. The earlier plate needed a fade on the left, where the
     * ridge ran into cloud and the trace had to guess; this one is measured
     * edge to edge.
     */
  }
  /* Full strength, unlike Skyline's 0.62. A plate graded to sit on black does
     not want to be faded into it — dimming it is just undoing the grade. */
  .sky.lit .sky-plate {
    opacity: 1;
    clip-path: circle(150% at var(--peak-x) var(--peak-y));
  }

  .draw,
  .seg {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /**
   * The drawn line is quieter here than on `Strek` and quieter than on
   * `Skyline`: the plate's own edge is now a hard bright-against-black step, so
   * the line has almost nothing left to do. It stays because the ridges are the
   * menu and there has to be something to notice before anyone points — but at
   * 0.9 it would read as an outline drawn around a photograph, which is the one
   * thing this surface must not look like.
   */
  .draw {
    stroke: var(--fg1);
    stroke-width: 1.4;
    stroke-dasharray: var(--len) 1;
    stroke-dashoffset: var(--o1);
    opacity: 0.22;
    transition: opacity 1200ms var(--ease-out);
  }
  :global(html.js) .draw {
    stroke-dasharray: 0 1;
    stroke-dashoffset: var(--o0);
    opacity: 0;
  }
  :global(html.js) .sky.go .draw {
    animation: climb var(--draw) var(--ease-draw) 120ms forwards;
    opacity: 0.8;
    transition-duration: 500ms;
  }
  /* Worst case first, then the hover dim, then the ridge exempt from it — they
     all land on the same specificity, so the last one wins. */
  :global(html.js) .sky.settled .draw {
    opacity: 0.22;
    transition-duration: 1400ms;
  }
  :global(html.js) .sky.shift .draw {
    opacity: 0.5;
    transition-duration: 260ms;
  }
  .sky:has(.seg.hot) .draw {
    opacity: 0.06;
    transition-duration: var(--dur-base);
  }
  .sky .draw.under {
    opacity: 0.24;
    transition-duration: var(--dur-base);
  }

  @keyframes climb {
    to {
      stroke-dasharray: var(--len) 1;
      stroke-dashoffset: var(--o1);
    }
  }

  /* Lavender on a monochrome plate is the only colour on the screen, which is
     exactly what a single accent is for. */
  .seg {
    stroke: var(--lavender);
    stroke-width: 2.6;
    stroke-dasharray: 0 1;
    stroke-dashoffset: var(--o0);
    opacity: 0;
    transition:
      stroke-dasharray 560ms var(--ease-in),
      stroke-dashoffset 560ms var(--ease-in),
      opacity 260ms linear 300ms;
  }
  .sky .seg.hot {
    stroke-dasharray: var(--len) 1;
    stroke-dashoffset: var(--o1);
    opacity: 1;
    transition:
      stroke-dasharray 760ms var(--ease-climb),
      stroke-dashoffset 760ms var(--ease-climb),
      opacity 120ms linear;
  }

  /* Portrait pins the frame by its peak so the mountain sits in the lower half
     and the top half is black for the type. See the note in `Skyline.astro`. */
  @media (orientation: portrait) and (max-width: 820px) {
    .sky-push {
      --fw: max(190cqw, calc(48cqh * var(--ar)));
      --fx: var(--peak-x);
      --fy: var(--peak-y);
      --ax: 50%;
      --ay: 58%;
      --px: var(--peak-x);
      --py: var(--peak-y);
      --zoom: 1.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .sky.go .sky-push { animation: none; }
    :global(html.js) .draw,
    :global(html.js) .sky.go .draw {
      animation: none;
      stroke-dasharray: var(--len) 1;
      stroke-dashoffset: var(--o1);
      opacity: 0.22;
      transition: none;
    }
    .sky-plate { transition: none; clip-path: none; }
    .seg,
    .sky .seg.hot { transition: opacity 120ms linear; }
  }
</style>

<script>
  const sky = document.querySelector<HTMLElement>('.sky');
  const plate = document.querySelector<HTMLImageElement>('.sky-plate');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (sky && plate) {
    requestAnimationFrame(() => sky.classList.add('go'));

    /* Wait for the decode before revealing, so the plate does not pop in
       halfway through the clip-path. A still has no buffering to hide behind
       and 115 kB usually beats the 500ms anyway. */
    const reveal = () => {
      if (still) {
        sky.classList.add('lit', 'settled');
      } else {
        setTimeout(() => sky.classList.add('lit'), 400);
        setTimeout(() => sky.classList.add('settled'), 2900);
      }
    };
    plate.decode?.().then(reveal, reveal) ?? reveal();

    night(sky, still);
  }

  /**
   * THE NIGHT.
   *
   * The plate is an afternoon photograph with the sky crushed to black, and a
   * black sky reads as night whether it was or not. The first version filled
   * it with a field of stars; Alex cut it — a sky that is HELT SORT is cleaner,
   * and the plate was built to be exactly that. What stays is the one event:
   * now and then a meteor, on an otherwise empty sky. One every four to nine
   * seconds, the first inside three, so nobody leaves without seeing one.
   *
   * The canvas is clipped to the sky above the traced ridge, which is what
   * makes the meteor honest: one that runs low goes behind the summit and is
   * gone, the way a real one would. The clip is rebuilt every tick from the
   * frame's on-screen rect, so the push, the level zoom and the pointer lean
   * are all already in it.
   *
   * Reduced motion: nothing. The sky is black and stays black.
   */
  function night(sky: HTMLElement, still: boolean) {
    const canvas = sky.querySelector<HTMLCanvasElement>('.sky-night');
    const svg = sky.querySelector<SVGSVGElement>('.sky-line');
    const push = sky.querySelector<HTMLElement>('.sky-push');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !svg || !push || !ctx) return;

    const ridge = JSON.parse(sky.dataset.ridge ?? '[]') as [number, number][];
    const [vbw, vbh] = (sky.dataset.vb ?? '2400 1350').split(' ').map(Number);
    if (ridge.length < 2) return;

    /* Height of the sky's lower edge at x, in frame units. */
    const ridgeY = (x: number) => {
      let lo = 0;
      let hi = ridge.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (ridge[mid][0] <= x) lo = mid;
        else hi = mid;
      }
      const [x0, y0] = ridge[lo];
      const [x1, y1] = ridge[hi];
      return x1 === x0 ? y0 : y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
    };

    const rnd = (a: number, b: number) => a + Math.random() * (b - a);

    /* A meteor: born in the upper sky, runs down at 25–40°, lives under a
       second. Position and length are in canvas pixels once spawned — it is
       not attached to the mountain, it passes in front of the sky. */
    type Meteor = { x: number; y: number; dx: number; dy: number; len: number; t0: number; life: number };
    const meteors: Meteor[] = [];
    let nextMeteor = Infinity;

    let dpr = 1;
    const size = () => {
      dpr = Math.min(2, devicePixelRatio || 1);
      const r = canvas.getBoundingClientRect();
      /* The canvas itself may be CSS-scaled by the level camera; its backing
         store follows its layout size, not its painted size. */
      canvas.width = Math.round(canvas.offsetWidth * dpr);
      canvas.height = Math.round(canvas.offsetHeight * dpr);
      return r;
    };
    size();
    new ResizeObserver(size).observe(canvas);

    /* Pointer parallax, desktop only: the camera leans a few pixels against
       the pointer, eased hard so it reads as weight rather than tracking. */
    const fine = matchMedia('(pointer: fine)').matches && !still;
    let tx = 0, ty = 0, px = 0, py = 0;
    if (fine) {
      addEventListener('pointermove', (e) => {
        tx = (e.clientX / innerWidth - 0.5) * -22;
        ty = (e.clientY / innerHeight - 0.5) * -14;
      }, { passive: true });
    }

    let litAt = 0;
    const frame = (now: number) => {
      if (!litAt && sky.classList.contains('lit')) {
        litAt = now;
        nextMeteor = now + (still ? Infinity : 2600);
      }

      if (fine) {
        px += (tx - px) * 0.035;
        py += (ty - py) * 0.035;
        push.style.setProperty('--par-x', px.toFixed(2) + 'px');
        push.style.setProperty('--par-y', py.toFixed(2) + 'px');
      }

      /* Frame → canvas pixels. Both rects are on screen, so the level zoom on
         `.sky` and the push on `.sky-push` are both already in them. */
      const R = svg.getBoundingClientRect();
      const C = canvas.getBoundingClientRect();
      const kx = canvas.width / C.width;
      const ky = canvas.height / C.height;
      const mx = (x: number) => (R.left + (x / vbw) * R.width - C.left) * kx;
      const my = (y: number) => (R.top + (y / vbh) * R.height - C.top) * ky;

      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      /* The sky, as a clip. */
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(mx(ridge[0][0]), my(ridge[0][1]));
      for (let i = 1; i < ridge.length; i++) ctx.lineTo(mx(ridge[i][0]), my(ridge[i][1]));
      ctx.lineTo(mx(vbw), -H);
      ctx.lineTo(mx(0), -H);
      ctx.closePath();
      ctx.clip();

      if (!still && now >= nextMeteor) {
        /* Born somewhere in the visible sky: from near the top of the screen
           down to well above the ridge, in frame units. */
        const fx = rnd(vbw * 0.08, vbw * 0.92);
        const top = ((C.top - R.top) / R.height) * vbh + vbh * 0.04;
        const fy = rnd(top, Math.min(ridgeY(fx) - 40, top + (ridgeY(fx) - top) * 0.7));
        const ang = rnd(25, 40) * (Math.PI / 180);
        const dir = Math.random() < 0.5 ? -1 : 1;
        meteors.push({
          x: mx(fx), y: my(fy),
          dx: Math.cos(ang) * dir, dy: Math.sin(ang),
          len: rnd(150, 290) * dpr,
          t0: now, life: rnd(650, 1000),
        });
        nextMeteor = now + rnd(4000, 9000);
      }
      for (let i = meteors.length - 1; i >= 0; i--) {
        const m = meteors[i];
        const p = (now - m.t0) / m.life;
        if (p >= 1) { meteors.splice(i, 1); continue; }
        const e = 1 - (1 - p) * (1 - p); /* ease-out: fast, then spent */
        const hx = m.x + m.dx * m.len * e;
        const hy = m.y + m.dy * m.len * e;
        const tail = m.len * 0.42 * Math.sin(Math.PI * p);
        const grad = ctx.createLinearGradient(hx, hy, hx - m.dx * tail, hy - m.dy * tail);
        const a = Math.pow(Math.sin(Math.PI * p), 0.6);
        grad.addColorStop(0, `rgba(255,255,235,${(0.95 * a).toFixed(3)})`);
        grad.addColorStop(1, 'rgba(255,255,235,0)');
        ctx.globalAlpha = 1;
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.3 * dpr;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(hx, hy);
        ctx.lineTo(hx - m.dx * tail, hy - m.dy * tail);
        ctx.stroke();
      }
      ctx.restore();

      requestAnimationFrame(frame);
    };
    /* Reduced motion: nothing to draw and nothing to lean, so the loop never
       starts. */
    if (!still) requestAnimationFrame(frame);
  }
</script>
