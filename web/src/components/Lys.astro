  .lys-slide::-moz-range-thumb { width: 24px; height: 33px; }
  .lys-dial:has(.lys-slide:focus-visible) .lys-mark { outline: 1px solid var(--signal); outline-offset: 3px; }
  .lys-dial > span {
    position: absolute;
    top: 0;
    left: calc(var(--x, 0) * 100%);
  }
  .lys-rise,
  .lys-set {
    width: 1px;
    height: 7px;
    margin-top: -3px;
    background: var(--fg2);
  }
  .lys-now {
    width: 3px;
    height: 3px;
    margin: -1px 0 0 -1px;
    background: var(--fg2);
  }
  /* The shown minute is a knob, always: it says the day can be moved. */
  .lys-mark {
    width: 11px;
    height: 11px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 24%, transparent);
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Pointed at, held or focused, it grows a halo to grab. */
  .lys-dial:hover .lys-mark,
  .lys-dial:active .lys-mark,
  .lys-dial:has(.lys-slide:focus-visible) .lys-mark {
    transform: scale(1.25);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--signal) 24%, transparent);
  }
  :global(html.lys-drag),
  :global(html.lys-drag *) { cursor: ew-resize !important; }

  @media (prefers-reduced-motion: reduce) {
    .lys-gl, .lys-read, .lys-dial, .lys-sky { transition: none; }
  }
</style>

<script>
  const LAT = 45.9763;
  const LNG = 7.6586;
  /* Coarse file: 8000 m square; its top-left texel is 4048 m west and 4326 m
     north of the summit (LV95 2617048 / 1091674). x east, y north. */
  const N = 1024;
  /* Detail file: x −1400…1700, y −1300…1800. */
  const ND = 1536;

  const root = document.querySelector<HTMLElement>('.lys');
  const canvas = root?.querySelector<HTMLCanvasElement>('.lys-gl');
  const gl = canvas?.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'high-performance' });
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* A page left open for hours can lose its GPU context — sleep, a GPU
     switch, a phone reclaiming memory. A lost opaque canvas paints white.
     So: hide it at once (the black and the still photograph stand in), and
     when the browser hands the context back, load the page again where it
     was; rebuilding every texture by hand is not worth the code. */
  canvas?.addEventListener('webglcontextlost', (e) => {
    e.preventDefault();
    root?.classList.add('ready', 'failed', 'lost');
  });
  canvas?.addEventListener('webglcontextrestored', () => location.reload());
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && gl?.isContextLost()) root?.classList.add('ready', 'failed', 'lost');
  });

  /* ---- The sun (SunCalc's formulae, trimmed) ----------------------------- */

  const rad = Math.PI / 180;
  const OBL = rad * 23.4397;
  const days = (date: Date) => date.valueOf() / 86400000 - 0.5 + 2440588 - 2451545;
  /** Right ascension and declination to height and a direction in x east, y north. */
  function horizon(d: number, ra: number, dec: number) {
    const H = rad * (280.16 + 360.9856235 * d) + rad * LNG - ra;
    const phi = rad * LAT;
    const alt = Math.asin(Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H));
    const az = Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi));
    const bearing = az + Math.PI;
    return {
      alt,
      dir: [Math.sin(bearing) * Math.cos(alt), Math.cos(bearing) * Math.cos(alt), Math.sin(alt)] as [number, number, number],
    };
  }
  function sunEq(d: number) {
    const M = rad * (357.5291 + 0.98560028 * d);
    const C = rad * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));
    const L = M + C + rad * 102.9372 + Math.PI;
    return { dec: Math.asin(Math.sin(L) * Math.sin(OBL)), ra: Math.atan2(Math.sin(L) * Math.cos(OBL), Math.cos(L)) };
  }
  function sunAt(date: Date) {
    const d = days(date);
    const s = sunEq(d);
    return horizon(d, s.ra, s.dec);
  }
  /** The moon: where it stands and how much of it is lit (0 new, 1 full). */
  function moonAt(date: Date) {
    const d = days(date);
    const L = rad * (218.316 + 13.176396 * d);
    const M = rad * (134.963 + 13.064993 * d);
    const F = rad * (93.272 + 13.22935 * d);
    const l = L + rad * 6.289 * Math.sin(M);
    const b = rad * 5.128 * Math.sin(F);
    const dist = 385001 - 20905 * Math.cos(M);
    const ra = Math.atan2(Math.sin(l) * Math.cos(OBL) - Math.tan(b) * Math.sin(OBL), Math.cos(l));
    const dec = Math.asin(Math.sin(b) * Math.cos(OBL) + Math.cos(b) * Math.sin(OBL) * Math.sin(l));
    const s = sunEq(d);
    const phi = Math.acos(Math.sin(s.dec) * Math.sin(dec) + Math.cos(s.dec) * Math.cos(dec) * Math.cos(s.ra - ra));
    const inc = Math.atan2(149598000 * Math.sin(phi), dist - 149598000 * Math.cos(phi));
    return { ...horizon(d, ra, dec), lit: (1 + Math.cos(inc)) / 2 };
  }

  const fmt = new Intl.DateTimeFormat('nb-NO', { timeZone: 'Europe/Zurich', hour: '2-digit', minute: '2-digit', hour12: false });
  const zermattClock = (date: Date) => fmt.format(date);
  const zermattMinutes = (date: Date) => {
    const [h, m] = zermattClock(date).split(/\D/).map(Number);
    return h * 60 + m;
  };

  function riseSet(date: Date) {
    const midnight = date.valueOf() - zermattMinutes(date) * 60000;
    let rise = -1, set = -1, prev = sunAt(new Date(midnight)).alt;
    for (let m = 4; m <= 1440; m += 4) {
      const a = sunAt(new Date(midnight + m * 60000)).alt;
      if (prev < -0.0145 && a >= -0.0145 && rise < 0) rise = m / 1440;
      if (prev >= -0.0145 && a < -0.0145) set = m / 1440;
      prev = a;
    }
    return { rise, set };
  }

  /* ---- Light from the sun's height --------------------------------------- */

  type V3 = [number, number, number];
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
  const mix = (a: V3, b: V3, t: number) => a.map((v, i) => v + (b[i] - v) * clamp01(t)) as V3;
  const ss = (a: number, b: number, x: number) => {
    const t = clamp01((x - a) / (b - a));
    return t * t * (3 - 2 * t);
  };
  /** Piecewise through (elevation, colour) stops. */
  const ramp = (stops: [number, V3][], x: number): V3 => {
    if (x <= stops[0][0]) return stops[0][1];
    for (let i = 1; i < stops.length; i++) {
      if (x <= stops[i][0]) return mix(stops[i - 1][1], stops[i][1], (x - stops[i - 1][0]) / (stops[i][0] - stops[i - 1][0]));
    }
    return stops[stops.length - 1][1];
  };
  /*
   * Exposure is a photographer's, not a webpage's: the sky is kept low, the
   * way a camera metered for sunlit snow renders it, so the type always has a
   * dark ground. Colours are linear.
   */
  function lightFor(altDeg: number) {
    /* Sun: strong red at the horizon (through the most air), gold low, near
       white high. It keeps a little strength just below the horizon on purpose:
       the summit is still lit there while the valley is not. */
    const sunC = ramp([
      [-4, [0.9, 0.18, 0.06]],
      [0, [1.0, 0.3, 0.1]],
      [3, [1.0, 0.52, 0.28]],
      [8, [1.0, 0.76, 0.56]],
      [20, [1.0, 0.91, 0.82]],
      [45, [1.0, 0.96, 0.9]],
    ], altDeg);
    const k = ss(-3.5, 1.0, altDeg) * (3.2 + 1.4 * ss(0, 30, altDeg));
    const sun = sunC.map((v) => v * k) as V3;
    const zen = ramp([
      [-18, [0.0002, 0.0002, 0.0005]],
      [-8, [0.001, 0.0013, 0.004]],
      [-2, [0.003, 0.0045, 0.012]],
      [6, [0.005, 0.011, 0.03]],
      [30, [0.006, 0.015, 0.045]],
    ], altDeg);
    const hor = ramp([
      [-18, [0.0004, 0.0004, 0.0008]],
      [-8, [0.0025, 0.0025, 0.006]],
      [-2, [0.012, 0.009, 0.016]],
      [2, [0.026, 0.02, 0.024]],
      [8, [0.022, 0.03, 0.045]],
      [30, [0.03, 0.045, 0.07]],
    ], altDeg);
    const stars = 1 - ss(-12, -5, altDeg);
    /* The hemisphere the snow sees: the sky, plus starlight at night so the
       mountain is a pale shape rather than a hole. */
    const amb = zen.map((v, i) => v * 3.2 + hor[i] * 1.2 + 0.0012 + stars * [0.018, 0.02, 0.038][i]) as V3;
    return { sun, zen, hor, amb, stars };
  }

  /* Moonlight, once the sun's light is gone: cool, as the eye sees it at
     night, and much weaker at half than at full. Under it, always, a fill from
     a fixed high east, so on a moonless night the mountain still reads as a
     shape: the floor Alex asked for, not the truth. */
  const MOON: V3 = [0.5, 0.58, 0.82];
  function moonFor(sunAltDeg: number, moon: { alt: number; lit: number }) {
    const night = 1 - ss(-6, -1, sunAltDeg);
    const k = moon.lit * moon.lit * ss(-1, 8, moon.alt / rad) * night;
    return {
      moon: MOON.map((v) => v * 0.3 * k) as V3,
      fill: MOON.map((v) => v * 0.08 * night) as V3,
    };
  }

  /* ---- GL ---------------------------------------------------------------- */

  const VS = `#version 300 es
  in vec2 p; out vec2 uv;
  void main() { uv = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }`;

  const fs = (floatLinear: boolean) => `#version 300 es
  precision highp float;
  precision highp sampler2D;
  in vec2 uv; out vec4 o;
  uniform sampler2D H, D, O;
  uniform vec2 res;
  uniform vec3 cam, fwd, rgt, up;
  uniform float fov;
  uniform vec3 sunDir, sunCol, zenCol, horCol, ambCol;
  uniform vec3 moonDir, moonCol, fillCol;
  uniform float stars, moonVis, moonPhase;
  uniform float seed;
  uniform float dpr;

  const float PX = ${(8000 / N).toFixed(6)};
  const vec2 ORIGIN = vec2(4048.0, 4326.0);
  const float DP = ${(3100 / ND).toFixed(6)};
  const vec2 DORG = vec2(1400.0, 1800.0);

  float base(vec2 w) {
    vec2 t = vec2((w.x + ORIGIN.x) / PX, (ORIGIN.y - w.y) / PX);
    vec2 c = clamp(t, vec2(0.5), vec2(${N}.0 - 0.5));
    float out_ = length(t - c) * PX * 2.5;
    ${floatLinear
      ? `return texture(H, c / ${N}.0).r - out_;`
      : `vec2 g = c - 0.5; ivec2 i = ivec2(floor(g)); vec2 f = g - vec2(i);
    float a = texelFetch(H, i, 0).r, b = texelFetch(H, min(i + ivec2(1, 0), ivec2(${N - 1})), 0).r;
    float d = texelFetch(H, min(i + ivec2(0, 1), ivec2(${N - 1})), 0).r, e = texelFetch(H, min(i + ivec2(1, 1), ivec2(${N - 1})), 0).r;
    return mix(mix(a, b, f.x), mix(d, e, f.x), f.y) - out_;`}
  }

  /* The 2 m residual on top, faded out over the last 80 m of its box. */
  float hgt(vec2 w) {
    float h = base(w);
    vec2 t = vec2(w.x + DORG.x, DORG.y - w.y);
    float edge = min(min(t.x, t.y), min(3100.0 - t.x, 3100.0 - t.y));
    if (edge <= 0.0) return h;
    float r = (texture(D, t / 3100.0).r * 255.0 - 128.0) * 0.5;
    return h + r * smoothstep(0.0, 80.0, edge);
  }

  vec3 nrm(vec2 w, float e) {
    return normalize(vec3(hgt(w - vec2(e, 0.0)) - hgt(w + vec2(e, 0.0)),
                          hgt(w - vec2(0.0, e)) - hgt(w + vec2(0.0, e)),
                          2.0 * e));
  }

  float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
  }
  float fbm(vec2 p) {
    float s = 0.0, a = 0.5;
    for (int i = 0; i < 4; i++) { s += a * vnoise(p); p = p * 2.03 + 17.1; a *= 0.5; }
    return s;
  }

  float shadow(vec3 p, vec3 L) {
    if (L.z < -0.08) return 0.0;
    float r = 1.0, t = 6.0;
    for (int i = 0; i < 64; i++) {
      vec3 q = p + L * t;
      if (q.z > 4490.0) break;
      float h = q.z - hgt(q.xy);
      r = min(r, 9.0 * h / t);
      if (r < 0.002) break;
      t += clamp(h * 0.55, 4.0, 240.0);
    }
    return smoothstep(0.0, 1.0, clamp(r, 0.0, 1.0));
  }

  /* Cheap occlusion: how far the ground around a point stands above it. */
  float occl(vec2 w, float h) {
    float o = 0.0;
    for (int i = 0; i < 6; i++) {
      float a = float(i) * 1.0472 + 0.4;
      vec2 d = vec2(cos(a), sin(a));
      o += max(hgt(w + d * 22.0) - h, 0.0) / 22.0;
      o += max(hgt(w + d * 90.0) - h, 0.0) / 90.0 * 0.6;
    }
    return clamp(1.0 - o * 0.16, 0.25, 1.0);
  }

  /* One layer of stars: one chance per cell, set anywhere in it, a point a
     CSS pixel wide however far the canvas is scaled. Most are faint, few are
     bright, and their colour runs from warm to cold. */
  vec3 starLayer(vec3 rd, float cells, float chance, float pix, float salt) {
    float el = asin(clamp(rd.z, -1.0, 1.0));
    vec2 g = vec2(atan(rd.y, rd.x), el) * cells;
    vec2 cell = floor(g);
    float h = hash(cell + salt);
    if (h < 1.0 - chance) return vec3(0.0);
    vec2 at = 0.15 + 0.7 * vec2(hash(cell + salt + 3.1), hash(cell + salt + 5.7));
    vec2 d = (fract(g) - at) / cells;
    d.x *= cos(el);
    float r = length(d) / (pix * dpr);
    float b = pow(hash(cell + salt + 9.3), 7.0);
    float c = hash(cell + salt + 1.9);
    vec3 tint = c < 0.2 ? vec3(1.0, 0.82, 0.62) : c > 0.8 ? vec3(0.72, 0.8, 1.0) : vec3(0.92, 0.93, 1.0);
    return tint * (0.06 + 1.6 * b) * exp(-r * r * 2.2);
  }

  vec3 skyAt(vec3 rd, float pix) {
    float e = clamp(rd.z, 0.0, 1.0);
    vec3 s = mix(horCol, zenCol, pow(e, 0.42));
    /* Forward scattering round the sun, and its warmth on the horizon. */
    float mu = max(dot(rd, sunDir), 0.0);
    s += sunCol * (0.012 * pow(mu, 6.0) + 0.05 * pow(mu, 60.0)) * (1.0 - e * 0.7);
    if (stars > 0.0) {
      vec3 st = starLayer(rd, 260.0, 0.012, pix, 0.0) + starLayer(rd, 620.0, 0.02, pix, 41.0) * 0.35;
      s += st * 0.3 * stars * smoothstep(0.02, 0.2, rd.z);
    }
    return s;
  }


  /* The sun and the moon as bodies, drawn about twice their real size so they
     read on a phone. The moon is a lit sphere: its bright side faces the sun,
     so the phase is the true one tonight; the dark side keeps a trace of
     earthshine. Only on open sky — the mountain hides them for free. */
  vec3 discs(vec3 rd, float pix, vec2 q) {
    vec3 c = vec3(0.0);
    float ds = acos(clamp(dot(rd, sunDir), -1.0, 1.0));
    float rs = 0.0095;
    c += sunCol * (14.0 * smoothstep(rs + pix, rs - pix, ds) + 0.35 * exp(-ds * ds / (rs * rs * 9.0)));
    if (moonVis > 0.0) {
      /* Lit the way the sun is: a luminous body seen through air, not a cut-out.
         A slightly soft rim, a soft terminator (the light grazes the rough
         surface), faint seas, and a glow round it as large as its light —
         a full moon fills the sky with it, a half moon less. Low down, the
         air dims it and warms it. */
      float dm = acos(clamp(dot(rd, moonDir), -1.0, 1.0));
      float rm = 0.0072;
      /* Measured on the screen, not on the sky: a wide lens stretches a
         round body into an egg toward the edges, and a moon has to be round. */
      float mf = dot(moonDir, fwd);
      vec2 qm = vec2(dot(moonDir, rgt), dot(moonDir, up)) / max(mf, 0.05);
      float rq = rm * pow(1.0 + dot(qm, qm), 0.75);
      vec2 dq = q - qm;
      float dsq = length(dq) / rq * rm;
      float disc = mf > 0.05 ? smoothstep(rm + pix * 1.6, rm - pix * 1.2, dsq) : 0.0;
      float air = exp(-0.06 / max(moonDir.z, 0.03));
      vec3 tint = mix(vec3(1.0, 0.72, 0.48), vec3(0.93, 0.94, 1.0), air);
      if (disc > 0.0) {
        vec3 off = (dq.x * rgt + dq.y * up) / rq;
        off -= moonDir * dot(off, moonDir);
        float z = sqrt(max(0.0, 1.0 - dot(off, off)));
        vec3 nrm = off - moonDir * z;
        float lit = smoothstep(-0.06, 0.14, dot(nrm, sunDir));
        vec3 e1 = normalize(cross(moonDir, vec3(0.0, 0.0, 1.0)));
        vec3 e2 = cross(e1, moonDir);
        vec2 m = vec2(dot(off, e1), dot(off, e2));
        float seas = smoothstep(0.4, 0.66, fbm(m * 1.6 + vec2(3.1, 7.4)));
        float alb = (1.0 - 0.22 * seas) * mix(0.8, 1.0, z);
        /* Earthshine on the dark side, just enough that the whole round
           body is there — a soft-edged gibbous alone reads as an egg. */
        c += tint * disc * moonVis * air * (lit * 1.25 * alb + 0.035 * alb);
      }
      float g = moonVis * air * (0.25 + 0.75 * moonPhase);
      c += tint * g * (0.06 * exp(-dm * dm / (rm * rm * 4.0)) + 0.018 * exp(-dm / (rm * 3.5)) + 0.004 * exp(-dm / (rm * 16.0)));
    }
    return c;
  }

  vec3 aces(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
  }

  void main() {
    float tf = tan(fov * 0.5);
    vec2 q = (uv - 0.5) * vec2(res.x / res.y, 1.0) * 2.0 * tf;
    vec3 rd = normalize(fwd + q.x * rgt + q.y * up);
    vec3 ro = cam;
    float pix = 2.0 * tf / res.y;   /* radians per pixel */

    float t = 30.0, tmax = 18000.0;
    bool hit = false;
    float last = 0.0;
    for (int i = 0; i < 480; i++) {
      vec3 p = ro + rd * t;
      if (p.z > 4500.0 && rd.z > 0.0) break;
      float d = p.z - hgt(p.xy);
      if (d < 0.0) {
        float a = last, b = t;
        for (int k = 0; k < 7; k++) {
          float m = 0.5 * (a + b);
          vec3 pm = ro + rd * m;
          if (pm.z - hgt(pm.xy) < 0.0) b = m; else a = m;
        }
        t = b; hit = true; break;
      }
      last = t;
      /* Close over the rock, short steps: on a steep face the height above
         it says little about how near the face is, and a long step there
         jumps a thin crest — the silhouette frays into feathers. */
      float st = d * 0.42;
      if (d < 90.0) st = min(st, 2.5 + t * pix * 1.2);
      t += max(st, d < 12.0 ? 0.3 + t * pix * 0.35 : 0.5 + t * pix * 0.8);
      if (t > tmax) break;
    }

    vec3 col;
    vec3 sky = skyAt(rd, pix);
    if (!hit) {
      col = sky + discs(rd, pix, q);
    } else {
      vec3 p = ro + rd * t;
      float e = max(2.0, t * pix * 1.5);
      vec3 n = nrm(p.xy, e);
      /* On walls the height file is a stack of steps one texel apart, and a
         fine normal turns each step into a vertical stripe: rock that reads as
         wood grain. There the normal is taken over a wider span. */
      vec3 nw = nrm(p.xy, e * 4.0);
      float wall = smoothstep(0.25, 0.7, 1.0 - nw.z);
      n = normalize(mix(n, nw, wall * 0.85));

      /* Rock and snow. Noise breaks every threshold so nothing reads as a
         contour; it fades out with distance so far slopes do not shimmer. */
      float near = 1.0 - smoothstep(1500.0, 7000.0, t);
      /* On a wall, plan coordinates smear noise into vertical streaks; there
         it is sampled along the face and up it instead. */
      vec2 th = normalize(vec2(-n.y, n.x) + 1e-5);
      vec2 nc = mix(p.xy, vec2(dot(p.xy, th), p.z * 1.4), smoothstep(0.25, 0.6, 1.0 - n.z));
      float f1 = fbm(nc / 9.0);
      float f2 = fbm(p.xy / 60.0 + 3.0);
      float strata = vnoise(vec2(p.z / 7.0, (p.x + p.y) / 400.0));
      /* Gneiss: dark and cool. Lighter and warmer, the low sun turned it to
         sandstone on every lit wall. */
      vec3 rock = vec3(0.066, 0.067, 0.07) * (0.62 + 0.5 * f2 + 0.25 * (strata - 0.5) * near + 0.35 * (f1 - 0.5) * near);
      rock = mix(rock, vec3(0.105, 0.098, 0.075), smoothstep(2900.0, 2500.0, p.z));
      /* Snow lies where the rock lets it: on ledges and shelves, not in
         blotches. The shape comes from the slope; noise only frays the edge. */
      float lip = (f1 - 0.5) * 0.07 * near + (f2 - 0.5) * 0.06;
      float snow = smoothstep(0.6, 0.74, nw.z + lip) * smoothstep(2450.0, 2950.0, p.z + (f2 - 0.5) * 200.0);
      /* Rock micro-relief: bend the normal by the noise's slope, near only. */
      if (near > 0.0) {
        float g0 = fbm(nc / 5.0), gx = fbm((nc + vec2(0.7, 0.0)) / 5.0), gy = fbm((nc + vec2(0.0, 0.7)) / 5.0);
        vec3 tu = normalize(vec3(th, 0.0)), tv = normalize(cross(n, tu));
        n = normalize(n + (tu * (g0 - gx) + tv * (g0 - gy)) * 1.4 * near * (1.0 - snow));
      }
      /* Inside the 2 m box, the orthophoto (swisstopo SWISSIMAGE, summer
         2023) brings the real rock: its cracks, gullies and bedding, as
         luminance against its own 40 m average, so the shading baked into the
         photo is gone and only structure is left. And it says where snow and
         ice actually lie. October has more snow than the flight did, so the
         ledge snow above stays, at half. */
      vec2 ot = vec2(p.x + DORG.x, DORG.y - p.y);
      float oe = min(min(ot.x, ot.y), min(3100.0 - ot.x, 3100.0 - ot.y));
      float inBox = smoothstep(0.0, 120.0, oe);
      if (inBox > 0.0) {
        vec2 og = texture(O, ot / 3100.0).rg;
        float hp = 1.0 + (og.r * 255.0 - 128.0) / 160.0;
        /* Taken from straight above, the photo smears down a wall: there it
           fades out, and the wall keeps its own rock. Snow does not hold on a
           wall either, whatever the photo says. */
        float flat_ = 1.0 - wall;
        rock *= mix(1.0, clamp(hp, 0.35, 1.6), inBox * flat_ * (0.4 + 0.5 * near));
        snow = mix(snow, max(og.g * smoothstep(0.32, 0.58, nw.z), snow * 0.5), inBox);
      }
      /* Wall rock: broken in the face's own plane, coarse and fine. */
      float fw = fbm(nc / 3.5) * 0.6 + fbm(nc / 18.0) * 0.4;
      rock *= mix(1.0, (0.3 + 2.2 * fw * fw) * 0.75, wall * (0.5 + 0.5 * near));
      vec3 alb = mix(rock, vec3(0.86, 0.89, 0.93), snow);

      float dif = max(dot(n, sunDir), 0.0);
      float sh = dif > 0.0 ? shadow(p + n * 1.5, sunDir) : 0.0;
      float ao = occl(p.xy, p.z);
      vec3 amb = ambCol * (0.55 + 0.45 * n.z) * ao;
      /* Snow in shade is lit by blue sky; light off the snowfields fills the
         rock from below. */
      amb += sunCol * 0.035 * (1.0 - n.z) * ao * (0.3 + 0.7 * snow);
      vec3 hv = normalize(sunDir - rd);
      float spec = pow(max(dot(n, hv), 0.0), 60.0) * 0.18 * snow * sh;
      /* Low sun on bare rock reads gold in a photograph, not orange: the
         rock takes the sun's colour at two-thirds strength, snow at full. */
      vec3 sunRock = mix(vec3(dot(sunCol, vec3(0.3, 0.5, 0.2))), sunCol, 0.66);
      vec3 sunLit = mix(sunRock, sunCol, snow);
      col = alb * (sunLit * dif * sh + amb) + sunCol * spec;
      /* Night: the moon throws its own shadows; the fill only shapes. */
      if (fillCol.b > 0.0) {
        float md = max(dot(n, moonDir), 0.0);
        float ms = (md > 0.0 && moonCol.b > 0.0) ? shadow(p + n * 1.5, moonDir) : 0.0;
        float fd = max(dot(n, normalize(vec3(0.85, 0.25, 0.62))) * 0.7 + 0.3, 0.0);
        col += alb * (moonCol * md * ms + fillCol * fd * ao);
      }

      /* Aerial perspective: thicker low down, warmed toward the sun. */
      float dens = exp(-(0.5 * (ro.z + p.z) - 1600.0) / 2600.0);
      float fog = 1.0 - exp(-t * dens / 22000.0);
      float mu = max(dot(rd, sunDir), 0.0);
      vec3 air = horCol * 1.1 + sunCol * 0.02 * pow(mu, 4.0);
      col = mix(col, air, fog);

      /* The data ends; let it end in the dark. */
      vec2 w = abs((p.xy + vec2(ORIGIN.x, -ORIGIN.y)) - vec2(4000.0, -4000.0)) / 4000.0;
      col = mix(air, col, 1.0 - smoothstep(0.55, 0.95, max(w.x, w.y)));

    }

    col = aces(col * 2.2);
    col = pow(col, vec3(1.0 / 2.2));
    col += (hash(gl_FragCoord.xy + seed) - 0.5) / 255.0;
    o = vec4(col, 1.0);
  }`;

  function compile(type: number, src: string) {
    const s = gl!.createShader(type)!;
    gl!.shaderSource(s, src);
    gl!.compileShader(s);
    if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) throw new Error(gl!.getShaderInfoLog(s) || 'shader');
    return s;
  }

  async function pixels(src: string) {
    const blob = await (await fetch(src)).blob();
    const bmp = await createImageBitmap(blob, { colorSpaceConversion: 'none', premultiplyAlpha: 'none' });
    const c = new OffscreenCanvas(bmp.width, bmp.height);
    const ctx = c.getContext('2d')!;
    ctx.drawImage(bmp, 0, 0);
    return ctx.getImageData(0, 0, bmp.width, bmp.height).data;
  }

  async function start() {
    if (!root || !canvas || !gl) throw new Error('no webgl2');
    const floatLinear = !!gl.getExtension('OES_texture_float_linear');
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs(floatLinear)));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) || 'link');
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const climb = root.dataset.mode === 'climb';
    const fine = matchMedia('(pointer: fine)').matches;
    const [hp, dp] = await Promise.all([pixels(root.dataset.src!), pixels(root.dataset.detail!)]);
    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);

    /* Coarse heights as float: two bytes cannot be filtered as one number. */
    const h = new Float32Array(N * N);
    for (let i = 0; i < h.length; i++) h[i] = (hp[i * 4] * 256 + hp[i * 4 + 1]) / 4 + 1500;
    const texH = gl.createTexture();
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, texH);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.R32F, N, N, 0, gl.RED, gl.FLOAT, h);
    const filt = floatLinear ? gl.LINEAR : gl.NEAREST;
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filt);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filt);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

    /* Detail residual is one byte, so R8 and the hardware filter is exact. */
    const d8 = new Uint8Array(ND * ND);
    for (let i = 0; i < d8.length; i++) d8[i] = dp[i * 4 + 1];
    const texD = gl.createTexture();
    gl.activeTexture(gl.TEXTURE1);
    gl.bindTexture(gl.TEXTURE_2D, texD);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.R8, ND, ND, 0, gl.RED, gl.UNSIGNED_BYTE, d8);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

    /* Routes: one row each, x y z and fraction-of-climb per texel. */
    const R = JSON.parse(root.dataset.routes!) as Record<string, number[][]>;
    /* Coarse height at a plan point, for keeping the camera off the rock. */
    const groundAt = (x: number, y: number) => {
      const tx = Math.min(N - 1.001, Math.max(0, (x + 4048) / (8000 / N) - 0.5));
      const ty = Math.min(N - 1.001, Math.max(0, (4326 - y) / (8000 / N) - 0.5));
      const i = Math.floor(ty), j = Math.floor(tx), fy = ty - i, fx = tx - j;
      const a = h[i * N + j], b = h[i * N + j + 1], c = h[(i + 1) * N + j], d = h[(i + 1) * N + j + 1];
      return (a * (1 - fx) + b * fx) * (1 - fy) + (c * (1 - fx) + d * fx) * fy;
    };
    /* A point on the Hörnligrat by fraction of the climb, hut = 0, top = 1. */
    const ridge = R.hornligrat;
    const ridgeAt = (f: number): V3 => {
      f = clamp01(f);
      let i = 1;
      while (i < ridge.length - 1 && ridge[i][3] < f) i++;
      const a = ridge[i - 1], b = ridge[i];
      const t = (f - a[3]) / Math.max(1e-6, b[3] - a[3]);
      return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
    };
    const keys = ['hornligrat', 'zmuttgrat'] as const;
    /* The orthophoto comes after the first frame: until it lands, a single
       neutral texel (flat structure, no snow) stands in. */
    const texO = gl.createTexture();
    gl.activeTexture(gl.TEXTURE3);
    gl.bindTexture(gl.TEXTURE_2D, texO);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([128, 0, 0, 255]));
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    const loadOrtho = async () => {
      const blob = await (await fetch(root.dataset.ortho!)).blob();
      const bmp = await createImageBitmap(blob, { colorSpaceConversion: 'none', premultiplyAlpha: 'none' });
      gl.activeTexture(gl.TEXTURE3);
      gl.bindTexture(gl.TEXTURE_2D, texO);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, bmp);
      kick();
    };

    const U = (n: string) => gl.getUniformLocation(prog, n);
    gl.uniform1i(U('H'), 0);
    gl.uniform1i(U('D'), 1);
    gl.uniform1i(U('O'), 3);
    const u = {
      res: U('res'), cam: U('cam'), fwd: U('fwd'), rgt: U('rgt'), up: U('up'), fov: U('fov'),
      sunDir: U('sunDir'), sunCol: U('sunCol'), zenCol: U('zenCol'), horCol: U('horCol'), ambCol: U('ambCol'),
      moonDir: U('moonDir'), moonCol: U('moonCol'), fillCol: U('fillCol'),
      stars: U('stars'), moonVis: U('moonVis'), moonPhase: U('moonPhase'), seed: U('seed'), dpr: U('dpr'),
    };

    /* ---- The routes as the menu ----------------------------------------- */
    /* Per route: how far up the line is drawn, and how strong. The intro
       climbs both once; after that a route rests as a faint trace, and climbs
       again in full when its name is pointed at. */
    const REST = 0.16;
    const rState = keys.map(() => ({ prog: 0, k: 0, hot: false, from: 0, at: 0 }));
    let introAt = Infinity;
    const isHot = (k: string) => !!root.querySelector(`.seg[data-seg="${k}"].hot`);
    const mo = new MutationObserver(() => {
      keys.forEach((k, i) => {
        const hot = isHot(k);
        const s = rState[i];
        if (hot && !s.hot) { s.from = 0; s.prog = 0; s.at = performance.now(); }
        s.hot = hot;
      });
      kick();
    });
    root.querySelectorAll('.seg').forEach((n) => mo.observe(n, { attributes: true, attributeFilter: ['class'] }));
    let level = root.dataset.level ?? 'root';
    let levelAt = 0;
    new MutationObserver(() => {
      const l = root.dataset.level ?? 'root';
      if (l !== level) { level = l; levelAt = performance.now(); kick(); }
    }).observe(root, { attributes: true, attributeFilter: ['data-level'] });

    /* ---- Time ------------------------------------------------------------ */
    const timeEl = root.querySelector<HTMLElement>('.lys-time')!;
    const dial = root.querySelector<HTMLElement>('.lys-dial');
    const mark = dial?.querySelector<HTMLElement>('.lys-mark');
    const nowDot = dial?.querySelector<HTMLElement>('.lys-now');
    if (dial) {
      const rs = riseSet(new Date());
      dial.querySelector<HTMLElement>('.lys-rise')!.style.setProperty('--x', String(Math.max(0, rs.rise)));
      dial.querySelector<HTMLElement>('.lys-set')!.style.setProperty('--x', String(Math.max(0, rs.set)));
    }

    /* Offset from the real clock, in minutes. The intro starts the day at the
       last midnight and runs it up to now; dragging moves the target. */
    const nowMin = zermattMinutes(new Date());
    let offset = still ? 0 : -nowMin;
    const minOf = (m: number) => Math.round((((m % 1440) + 1440) % 1440));
    /* The day's lights, as minutes of today in Zermatt: first light, noon,
       dusk (the evening minute the sun is just under the horizon — Alex's favourite,
       and the light the page opens on), and night. */
    const midnight = Date.now() - nowMin * 60000;
    const altAt = (m: number) => sunAt(new Date(midnight + m * 60000)).alt / rad;
    const crossing = (from: number, to: number, deg: number) => {
      for (let m = from; m !== to; m += from < to ? 2 : -2) if (altAt(m) < deg !== altAt(m + (from < to ? 2 : -2)) < deg) return m;
      return from;
    };
    let noon = 720;
    for (let m = 600, best = -99; m < 900; m += 4) { const a = altAt(m); if (a > best) { best = a; noon = m; } }
    const lights = [crossing(noon, 0, 1), noon, crossing(noon, 1438, -1), 23 * 60 + 15];
    const DUSK = lights[2];
    let target = DUSK - nowMin;
    /* `?t=06:40` pins the clock — for looking at one light on purpose. */
    const pin = new URLSearchParams(location.search).get('t')?.match(/^(\d{1,2}):(\d{2})$/);
    if (pin) target = Number(pin[1]) * 60 + Number(pin[2]) - nowMin;
    const shown = () => new Date(Date.now() + offset * 60000);

    /* Drag anywhere that is not a control: the screen's width is a day. The
       menu's rows are links and buttons, so they keep their clicks. */
    let dragX: number | null = null;
    let dragFrom = 0;
    let moved = false;
    document.addEventListener('pointerdown', (e) => {
      if (climb || e.button !== 0) return;
      if ((e.target as HTMLElement).closest('a, button, input, select, textarea, [role="dialog"], nav, header')) return;
      dragX = e.clientX;
      dragFrom = target;
      moved = false;
    });
    document.addEventListener('pointermove', (e) => {
      if (dragX === null) return;
      const dx = e.clientX - dragX;
      if (!moved && Math.abs(dx) < 4) return;
      moved = true;
      document.documentElement.classList.add('lys-drag');
      target = dragFrom + (dx / innerWidth) * 1440;
      kick();
    });
    const end = () => { dragX = null; document.documentElement.classList.remove('lys-drag'); };
    document.addEventListener('pointerup', end);
    document.addEventListener('pointercancel', end);
    root.querySelector('.lys-read')!.addEventListener('click', () => { target = 0; kick(); });
    /* The slider sets the minute of today; the light follows it faster than
       it follows a click, so it feels held. */
    /* The switch steps to the next of the day's lights, wrapping at night. */
    const skyBtn = root.querySelector<HTMLButtonElement>('.lys-sky');
    skyBtn?.addEventListener('click', () => {
      const cur = minOf(target + nowMin);
      const next = lights.find((m) => m > cur + 5) ?? lights[0];
      target = next - nowMin;
      kick();
    });
    const slide = root.querySelector<HTMLInputElement>('.lys-slide');
    let sliding = false;
    slide?.addEventListener('input', () => { sliding = true; target = Number(slide.value) - nowMin; kick(); });
    slide?.addEventListener('change', () => { sliding = false; });
    slide?.addEventListener('pointerup', () => { sliding = false; });

    /* ---- The climb ------------------------------------------------------- */
    /*
     * Keyframes: the Zermatt view, then the ridge from the hut to the top.
     * Each `[data-wp]` on the page is one keyframe, reached when that element
     * is centred in the viewport; between two of them the camera travels in a
     * Catmull–Rom curve, so it never stops dead at a waypoint.
     *
     * The camera flies the east-face side of the ridge — the face the morning
     * lights — a few hundred metres off and a little above, looking up the
     * line toward the top. Closer than that and the 2 m data starts to show
     * its grain; this is a helicopter shot, not a boot's.
     */
    const altEl = root.querySelector<HTMLElement>('.lys-alt');
    const wps = climb ? Array.from(document.querySelectorAll<HTMLElement>('[data-wp]')) : [];
    const foot = ridge[0];
    const dl = Math.hypot(foot[0], foot[1]);
    const along: V3 = [foot[0] / dl, foot[1] / dl, 0];
    const side: V3 = [along[1], -along[0], 0];
    const top = ridgeAt(1);
    type Key = { cam: V3; look: V3; alt: number };
    const keys3: Key[] = [];
    if (climb) {
      /*
       * A helicopter's flight, not a boot's: from 1.6 to 3.6 km off, rising
       * and swinging round the mountain — the east face at the hut, the north
       * face, the east face again, the top from the north-east. At this range
       * the 2 m data reads as a photograph; closer, it reads as data.
       * Cameras are kept as bearing / distance / height and interpolated so,
       * which keeps the path on a circle round the top instead of cutting a
       * chord through it.
       */
      const shots: [number, number, number, V3][] = [
        [52, 5300, 2900, [0, 0, 3880]],
        [74, 3600, 3450, [500, 250, 3800]],
        [18, 3000, 3850, [0, 0, 4050]],
        [2, 3300, 4000, [-350, 120, 3950]],
        [32, 3300, 4600, [0, 0, 4230]],
      ];
      const n = Math.max(1, wps.length - 1);
      for (let i = 0; i <= n; i++) {
        const sh = shots[Math.min(shots.length - 1, i)];
        const f = i === 0 ? 0 : n === 1 ? 1 : (i - 1) / (n - 1);
        keys3.push({ cam: [sh[0], sh[1], sh[2]], look: sh[3], alt: i === 0 ? 1608 : ridgeAt(f)[2] });
      }
    }
    const cr = (p0: number, p1: number, p2: number, p3: number, t: number) =>
      0.5 * (2 * p1 + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (-p0 + 3 * p1 - 3 * p2 + p3) * t * t * t);
    const along3 = (pick: (k: Key) => V3, u: number): V3 => {
      const n = keys3.length - 1;
      const i = Math.min(n - 1, Math.max(0, Math.floor(u)));
      const t = clamp01(u - i);
      const g = (j: number) => pick(keys3[Math.min(n, Math.max(0, j))]);
      const a = g(i - 1), b = g(i), c = g(i + 1), d = g(i + 2);
      return [0, 1, 2].map((k) => cr(a[k], b[k], c[k], d[k], t)) as V3;
    };
    /* Scroll → keyframe index, piecewise linear between the waypoints'
       centres. Measured on demand: content can change height as it loads. */
    let anchors: number[] = [];
    const measure = () => {
      anchors = wps.map((el) => {
        const r = el.getBoundingClientRect();
        return r.top + scrollY + r.height / 2 - innerHeight / 2;
      });
    };
    const uFromScroll = () => {
      if (anchors.length < 2) return 0;
      const y = scrollY;
      if (y <= anchors[0]) return 0;
      for (let i = 1; i < anchors.length; i++) {
        if (y <= anchors[i]) return i - 1 + (y - anchors[i - 1]) / Math.max(1, anchors[i] - anchors[i - 1]);
      }
      return anchors.length - 1;
    };
    let uT = 0, uS = 0, lastScrollAt = 0, pointing = false;
    if (climb) {
      measure();
      uT = uS = uFromScroll();
      let settleKick = 0;
      addEventListener('scroll', () => {
        uT = uFromScroll();
        lastScrollAt = performance.now();
        kick();
        /* A phone's scroll glides on after the finger lifts; look once more
           when it has come to rest, so he can turn and point. */
        clearTimeout(settleKick);
        settleKick = window.setTimeout(kick, 300);
      }, { passive: true });
      new ResizeObserver(() => { measure(); uT = uFromScroll(); kick(); }).observe(document.body);
    }

    /* ---- Camera ---------------------------------------------------------- */
    let px = 0, py = 0, pxT = 0, pyT = 0;
    addEventListener('pointermove', (e) => {
      pxT = (e.clientX / innerWidth - 0.5) * 2;
      pyT = (e.clientY / innerHeight - 0.5) * 2;
      kick();
    }, { passive: true });

    /*
     * TWO RESOLUTIONS. While anything moves, frames render at `scale` pixels
     * per CSS pixel (1.25 at most; slow frames step it down). The moment the
     * picture comes to rest, one more frame renders at the screen's full
     * density, so what you stop and look at is sharp, and what you scroll
     * through is smooth. The step-down never touches the still.
     */
    let scale = Math.min(devicePixelRatio || 1, 1.25);
    const hiScale = Math.min(devicePixelRatio || 1, 2);
    let wantHi = false, curScale = 0, settleT = 0;
    const resize = () => {
      const s = wantHi ? hiScale : scale;
      curScale = s;
      canvas.width = Math.max(2, Math.round(canvas.clientWidth * s));
      canvas.height = Math.max(2, Math.round(canvas.clientHeight * s));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    resize();
    let lastW = innerWidth;
    /* How much of the (large-viewport) canvas the browser's toolbar hides. */
    const gap = () => root.style.setProperty('--gap', Math.max(0, root.clientHeight - innerHeight).toFixed(0) + 'px');
    gap();
    addEventListener('resize', gap);
    addEventListener('resize', () => {
      /* A phone's address bar changes the height by a toolbar's worth on every
         scroll direction change; redrawing a full-screen ray-march for that is
         a stutter for nothing. Width changes are real. */
      if (!fine && innerWidth === lastW && climb) return;
      lastW = innerWidth;
      resize();
      kick();
    });

    const t0 = performance.now();
    let raf = 0, slow = 0, lastFrame = 0, lastDraw = 0, firstDrawn = false;
    let push = 0;
    const ease = (x: number) => 1 - Math.pow(1 - clamp01(x), 3);

    /* ---- The light switch's face ------------------------------------------ */
    /*
     * The icon follows the light that is shown, not the button's last press:
     * sun high; sun low with which way it is going; the sun under the line at
     * dawn and dusk; at night the moon — on the horizon with its direction
     * when it is rising or setting, as a crescent when it is up, and stars
     * when it is down.
     */
    const words = JSON.parse(root.dataset.skyWords ?? '{}') as Record<string, string>;
    const skyIc = root.querySelector<SVGSVGElement>('.lys-sky-ic');
    const skyW = root.querySelector<HTMLElement>('.lys-sky-w');
    const RAYS = (cy: number, n: number[], r0 = 6.5, r1 = 8.8) => n.map((a) => {
      const t = a * rad, c = Math.cos(t), s2 = Math.sin(t);
      return `<path d="M${(12 + c * r0).toFixed(1)} ${(cy - s2 * r0).toFixed(1)}L${(12 + c * r1).toFixed(1)} ${(cy - s2 * r1).toFixed(1)}"/>`;
    }).join('');
    /* Which way it is going: a small chevron in the top corner. */
    const UP = '<path d="M17.5 5.5l2-2 2 2"/>';
    const DOWN = '<path d="M17.5 3.5l2 2 2-2"/>';
    const MOON = (tx: number, ty: number, k: number) =>
      `<path vector-effect="non-scaling-stroke" transform="translate(${tx} ${ty}) scale(${k})" d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>`;
    const LOW = `<path d="M2.5 17h19"/><path d="M8 17a4 4 0 0 1 8 0"/>${RAYS(17, [30, 90, 150], 6, 8.2)}`;
    const TWI = '<path d="M2.5 13h19"/><path class="dim" d="M7 13a5 5 0 0 1 10 0"/><path class="dim" d="M6 17h12M9 21h6"/>';
    const MLOW = `<path d="M2.5 19h19"/>${MOON(4.6, 3.8, 0.62)}`;
    const ICONS: Record<string, string> = {
      day: `<circle cx="12" cy="12" r="4"/>${RAYS(12, [0, 45, 90, 135, 180, 225, 270, 315])}`,
      morning: LOW + UP,
      evening: LOW + DOWN,
      dawn: TWI + UP,
      dusk: TWI + DOWN,
      moon: MOON(0.5, 0.5, 0.92),
      moonrise: MLOW + UP,
      moonset: MLOW + DOWN,
      night: '<path class="f" d="M8 4.5l.8 2.2 2.2.8-2.2.8L8 10.5l-.8-2.2-2.2-.8 2.2-.8z"/><path class="f" d="M16 10l1 2.8 2.8 1-2.8 1L16 17.6l-1-2.8-2.8-1 2.8-1z"/><circle class="f" cx="7.5" cy="17.5" r="1.1"/>',
    };
    let skyState = '';

    /* ---- Shooting stars --------------------------------------------------- */
    /* Now and then on a dark night, one streak across the sky above the
       summit — the only part of the picture sure to be open sky. Played by the
       browser's animation engine, so the mountain is not redrawn for it. */
    let skyLine = innerHeight * 0.3;
    let night = 0;
    const meteor = root.querySelector<HTMLElement>('.lys-meteor');
    const shoot = () => {
      window.setTimeout(shoot, 4000 + Math.random() * 9000);
      if (!meteor || still || document.hidden || night < 0.7) return;
      const W = root.clientWidth;
      const room = skyLine - 70;
      if (room < 150) return;
      const len = 110 + Math.random() * 110;
      const dir = Math.random() < 0.5 ? -1 : 1;
      const ang = dir * (18 + Math.random() * 22);
      const x = W * (0.12 + Math.random() * 0.76), y = 90 + Math.random() * (room - 90);
      const run = 260 + Math.random() * 220;
      const a = ang * Math.PI / 180;
      const dx = Math.abs(Math.cos(a)) * run, dy = Math.abs(Math.sin(a)) * run;
      meteor.style.width = len + 'px';
      const rot = Math.atan2(dy, dir * dx) * 180 / Math.PI;
      meteor.animate([
        { transform: `translate(${x}px, ${y}px) rotate(${rot}deg) scaleX(0.2)`, opacity: 0 },
        { transform: `translate(${x + dir * dx * 0.35}px, ${y + dy * 0.35}px) rotate(${rot}deg) scaleX(1)`, opacity: 0.9, offset: 0.35 },
        { transform: `translate(${x + dir * dx}px, ${y + dy}px) rotate(${rot}deg) scaleX(0.6)`, opacity: 0 },
      ], { duration: 650 + Math.random() * 350, easing: 'cubic-bezier(0.3, 0, 0.7, 1)' });
    };
    window.setTimeout(shoot, 2500);
    const paintSky = (date: Date, sunAlt: number, moon: { alt: number }) => {
      if (!skyIc || !skyW) return;
      const later = new Date(date.valueOf() + 10 * 60000);
      const rising = sunAt(later).alt / rad > sunAlt;
      let k: string;
      if (sunAlt > 10) k = 'day';
      else if (sunAlt > 0) k = rising ? 'morning' : 'evening';
      else if (sunAlt > -8) k = rising ? 'dawn' : 'dusk';
      else {
        const ma = moon.alt / rad;
        const up = moonAt(later).alt / rad > ma;
        k = ma > 6 ? 'moon' : ma > -2 ? (up ? 'moonrise' : 'moonset') : 'night';
      }
      if (k === skyState) return;
      skyState = k;
      skyIc.innerHTML = ICONS[k];
      skyW.textContent = words[k] ?? k;
    };

    const frame = (now: number) => {
      raf = 0;
      const dt = Math.min(0.1, (now - (lastFrame || now)) / 1000);
      lastFrame = now;

      const k = 1 - Math.exp(-dt * (dragX === null && !sliding ? 2.4 : 10));
      offset += (target - offset) * (still ? 1 : k);
      if (Math.abs(target - offset) < 0.5) offset = target;
      px += (pxT - px) * (1 - Math.exp(-dt * 2));
      py += (pyT - py) * (1 - Math.exp(-dt * 2));
      const pushT = level === 'work' ? 1 : 0;
      push += (pushT - push) * (still ? 1 : 1 - Math.exp(-dt * 1.6));

      /* Routes. */
      let busy = Math.abs(target - offset) > 0.01 || Math.abs(pushT - push) > 0.002;
      if (climb) {
        uS += (uT - uS) * (still ? 1 : 1 - Math.exp(-dt * 9));
        if (Math.abs(uT - uS) < 0.002) uS = uT;
        else busy = true;
        walk(uS !== uT && !still && !pointing);
      }
      if (!climb) rState.forEach((s) => {
        if (s.hot) {
          s.prog = still ? 1 : ease((now - s.at) / 900);
          s.k += (1 - s.k) * (1 - Math.exp(-dt * 12));
        } else if (now >= introAt) {
          const it = (now - introAt) / 2600;
          if (it < 1) { s.prog = ease(it); s.k = 0.6; }
          else {
            s.prog = 1;
            s.k += (REST - s.k) * (1 - Math.exp(-dt * 2.2));
          }
        }
        if (s.hot ? s.prog < 1 : (now >= introAt && Math.abs(s.k - REST) > 0.005)) busy = true;
        if (s.hot && Math.abs(1 - s.k) > 0.005) busy = true;
      });

      /* Idle drift redraws at ~24 fps; anything moving on purpose at full. */
      /* The drift is the only motion nobody asked for, so only a desk gets it:
         on a phone it would keep the GPU warm for nothing. Climbing, the
         scroll is the motion. */
      const animate = !still && !climb && fine;
      if (Math.abs(pxT - px) > 0.002 || Math.abs(pyT - py) > 0.002) busy = true;
      if (!busy && !wantHi && firstDrawn && now - lastDraw < 41) { if (animate) kick(); return; }
      lastDraw = now;
      if (busy || animate) wantHi = false;
      if (curScale !== (wantHi ? hiScale : scale)) resize();

      const el = (now - t0) / 1000;
      const portrait = canvas.clientHeight > canvas.clientWidth;
      /* Bearing from the summit to the camera: 52° is the Zermatt side. Going
         to the work level pushes in and swings toward the Hörnligrat. */
      const drift = still ? 0 : Math.sin((el / 100) * Math.PI * 2) * 4;
      let cam: number[], look: number[];
      if (climb) {
        const pc = along3((k) => k.cam, uS);
        const c: V3 = [Math.sin(pc[0] * rad) * pc[1], Math.cos(pc[0] * rad) * pc[1], pc[2]];
        look = along3((k) => k.look, uS);
        /* Parallax: a few metres sideways with the pointer, never into rock. */
        c[0] += side[0] * px * 40; c[1] += side[1] * px * 40; c[2] -= py * 20;
        if (portrait) { const back = 1.25; c[0] = look[0] + (c[0] - look[0]) * back; c[1] = look[1] + (c[1] - look[1]) * back; }
        c[2] = Math.max(c[2], groundAt(c[0], c[1]) + 90);
        cam = c;
        /* The line runs ahead of the camera, up to where it is looking: drawn
           only behind it, nobody would ever see it. */
        /* Paced so the first point lights early (Alex: «litt treg»): the line
           is at the top a little past halfway. */
        const last = keys3.length - 1;
        rState[0].prog = Math.max(0.004, Math.min(1, uS / Math.max(1, last - 1.8)));
        rState[0].k = 0.95;
        /* Then down the other side: from the top, he skis the Zmuttgrat and
           its line is drawn behind him, from the summit down. */
        rState[1].prog = clamp01((uS - (last - 1.8)) / 1.8);
        rState[1].k = rState[1].prog > 0 ? 0.95 : 0;
        if (altEl) {
          const i = Math.min(keys3.length - 2, Math.floor(uS));
          const t = clamp01(uS - i);
          const alt = keys3[i].alt + (keys3[i + 1].alt - keys3[i].alt) * t;
          altEl.textContent = `${Math.round(alt).toLocaleString('nb-NO')} m`;
        }
      } else {
        const bear = (52 + drift + px * 2.5 + push * 6) * rad;
        const dist = (portrait ? 6400 : 5300) * (1 - push * 0.2);
        cam = [Math.sin(bear) * dist, Math.cos(bear) * dist, 2900 - py * 50 + push * 120];
        look = [push * 150, push * 120, (portrait ? 3600 : 3880) + push * 80];
      }
      const f = look.map((v, i) => v - cam[i]);
      const fl = Math.hypot(...f);
      const fwd = f.map((v) => v / fl);
      const r0 = [fwd[1], -fwd[0], 0];
      const rl = Math.hypot(...r0);
      const rgt = r0.map((v) => v / rl);
      const up = [rgt[1] * fwd[2] - rgt[2] * fwd[1], rgt[2] * fwd[0] - rgt[0] * fwd[2], rgt[0] * fwd[1] - rgt[1] * fwd[0]];

      const date = shown();
      const sun = sunAt(date);
      const L = lightFor(sun.alt / rad);
      const moon = moonAt(date);
      const ML = moonFor(sun.alt / rad, moon);

      gl.uniform2f(u.res, canvas.width, canvas.height);
      gl.uniform3fv(u.cam, cam);
      gl.uniform3fv(u.fwd, fwd);
      gl.uniform3fv(u.rgt, rgt);
      gl.uniform3fv(u.up, up);
      /* Climbing, the first screen is the wide one — the whole valley's sky —
         and the lens closes to the climb's as the first stretch is scrolled. */
      const wide = climb ? 1 - ss(0, 1, uS) : 0;
      const fovDeg = (portrait ? 46 : climb ? 38 : 33) + wide * (portrait ? 12 : 16);
      gl.uniform1f(u.fov, fovDeg * rad);
      gl.uniform3fv(u.sunDir, sun.dir);
      gl.uniform3fv(u.sunCol, L.sun);
      gl.uniform3fv(u.zenCol, L.zen);
      gl.uniform3fv(u.horCol, L.hor);
      gl.uniform3fv(u.ambCol, L.amb);
      gl.uniform3fv(u.moonDir, moon.dir);
      gl.uniform3fv(u.moonCol, ML.moon);
      gl.uniform3fv(u.fillCol, ML.fill);
      gl.uniform1f(u.stars, L.stars);
      night = L.stars;
      const lit = (0.42 + 0.58 * ss(-8, 12, sun.alt / rad)).toFixed(3);
      climber?.style.setProperty('--lit', lit);
      root.querySelector<HTMLElement>('.lys-spray')?.style.setProperty('--lit', lit);
      gl.uniform1f(u.moonVis, ss(-0.6, 1.5, moon.alt / rad));
      gl.uniform1f(u.moonPhase, moon.lit);
      gl.uniform1f(u.dpr, curScale);
      gl.uniform1f(u.seed, (el * 7.3) % 100);

      gl.drawArrays(gl.TRIANGLES, 0, 3);
      drawRoutes(cam, fwd, rgt, up, fovDeg * rad);

      timeEl.textContent = zermattClock(date);
      /* The switch names the light the sky is heading to, not each minute
         it sweeps through on the way. */
      if (Math.abs(target - offset) < 1) paintSky(date, sun.alt / rad, moon);
      else { const to = new Date(Date.now() + target * 60000); paintSky(to, sunAt(to).alt / rad, moonAt(to)); }
      if (mark) mark.style.setProperty('--x', (((zermattMinutes(date) % 1440) + 1440) % 1440 / 1440).toFixed(4));
      if (nowDot) nowDot.style.setProperty('--x', (zermattMinutes(new Date()) / 1440).toFixed(4));
      root.classList.toggle('away', Math.abs(target) > 1);
      if (slide && document.activeElement !== slide) slide.value = String(minOf(target + nowMin));

      if (!firstDrawn) {
        firstDrawn = true;
        requestAnimationFrame(() => root.classList.add('ready'));
        loadOrtho().catch(() => {});
        introAt = now + (still ? 0 : 2200);
      }

      if (!wantHi) {
        if (dt > 0.05) slow++; else slow = Math.max(0, slow - 1);
        if (slow > 3 && scale > 0.6) { scale *= 0.85; slow = 0; resize(); }
      }

      if (animate || busy) {
        kick();
        clearTimeout(settleT);
        settleT = window.setTimeout(() => { wantHi = true; kick(); }, 180);
      }
    };
    /*
     * THE ROUTES, as vector lines over the picture. Each crest point is
     * projected with the shader's own camera, and checked for a clear line of
     * sight back to the camera through the coarse heights: where nearer rock
     * stands in front, the line breaks. Painted on the terrain instead, a line
     * on a crest has nowhere to go where the crest is the skyline.
     */
    const svg = root.querySelector<SVGSVGElement>('.lys-route')!;
    const lines = [...svg.querySelectorAll<SVGPathElement>('.lys-line')];
    const glows = [...svg.querySelectorAll<SVGPathElement>('.lys-glow')];
    const tips = [...svg.querySelectorAll<SVGCircleElement>('.lys-tip')];
    const climber = root.querySelector<HTMLElement>('.lys-climber');
    const climberSvg = climber?.querySelector<SVGSVGElement>('.c-up');
    climberSvg?.pauseAnimations();
    let walking = false;
    let prevHead: number[] | null = null, prevT = 0, prevTilt = 0, wasAir = false, landAt = -1e9;
    /* Where the switch, the slider and the read-out sit, measured on resize. */
    let instruments: DOMRect[] = [];
    const measureInstruments = () => { instruments = [...root.querySelectorAll<HTMLElement>('.lys-sky, .lys-dial, .lys-read')].map((e) => e.getBoundingClientRect()); };
    addEventListener('resize', measureInstruments);
    setTimeout(measureInstruments, 0);
    const sprayEl = root.querySelector<HTMLElement>('.lys-spray');
    let lastPuff = 0;
    /* Snow off the tails: grains thrown back and up that fall again, and
       now and then a soft cloud of powder that hangs and spreads. More of
       both the faster he goes. */
    const puff = (x: number, y: number, vx: number, vy: number, sz: number, ms: number, cloud = false) => {
      if (!sprayEl) return;
      const el = document.createElement('i');
      if (cloud) el.className = 'c';
      sprayEl.appendChild(el);
      const fall = cloud ? -4 : 10 + Math.random() * 10;
      el.animate([
        { transform: `translate(${x}px, ${y}px) scale(${sz})`, opacity: cloud ? 0.26 : 0.9 },
        { transform: `translate(${x + vx * 0.55}px, ${y + vy * 0.55}px) scale(${sz * (cloud ? 2 : 1.1)})`, opacity: cloud ? 0.18 : 0.7, offset: 0.45 },
        { transform: `translate(${x + vx}px, ${y + vy + fall}px) scale(${sz * (cloud ? 3.2 : 0.7)})`, opacity: 0 },
      ], { duration: ms, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)' }).onfinish = () => el.remove();
    };
    let puffs = 0;
    function spray(at: number[], from: number[], now: number, speed: number) {
      if (!sprayEl || still || now - lastPuff < 40 || sprayEl.childElementCount > 110) return;
      lastPuff = now;
      const dx = at[0] - from[0], dy = at[1] - from[1];
      const L = Math.hypot(dx, dy) || 1;
      const bx = -dx / L, by = -dy / L;
      const k = Math.min(1.6, 0.5 + speed / 400);
      const x0 = at[0] + bx * 7, y0 = at[1] + by * 7 - 1;
      for (let n = 0, N = Math.round(4 + 4 * k); n < N; n++) {
        const d = (8 + Math.random() * 26) * k, up = (6 + Math.random() * 18) * k;
        puff(x0 + Math.random() * 4 - 2, y0 + Math.random() * 2, bx * d, by * d - up, 0.12 + Math.random() * 0.22, 300 + Math.random() * 320);
      }
      if (++puffs % 2 === 0) puff(x0, y0 - 2, bx * 12 * k, by * 12 * k - 5, 0.5 + Math.random() * 0.5, 1000 + Math.random() * 500, true);
    }
    /* Landing the flip: snow thrown out on both sides, and a cloud. */
    function burst(at: number[], amount = 1) {
      if (still) return;
      for (let n = 0; n < 26 * amount; n++) {
        const side = n % 2 ? 1 : -1, d = 8 + Math.random() * 30, up = 8 + Math.random() * 24;
        puff(at[0] + side * 4, at[1] - 1, side * d, -up, 0.14 + Math.random() * 0.26, 450 + Math.random() * 350);
      }
      puff(at[0], at[1] - 3, -8, -6, 1, 1300, true);
      puff(at[0], at[1] - 3, 8, -6, 0.9, 1200, true);
    }
    /* The legs move only while the page does. */
    let stoppedAt = 0;
    function walk(on: boolean) {
      if (!climberSvg || on === walking) return;
      walking = on;
      if (on) climberSvg.unpauseAnimations(); else climberSvg.pauseAnimations();
      /* Stopped: in a moment he may turn and point; draw once more then. */
      if (!on) { stoppedAt = performance.now(); setTimeout(kick, 300); }
    }
    /* The first rock between a point and the camera: null when the view is
       clear, else where the ray first hits. */
    const blocker = (P: number[], cam: number[]) => {
      const d = [cam[0] - P[0], cam[1] - P[1], cam[2] - P[2]];
      const L = Math.hypot(d[0], d[1], d[2]);
      /* Steps no longer than a few cells of the height grid, so a thin
         ridge in between is never stepped over (a growing step did, and the
         line showed through the rock). */
      const end = Math.min(L, 7000);
      for (let s = 12; s < end; s += Math.min(24, Math.max(6, s * 0.04))) {
        const x = P[0] + (d[0] / L) * s, y = P[1] + (d[1] / L) * s, z = P[2] + (d[2] / L) * s;
        if (z > 4490) return null;
        const g = groundAt(x, y);
        if (g > z + 4) return { s, at: [x, y, g] };
      }
      return null;
    };
    const seen = (P: number[], cam: number[]) => !blocker(P, cam);
    /* The traced line can sit a few metres off the true crest, on the far
       side of it. Hidden by its own ridge — rock within 60 m — it is drawn on
       the crest that hides it, which is the skyline the eye reads as the
       ridge. Hidden by another ridge, it is hidden. */
    const onRidge = (P: number[], cam: number[]) => {
      const b = blocker(P, cam);
      if (!b) return P;
      if (b.s >= 60) return null;
      /* The crest it snaps to must itself be in sight; otherwise the snap
         puts the line on rock behind the mountain, seen through it. */
      const Q = [b.at[0], b.at[1], b.at[2] + 3];
      return seen(Q, cam) ? Q : null;
    };
    const pointOn = (key: string, f: number) => {
      const pts = R[key];
      f = clamp01(f);
      let i = 1;
      while (i < pts.length - 1 && pts[i][3] < f) i++;
      const a = pts[i - 1], b = pts[i];
      const t = (f - a[3]) / Math.max(1e-6, b[3] - a[3]);
      return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t + 3];
    };
    const marks = [...root.querySelectorAll<HTMLElement>('.mk')].map((el) => ({
      el,
      id: el.dataset.id!,
      route: el.dataset.route!,
      f: Number(el.dataset.f),
      side: el.dataset.side!,
      w: 0,
      lw: 0,
      label: el.querySelector<HTMLElement>('.mk-label')!,
    }));
    for (const m of marks) {
      m.el.addEventListener('click', () => {
        if (m.el.dataset.open === 'false') return;
        root.classList.add('opened');
        document.dispatchEvent(new CustomEvent('lys:open', { detail: { id: m.id, from: m.el } }));
      });
    }
    function drawRoutes(cam: number[], fwd: number[], rgt: number[], up: number[], fov: number) {
      const W = canvas!.clientWidth, Hh = canvas!.clientHeight;
      svg.setAttribute('viewBox', `0 0 ${W} ${Hh}`);
      const tf = Math.tan(fov / 2), asp = W / Hh;
      const proj = (P: number[]) => {
        const d = [P[0] - cam[0], P[1] - cam[1], P[2] - cam[2]];
        const zf = d[0] * fwd[0] + d[1] * fwd[1] + d[2] * fwd[2];
        if (zf < 5) return null;
        const qx = (d[0] * rgt[0] + d[1] * rgt[1] + d[2] * rgt[2]) / zf;
        const qy = (d[0] * up[0] + d[1] * up[1] + d[2] * up[2]) / zf;
        return [(qx / (asp * 2 * tf) + 0.5) * W, (0.5 - qy / (2 * tf)) * Hh];
      };
      skyLine = proj([0, 0, 4478])?.[1] ?? Hh * 0.3;
      const heads: { last: number[] | null; before: number[] | null; on: boolean }[] = [];
      keys.forEach((key, r) => {
        const st = rState[r];
        heads[r] = { last: null, before: null, on: false };
        if (st.k < 0.004 || st.prog <= 0) {
          lines[r].setAttribute('d', ''); glows[r].setAttribute('d', ''); tips[r].style.opacity = '0';
          return;
        }
        /* Climbing, the Zmuttgrat runs top-down: same loop, the points in
           reverse and their fractions flipped. */
        const down = climb && r === 1;
        const pts = down ? R[key].map((p) => [p[0], p[1], p[2], 1 - p[3]]).reverse() : R[key];
        let d = '', pen = false, last: number[] | null = null, before: number[] | null = null;
        const xy = (q: number[]) => q[0].toFixed(1) + ' ' + q[1].toFixed(1);
        for (let i = 0; i < pts.length; i++) {
          let P = [pts[i][0], pts[i][1], pts[i][2] + 2];
          const f = pts[i][3];
          if (f > st.prog) {
            if (i === 0) break;
            const a = pts[i - 1], t = (st.prog - a[3]) / Math.max(1e-6, f - a[3]);
            P = [a[0] + (P[0] - a[0]) * t, a[1] + (P[1] - a[1]) * t, a[2] + 2 + (P[2] - a[2] - 2) * t];
          }
          const q = proj(P);
          const V = q && onRidge(P, cam);
          let qv = V && proj(V);
          /* Snapped to the crest that hides it only when that crest is right
             there on screen; a jump of more than a few pixels is another
             ridge in front, and the line is hidden there instead of spiking.
             (A dotted line through the rock was tried: it read as a bug.) */
          if (qv && q && V !== P && Math.hypot(qv[0] - q[0], qv[1] - q[1]) > 7) qv = null;
          if (qv) { d += (pen ? 'L' : 'M') + xy(qv); pen = true; if (last && Math.hypot(qv[0] - last[0], qv[1] - last[1]) > 2) before = last; last = qv; }
          else pen = false;
          if (f > st.prog) break;
        }
        lines[r].setAttribute('d', d);
        glows[r].setAttribute('d', d);
        lines[r].style.opacity = String(Math.min(1, st.k));
        glows[r].style.opacity = String(0.16 * Math.min(1, st.k));
        const climbing = st.prog < 0.999 && last;
        tips[r].style.opacity = climbing && !climber ? String(Math.min(1, st.k)) : '0';
        heads[r] = { last, before, on: !!last && st.prog < 0.999 };
        if (last) { tips[r].setAttribute('cx', last[0].toFixed(1)); tips[r].setAttribute('cy', last[1].toFixed(1)); }
      });

      /* The figure: climbing at the head of the Hörnli line, standing on the
         top between the two, skiing at the head of the Zmutt line. */
      if (climber) {
        /* Once he has started down he stays on skis, to the foot of the line. */
        const descending = rState[1].prog > 0;
        const sk = !!heads[1]?.last, up = heads[0];
        const h = sk ? heads[1] : up;
        /* Behind the mountain on the way down, he is out of sight. */
        climber.classList.toggle('on', !!h?.last && (sk || (!descending && !!up?.last)));
        climber.classList.toggle('ski', !!sk);
        /* The little cliff just under the top, as a jump: from the lip he
           leaves the line and flies a real arc — up first, well clear of the
           rock — over to where the line lands, further down. The flip turns
           in the middle of the flight and is done before he comes down, so
           he lands looking at his landing. All driven by the scroll: a slow
           scroll is a slow-motion jump. */
        const LIP = 0.04, LAND = 0.46;
        const fl = sk ? clamp01((rState[1].prog - LIP) / (LAND - LIP)) : 0;
        const air = fl > 0 && fl < 1;
        let flight: number[] | null = null;
        if (air) {
          /* A thrown body: steady across, a parabola up and down, landing
             where the line already runs on the way he is going — so there
             is nothing sideways to steer back, he just keeps going. */
          const A = proj(pointOn('zmuttgrat', 1 - LIP)), B = proj(pointOn('zmuttgrat', 1 - LAND));
          if (A && B) {
            const hi = Math.min(40 + Math.abs(B[1] - A[1]) * 0.22, 120, Hh * 0.16);
            flight = [A[0] + (B[0] - A[0]) * fl, A[1] + (B[1] - A[1]) * fl * fl - hi * 4 * fl * (1 - fl) * (1 - fl * 0.5)];
            climber.style.setProperty('--face', B[0] < A[0] ? '-1' : '1');
            climber.style.setProperty('--tilt', '0deg');
          }
        }
        const at = flight ?? h?.last;
        if (at) climber.style.transform = `translate(${at[0].toFixed(1)}px, ${at[1].toFixed(1)}px)`;
        if (h?.last && !flight) {
          if (h.before) {
            const dx = h.last[0] - h.before[0], dy = h.last[1] - h.before[1];
            const face = dx < 0 ? -1 : 1;
            climber.style.setProperty('--face', String(face));
            const tilt = Math.max(-35, Math.min(35, (Math.atan2(dy, Math.abs(dx)) * 180) / Math.PI));
            climber.style.setProperty('--tilt', (sk ? tilt : 0).toFixed(1) + 'deg');
          }
        }
        /* The little cliff just under the top: a backflip off it — driven by the scroll
           like everything else, so a slow scroll is a slow-motion flip. */
        /* Pop and a slight lean back off the lip, the rotation through the
           top of the arc, then upright for the last third: spotting it. */
        const rk = clamp01((fl - 0.14) / 0.56);
        const fk = rk * rk * (3 - 2 * rk);
        const pop = air ? 10 * Math.sin(Math.PI * clamp01(fl / 0.14)) * (fl < 0.14 ? 1 : 0) - 8 * Math.sin(Math.PI * clamp01((fl - 0.72) / 0.28)) : 0;
        climber.style.setProperty('--flip', (-360 * fk - pop).toFixed(1) + 'deg');
        climber.style.setProperty('--lift', '0px');
        climber.classList.toggle('air', air && fl > 0.1 && fl < 0.82);
        climber.classList.toggle('hint', uS < 0.02 && !still);
        const t = performance.now();
        /* How fast he goes, and how fast the line under him bends. */
        let speed = 0, turn = 0;
        if (h?.last && prevHead && t > prevT) {
          const ds = Math.hypot(h.last[0] - prevHead[0], h.last[1] - prevHead[1]);
          speed = ds / ((t - prevT) / 1000);
          const tl = parseFloat(climber.style.getPropertyValue('--tilt')) || 0;
          turn = (tl - prevTilt) / ((t - prevT) / 1000);
          prevTilt = tl;
        }
        prevHead = h?.last ?? null;
        prevT = t;
        if (sk) {
          const going = walking && !air && speed > 4;
          if (wasAir && fl >= 1 && h?.last) { burst(h.last); landAt = t; setTimeout(kick, 380); }
          if (!wasAir && air && fl < 0.2) { const A = proj(pointOn('zmuttgrat', 1 - LIP)); if (A) burst(A, 0.5); }
          wasAir = air;
          const landing = t - landAt < 340;
          /* Low when fast, lower through a change of slope, lowest on landing. */
          const crouch = landing ? 0.68 : going ? Math.max(0.78, 0.92 - speed / 4000 - Math.min(0.08, Math.abs(turn) / 2500)) : 1;
          const lean = going ? Math.max(-6, Math.min(16, 6 + speed / 120 - turn / 60)) : landing ? 10 : 0;
          climber.style.setProperty('--crouch', crouch.toFixed(3));
          climber.style.setProperty('--lean', lean.toFixed(1) + 'deg');
          if (going && h?.last && h.before) spray(h.last, h.before, t, speed);
        }
        /* At the foot of the screen the instruments stand in front of him. */
        if (h?.last) {
          const [x, y] = h.last;
          climber.classList.toggle('under', instruments.some((r) => x > r.left - 20 && x < r.right + 20 && y > r.top - 10 && y < r.bottom + 44));
        }
      }

      /* The points, with the same camera and the same line of sight. */
      let newest: HTMLElement | null = null;
      const seenMarks: number[][] = [];
      for (const m of marks) {
        const P = m.route === 'top' ? [0, 0, 4478 + 6] : pointOn(m.route, m.f);
        const st = m.route === 'top' ? null : rState[keys.indexOf(m.route)];
        const reach = climb && m.route === 'zmuttgrat' ? 1 - m.f : m.f;
        const lit = climb && (m.route === 'top' || (!!st && st.k > 0.01 && st.prog >= reach));
        const s2 = lit && seen(P, cam) ? proj(P) : null;
        const on = !!s2 && s2[0] > 6 && s2[0] < W - 6 && s2[1] > 6 && s2[1] < Hh - 6;
        /* The point he is nearest along the route, passed within a stretch,
           is the one he turns to. Only a lit one: pointing at bare rock
           says nothing. */
        const since = st ? st.prog - reach : 9;
        if (on && m.route !== 'top' && since <= 0.32) seenMarks.push([s2![0], s2![1], since]);
        if (s2) {
          m.el.style.transform = `translate(${s2[0].toFixed(1)}px, ${s2[1].toFixed(1)}px)`;
          /* A name that would run off the screen — a phone, a ridge near the
             edge — hangs on the other side of its point instead. */
          /* Too narrow for either side: it stands over its point, like the
             summit's, held inside the screen. */
          let side = m.side;
          if (side !== 'up') {
            m.w ||= m.el.offsetWidth;
            const room = side === 'left' ? s2[0] - 12 : W - 12 - s2[0];
            const other = side === 'left' ? W - 12 - s2[0] : s2[0] - 12;
            if (m.w > room) side = m.w <= other ? (side === 'left' ? 'right' : 'left') : 'up';
          }
          m.el.dataset.side = side;
          if (side === 'up') {
            m.lw ||= m.label.offsetWidth;
            const half = m.lw / 2;
            const nx = Math.max(0, 12 - (s2[0] - half)) - Math.max(0, s2[0] + half - (W - 12));
            m.label.style.translate = nx ? `${nx.toFixed(1)}px 0` : '';
          } else m.label.style.translate = '';
        }
        if (on && !m.el.classList.contains('on')) {
          m.el.classList.add('pulse');
          window.setTimeout(() => m.el.classList.remove('pulse'), 3000);
        }
        m.el.classList.toggle('on', on);
        m.el.tabIndex = on ? 0 : -1;
        if (on && m.route !== 'top') newest = m.el;
      }
      for (const m of marks) m.el.classList.toggle('now', m.el === newest || (m.route === 'top' && m.el.classList.contains('on')));
      /* A pause by a point: stopped for a moment, not in the air, a point
         just passed — he turns to it and points, however far up the screen
         the camera has put it. */
      if (climber) {
        const t = climber.style.transform.match(/translate\(([-\d.]+)px, ([-\d.]+)px\)/);
        let aim: number[] | null = null;
        /* Stopped means the finger has let go — not the camera's easing
           finishing, which trails it by most of a second. */
        if (t && performance.now() - lastScrollAt > 260 && Math.abs(uT - uS) < 0.04 && !climber.classList.contains('air') && climber.classList.contains('on')) {
          const cx = Number(t[1]), cy = Number(t[2]) - 22;
          let best = Infinity;
          for (const q of seenMarks) {
            if (q[2] < best) { best = q[2]; aim = [q[0] - cx, q[1] - cy]; }
          }
        }
        pointing = !!aim;
        climber.classList.toggle('point', pointing);
        if (aim) {
          const face = aim[0] < 0 ? -1 : 1;
          climber.style.setProperty('--face', String(face));
          climber.style.setProperty('--tilt', '0deg');
          const deg = (Math.atan2(aim[1], Math.abs(aim[0])) * 180) / Math.PI;
          climber.style.setProperty('--aim', Math.max(-80, Math.min(70, deg)).toFixed(1) + 'deg');
        }
      }
      /* Two names on top of each other read as neither. The summit wins, then
         the newest point; the other keeps its dot and drops its name. */
      const rank = (m: (typeof marks)[number]) => (m.route === 'top' ? 2 : m.el === newest ? 1 : 0);
      const shown = marks.filter((m) => m.el.classList.contains('on')).sort((a, b) => rank(b) - rank(a));
      const kept: DOMRect[] = [];
      for (const m of shown) {
        let b = m.label.getBoundingClientRect();
        const clash = (b: DOMRect) => kept.some((k) => b.left < k.right + 6 && b.right > k.left - 6 && b.top < k.bottom + 4 && b.bottom > k.top - 4);
        let hit = clash(b);
        /* Before it goes quiet, a name tries the other side of its point,
           then over it, held inside the screen. */
        const side = m.el.dataset.side!, was = m.label.style.translate;
        for (const alt of ['left', 'right', 'up'].filter((x) => x !== side)) {
          if (!hit) break;
          m.el.dataset.side = alt;
          m.label.style.translate = '';
          let nb = m.label.getBoundingClientRect();
          if (alt === 'up') {
            const nx = Math.max(0, 12 - nb.left) - Math.max(0, nb.right - (W - 12));
            if (nx) { m.label.style.translate = `${nx.toFixed(1)}px 0`; nb = m.label.getBoundingClientRect(); }
          }
          if (!clash(nb) && nb.left > 6 && nb.right < W - 6 && nb.top > 6) { hit = false; b = nb; }
        }
        if (hit) { m.el.dataset.side = side; m.label.style.translate = was; }
        m.el.classList.toggle('quiet', hit);
        if (!hit) kept.push(b);
      }
      for (const m of marks) if (!m.el.classList.contains('on')) m.el.classList.remove('quiet');
    }

    const kick = () => { if (!raf && !document.hidden) raf = requestAnimationFrame(frame); };
    document.addEventListener('visibilitychange', kick);
    setInterval(kick, 60000);
    kick();
  }

  start().catch((err) => {
    console.error(err);
    root?.classList.add('ready', 'failed');
  });
</script>
