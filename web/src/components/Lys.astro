  .lys-fallback {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lys.failed .lys-fallback { display: block; }
  .lys.lost .lys-gl, .lys.lost .lys-route, .lys.lost .lys-climber, .lys.lost .lys-spray, .lys.lost .lys-marks { visibility: hidden; }
  .lys.failed .lys-read,
  .lys.failed .lys-dial { display: none; }

  /* The readout. Mono, lowercase, a place and a time. Signal-coloured when
     the shown time is not now — the only moment it is worth clicking. */
  .lys-read {
    position: absolute;
    right: clamp(20px, 4vw, 56px);
    bottom: clamp(44px, 7vh, 72px);
    display: flex;
    gap: 1.2em;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-inst);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--fg3);
    cursor: default;
    pointer-events: auto;
    opacity: 0;
    transition: opacity 900ms linear 1400ms, color 200ms linear;
  }
  .lys.ready .lys-read { opacity: 1; }
  /* Climbing, the readout is an altimeter and nothing to click. */
  .lys[data-mode='climb'] .lys-read { pointer-events: none; bottom: var(--foot); }
  /* The canvas is the LARGE viewport, so on a phone its bottom edge sits under
     the browser's toolbar. The controls measure from what is visible instead:
     `--gap` is how much of the canvas the toolbar covers (set from script),
