      <g class="pt" style="transform-origin: 12.6px 9.5px"><path d="M12.6 9.5L21.4 9.5" stroke="#a68c5e" stroke-width="2.8"/><path d="M21.8 9.5l0.01 0" stroke="#1b1c20" stroke-width="2.6"/><path d="M22.8 9.5l2 0" stroke="#e6c3a5" stroke-width="1.1"/></g>
      </g>
    </svg>
<svg class="c-ski" viewBox="0 -4 24 36" overflow="visible" width="22" height="33" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {/* Freeride stance: low, hands forward, the weight over the front of
          wide skis. Legs and upper body are separate so the legs can take
