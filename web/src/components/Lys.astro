      <path d="M6 4.6L-1.4 9.6" stroke="#6f757d" stroke-width="0.9"/>
      <path d="M6 4.6l0.01 0" stroke="#1b1c1a" stroke-width="2.3"/>
      <path d="M12.6 18.4L13.6 9.6" stroke="#b39a6b" stroke-width="6.2"/>
      <path d="M14.6 17.8L15.4 10" stroke="#d6c08f" stroke-width="1.6"/>
      <path d="M10.8 17.6L11.6 10" stroke="#8f784f" stroke-width="1.1"/>
      <path d="M13 18.4L18.4 17.2L15.4 23.2" stroke="#4a4e45" stroke-width="3.8"/>
      <path d="M17.6 18L15.8 21.8" stroke="#5f6458" stroke-width="0.9"/>
      <path d="M14.4 23.4l2.6 0.4" stroke="#151614" stroke-width="2.3"/>
      <path d="M2.6 28.6L24 20.2Q26.2 19.4 26.2 17.4" stroke="#2b2b2b" stroke-width="2.4"/>
