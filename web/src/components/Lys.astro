        <path d="M12.8 19.4L16.6 11.4" stroke="#d6c08f" stroke-width="1.6"/>
        <path d="M9 19.2L12.8 11.2" stroke="#8f784f" stroke-width="1.1"/>
        <path d="M9.6 17.8l3.4 1.4" stroke="#7d6942" stroke-width="0.9"/>
