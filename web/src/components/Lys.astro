  .mk[data-side='left'] { flex-direction: row-reverse; translate: calc(-100% + 3.5px) -50%; }
  .mk[data-side='up'] { flex-direction: column-reverse; translate: -50% calc(-100% + 3.5px); }
  .mk.on { opacity: 0.62; pointer-events: auto; }
  .mk.on.now,
  .mk.on:hover,
  .mk.on:focus-visible { opacity: 1; }
  .mk:focus-visible { outline: none; }
  .mk:focus-visible .mk-label { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 6px; }
  .mk-dot {
