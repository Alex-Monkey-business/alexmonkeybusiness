    </svg>
    <svg class="c-air" viewBox="0 -4 24 36" overflow="visible" width="22" height="33" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {/* The grab: knees up to the chest, the skis crossed in an X, the
          front hand holding the near ski hard by the binding, the other arm
          thrown out with its pole for balance. Style over symmetry. */}
      <path d="M4.6 17.6L23 24.4Q25.2 25.2 26 23.4" stroke="#1d1d1d" stroke-width="2.2"/>
      <path d="M5.2 17.8L22.6 24.2" stroke="#c9a23f" stroke-width="0.6"/>
