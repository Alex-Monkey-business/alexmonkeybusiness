      <path d="M14.9 29L17.1 29" stroke="#121315" stroke-width="2"><animate attributeName="d" values="M14.9 29L17.1 29;M6.9 30.5L9.1 30.5;M14.9 29L17.1 29" dur="1.1s" repeatCount="indefinite" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1"/></path>
      <path d="M11 18L10.6 24.2L7.5 30.5" stroke="#4a4e45" stroke-width="3.8"><animate attributeName="d" values="M11 18L10.6 24.2L7.5 30.5;M11 18L15.2 23.5L15.5 29;M11 18L10.6 24.2L7.5 30.5" dur="1.1s" repeatCount="indefinite" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1"/></path>
      <path d="M6.9 30.5L9.1 30.5" stroke="#121315" stroke-width="2"><animate attributeName="d" values="M6.9 30.5L9.1 30.5;M14.9 29L17.1 29;M6.9 30.5L9.1 30.5" dur="1.1s" repeatCount="indefinite" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1"/></path>
