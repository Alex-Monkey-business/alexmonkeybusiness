  <svg class="lys-route" aria-hidden="true">
    <path class="lys-glow" /><path class="lys-line" /><circle class="lys-tip" r="3" />
    <path class="lys-glow" /><path class="lys-line" /><circle class="lys-tip" r="3" />
  </svg>
  <img class="lys-fallback" src="/hero/matterhorn-still.webp" alt="" width="2400" height="1350" decoding="async" loading="lazy" />
  <!-- What `OneScreen` toggles. Never drawn; read by the script below. -->
  <i class="seg" data-seg="hornligrat" hidden></i>
  <i class="seg" data-seg="zmuttgrat" hidden></i>
  <i class="draw" data-seg="hornligrat" hidden></i>
  <i class="draw" data-seg="zmuttgrat" hidden></i>
  <div class="lys-marks">
    {markers.map((m) => (
      <button
        class="mk"
        type="button"
        data-id={m.id}
        data-route={m.route}
        data-f={m.f}
        data-side={m.route === 'top' ? 'up' : m.route === 'hornligrat' ? 'left' : 'right'}
        data-open={m.open === false ? 'false' : undefined}
        tabindex={m.open === false ? -1 : undefined}
        aria-hidden={m.open === false ? 'true' : undefined}
      >
        <span class="mk-dot"></span><span class="mk-lead"></span><span class="mk-label">{m.n && <span class="mk-n">{m.n}</span>}{m.label}{m.open !== false && <span class="mk-go" aria-hidden="true">→</span>}</span>
      </button>
    ))}
  </div>
  <button class="lys-read" type="button" aria-label={skyWords.now} tabindex={mode === 'climb' ? -1 : undefined}>
    <span class="lys-place">zermatt</span>
    <span class="lys-time">--:--</span>
    {mode === 'climb' && <span class="lys-alt">1608 m</span>}
  </button>
  <!-- The light switch: what the sky is doing, as an icon and a word. Press
       it for the next light of the day. -->
  <button class="lys-sky" type="button" aria-label={skyWords.next}>
    <svg class="lys-sky-ic" viewBox="0 0 24 24" aria-hidden="true"></svg>
    <span class="lys-sky-w"></span>
  </button>
  <div class="lys-dial">
    <span class="lys-rise" aria-hidden="true"></span>
    <span class="lys-set" aria-hidden="true"></span>
    <span class="lys-now" aria-hidden="true"></span>
    <span class="lys-mark" aria-hidden="true"></span>
    <input class="lys-slide" type="range" min="0" max="1439" step="1" aria-label={skyWords.clock} />
  </div>
</div>

<style>
  .lys {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #000;
    pointer-events: none;
    overflow: hidden;
  }
  /* `Home` pushes `.sky` in with a CSS scale for the photograph. Here the
     camera does it, in 3D — a scaled canvas would only be a blurrier one. */
  :global(.always-dark) .lys.sky,
  :global(.always-dark) .lys.sky[data-level] {
    transform: none !important;
    transition: none !important;
  }
  .lys-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lys.ready .lys-gl { opacity: 1; }
  /* The climber. Drawn far larger than a person would be at this range —
     a figure, not a speck — with a dark rim so it reads on lit snow. It
     stands on its feet at the line's head and faces the way the line goes. */
  .lys-climber {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 33px;
    margin: -30px 0 0 -11px;
    /* Lit like the mountain: dim at night, full by day, with a soft rim of
       dark so the figure never melts into snow. */
    filter: brightness(var(--lit, 1)) drop-shadow(0 0 0.8px rgba(0, 0, 0, 0.7)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms linear;
  }
  .lys-climber svg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; transform-origin: 50% 92%; }
  .lys-climber .c-up { transform: scaleX(var(--face, 1)); }
  /* Past the top he skis: the downhill figure, tilted with the slope. */
  .lys-climber .c-ski {
    display: none;
    transform-origin: 50% 62%;
    /* A cork was tried: on a flat figure the spin read as a figure getting
       thin, not a cork. A backflip turns in the picture's own plane. */
    transform: scaleX(var(--face, 1)) translateY(var(--lift, 0px)) rotate(calc(var(--tilt, 0deg) + var(--flip, 0deg)));
  }
  /* Snow thrown off the skis: puffs left where he was, drifting back and
     up, fading. Only while he moves. */
  .lys-spray { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  /* Global: the puffs are made by script and carry no scope attribute. */
  .lys-spray :global(i) {
    position: absolute;
    left: 0;
    top: 0;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #f4f6fb;
    filter: brightness(var(--lit, 1)) blur(0.6px);
  }
  .lys-climber.ski .c-ski { display: block; }
  /* The legs take the terrain (--crouch), the body leans into the line
     (--lean). Set from the run's speed and its turns; eased here. */
  .c-ski .sk-legs { transform: scaleY(var(--crouch, 1)); transition: transform 260ms cubic-bezier(0.3, 0.7, 0.4, 1); }
  .c-ski .sk-up {
    transform: translateY(calc((1 - var(--crouch, 1)) * 10px)) rotate(var(--lean, 0deg));
    transition: transform 260ms cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  /* Down by the instruments he skis on behind them. */
  .lys-climber.under { opacity: 0 !important; }
  .lys-spray :global(i.c) {
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    filter: brightness(var(--lit, 1)) blur(2.4px);
  }
  /* In the air: knees up, the skis a little apart — freeride, not gymnastics. */
  .lys-climber .c-air {
    display: none;
    transform-origin: 50% 62%;
    transform: scaleX(var(--face, 1)) translateY(var(--lift, 0px)) rotate(calc(var(--tilt, 0deg) + var(--flip, 0deg)));
  }
  .lys-climber.ski.air .c-air { display: block; }
  /* Paused by a point, he turns to it and points: the arm swings to aim. */
  .lys-climber .pt { display: none; transform: rotate(var(--aim, -20deg)); transition: transform 300ms ease-out; }
  .lys-climber.point .pt { display: inline; }
  .lys-climber.point .hand { display: none; }
  .lys-climber.ski.air .c-ski { display: none; }
  .lys-climber.ski .c-up { display: none; }
  @media (min-width: 900px) { .lys-climber { width: 27px; height: 40px; margin: -37px 0 0 -13.5px; } }
  .lys.ready .lys-climber.on { opacity: 1; }
  /* Before the first scroll, a ring breathes at its feet: this is the thing
     that moves. */
  .lys-climber::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 26px;
    height: 10px;
    margin-left: -13px;
    border-radius: 50%;
    border: 1px solid var(--signal);
    opacity: 0;
  }
  .lys-climber.hint::after { animation: climber-hint 1.8s ease-out infinite; }
  @keyframes climber-hint {
    0% { transform: scale(0.4); opacity: 0.9; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .lys-climber.hint::after { animation: none; } }

  /* A shooting star: a streak of light fading toward its tail. A trail, not a
     surface, so the fade is the honest tool. Only ever over open sky. */
  .lys-meteor {
    position: absolute;
    left: 0;
    top: 0;
    width: 160px;
    height: 1.5px;
    border-radius: 1px;
    background: linear-gradient(to left, rgba(255, 255, 255, 0.95), rgba(210, 220, 255, 0));
    transform-origin: 100% 50%;
    opacity: 0;
    pointer-events: none;
  }
  .lys-route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .lys-line,
  .lys-glow {
    fill: none;
    stroke: var(--signal);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lys-line { stroke-width: 1.6; }
  .lys-glow { stroke-width: 7; opacity: 0.16; }
  .lys-tip { fill: var(--signal); }

  /* THE POINTS: the menu, hung on the routes. A dot on the rock, a hairline
     out, a name. They light when the line reaches them, the newest at full
     strength, the passed ones quieter but still there to press. */
  .lys-marks { position: absolute; inset: 0; pointer-events: none; }
  .mk {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    padding: 10px;
    margin: -10px;
    border: 0;
    background: none;
    color: var(--fg1);
    font-family: var(--font-inst);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: lowercase;
