  }
  .mk-lead { flex: none; width: 28px; height: 1px; background: color-mix(in srgb, var(--signal) 55%, transparent); }
  .mk[data-side='up'] .mk-lead { width: 1px; height: 26px; }
  /* A small dark pill under the name: on sunlit snow, light type has
     nothing else to stand on. */
  .mk-label {
    white-space: nowrap;
    padding: 7px 12px 7px 13px;
    border-radius: 999px;
    background: rgba(8, 8, 10, 0.66);
    /* A hairline edge, so the pill still has a shape against a black sky. */
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .mk:hover .mk-label { color: var(--signal); }
  .mk-n { color: var(--signal); margin-right: 0.9em; }
  .mk.quiet .mk-label,
  .mk.quiet .mk-lead { opacity: 0; }
  .mk-label, .mk-lead { transition: opacity 240ms linear; }
  /* A phone: the same names, tighter, so they fit beside their points. */
  @media (max-width: 600px) {
    .mk { font-size: 11px; letter-spacing: 0.1em; }
