  .lys:not(.opened) .mk.on.now .mk-dot::after { animation: mk-pulse 1400ms cubic-bezier(0.16, 1, 0.3, 1) 600ms infinite; }
  .mk-go { color: var(--signal); margin-left: 0.7em; display: inline-block; transition: transform 200ms var(--ease-out, ease-out); }
