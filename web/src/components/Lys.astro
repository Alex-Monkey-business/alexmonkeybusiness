      <path d="M11.6 9.8L9.6 13.4L8.4 15.4" stroke="#8f784f" stroke-width="2.3"><animate attributeName="d" values="M11.6 9.8L9.6 13.4L8.4 15.4;M11.6 9.8L14 12.9L16.2 14.2;M11.6 9.8L9.6 13.4L8.4 15.4" dur="1.1s" repeatCount="indefinite" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1"/></path>
      <path d="M8.4 15.4L7.2 29.8" stroke="#6f757d" stroke-width="0.9"><animate attributeName="d" values="M8.4 15.4L7.2 29.8;M16.2 14.2L18.8 29.4;M8.4 15.4L7.2 29.8" dur="1.1s" repeatCount="indefinite" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1"/></path>
      <path d="M10.8 20L12.8 9" stroke="#b39a6b" stroke-width="6"/>
      <path d="M13 18.8L14.6 9.8" stroke="#d6c08f" stroke-width="1.6"/>
      <path d="M10.4 15.4l2.8 0.5" stroke="#2a2f39" stroke-width="1"/>
