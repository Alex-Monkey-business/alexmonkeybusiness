  .lys[data-mode='climb'] { --foot: calc(var(--gap, 0px) + max(32px, calc(env(safe-area-inset-bottom, 0px) + 20px))); }
  .lys-alt { color: var(--fg1); min-width: 6ch; text-align: right; font-variant-numeric: tabular-nums; }
  /* The canvas holds the large viewport, so a phone's address bar sliding
     away does not resize it mid-scroll. */
  .lys[data-mode='climb'] { bottom: auto; height: 100lvh; }
  .lys.away .lys-read { color: var(--signal); cursor: pointer; }
  .lys-read:focus-visible { outline: 1px solid var(--signal); outline-offset: 6px; }

  /* The light switch. A pill like the points' names, sat over the readout:
     the one control on the page that says what it does. */
  .lys-sky {
    position: absolute;
    right: clamp(20px, 4vw, 56px);
    bottom: calc(clamp(44px, 7vh, 72px) + 36px);
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 16px 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(8, 8, 10, 0.66);
    color: var(--fg1);
    font-family: var(--font-inst);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: lowercase;
    cursor: pointer;
    pointer-events: auto;
