    transition: opacity 900ms linear 1400ms, border-color 160ms linear, color 160ms linear;
  }
  .lys.ready .lys-sky { opacity: 1; }
  .lys[data-mode='climb'] .lys-sky { bottom: calc(var(--foot) + 58px); }
  .lys-sky:hover,
  .lys-sky:focus-visible { border-color: var(--signal); outline: none; }
  .lys-sky:hover .lys-sky-ic,
  .lys-sky:focus-visible .lys-sky-ic { color: var(--signal); }
  .lys-sky-ic {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
