      <ellipse cx="12" cy="31" rx="9.5" ry="1.3" fill="#000" opacity="0.3"/>
      <path d="M1.6 29.1L21.4 29.1Q23.6 29.1 24 27.2" stroke="#1d1d1d" stroke-width="2"/>
      <path d="M0.5 30.2L21 30.2Q23.4 30.2 23.8 28" stroke="#2b2b2b" stroke-width="2.4"/>
